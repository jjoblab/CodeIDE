<?xml version="1.0" encoding="utf-8"?>
<!--
  Feuille inférieure (.sheet) : surface, coins hauts 18, trait 1 dp SUR LE HAUT SEULEMENT.
  Deux couches : le trait plein, puis la surface décalée de 1 dp vers le bas.
  L'ombre (0 -8px 28px rgba(0,0,0,.2)) = android:elevation="@dimen/apercu_feuille_elevation".
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/apercuTrait" />
            <corners android:topLeftRadius="@dimen/apercu_feuille_rayon" android:topRightRadius="@dimen/apercu_feuille_rayon" />
        </shape>
    </item>
    <item android:top="@dimen/apercu_trait_epaisseur">
        <shape android:shape="rectangle">
            <solid android:color="?attr/apercuSurface" />
            <corners android:topLeftRadius="@dimen/apercu_feuille_rayon_interne" android:topRightRadius="@dimen/apercu_feuille_rayon_interne" />
        </shape>
    </item>
</layer-list>
