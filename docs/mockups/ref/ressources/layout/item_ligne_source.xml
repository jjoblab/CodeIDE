<?xml version="1.0" encoding="utf-8"?>
<!--
  Une ligne de l'onglet SOURCE (.src div) — RÉFÉRENCE (ADR 0134). Hauteur 20 dp (mono 12, interligne 1,65).
  Numéro : colonne de 24 dp alignée à droite, gris doux ; texte : mono 12, `white-space: pre`
  (singleLine, pas de retour à la ligne). Coloration :
  balise = primaire, attribut = « remplissage » (vert), valeur = « marge » (orange) — ForegroundColorSpan
  lu dans ?attr/apercu*. Racine sélectionnée = isSelected (accent doux), plage de la vue = isActivated
  (jeton apercuSourceVue). Remplace fond_ligne_source_surlignee (colorSecondaryContainer).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee_source"
    style="@style/Widget.CodeIDE.Apercu.SourceLigne"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="0dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/numero_ligne"
        style="@style/Widget.CodeIDE.Apercu.Texte"
        android:layout_width="@dimen/apercu_source_numero"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.SourceNumero" />

    <TextView
        android:id="@+id/texte_ligne"
        style="@style/Widget.CodeIDE.Apercu.Texte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_source_gap"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.Source" />
</LinearLayout>
