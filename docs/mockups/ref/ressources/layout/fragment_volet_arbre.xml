<?xml version="1.0" encoding="utf-8"?>
<!--
  Volet ARBRE — RÉFÉRENCE (ADR 0134) : un RecyclerView avec le padding du volet (.pane : 8 / 10 / 14).
  Aucun séparateur : les rangées sont jointives (le surlignage de sélection suffit).
-->
<androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/liste_arbre"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:contentDescription="@string/preview_feuille_onglet_arbre"
    android:paddingStart="@dimen/apercu_pane_pad_h"
    android:paddingTop="@dimen/apercu_pane_pad_haut"
    android:paddingEnd="@dimen/apercu_pane_pad_h"
    android:paddingBottom="@dimen/apercu_pane_pad_bas"
    tools:itemCount="8"
    tools:listitem="@layout/item_arbre" />
