<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlays de palettes statiques (ADR 0060) : appliqués au thème de chaque
  activité par [jo.codeide.core.ui.AppliquerApparence] quand les couleurs
  dynamiques sont désactivées — même mécanisme que l'overlay Material You
  (theme.applyStyle AVANT le gonflement du contenu, onActivityPreCreated).

  Un style par [jo.codeide.core.model.PaletteCouleur] ; les couleurs se
  résolent jour/nuit toutes seules (palettes-couleurs.xml est qualifié
  values/values-night). L'INDIGO, palette par défaut, reprend les
  couleurs de marque codeide_* : aucun changement visuel à la mise à
  jour.

  Les rôles sémantiques étendus (journal, canaux tooling, statuts Git,
  accents par langage) ne sont PAS surchargés : ils restent fonctionnels
  ou s'harmonisent à l'exécution avec le colorPrimary courant
  (ThemeHarmonizer, ADR 0059).
-->
<resources>
    <!-- Palette par défaut (marque) -->
    <style name="ThemeOverlay.CodeIDE.PaletteIndigo" parent="">
        <item name="colorPrimary">@color/codeide_primary</item>
        <item name="colorOnPrimary">@color/codeide_on_primary</item>
        <item name="colorPrimaryContainer">@color/codeide_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/codeide_on_primary_container</item>
        <item name="colorSecondary">@color/codeide_secondary</item>
        <item name="colorOnSecondary">@color/codeide_on_secondary</item>
        <item name="colorSecondaryContainer">@color/codeide_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/codeide_on_secondary_container</item>
        <item name="colorTertiary">@color/codeide_tertiary</item>
        <item name="colorOnTertiary">@color/codeide_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/codeide_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/codeide_on_tertiary_container</item>
        <item name="colorError">@color/codeide_error</item>
        <item name="colorOnError">@color/codeide_on_error</item>
        <item name="colorErrorContainer">@color/codeide_error_container</item>
        <item name="colorOnErrorContainer">@color/codeide_on_error_container</item>
        <item name="android:colorBackground">@color/codeide_background</item>
        <item name="colorOnBackground">@color/codeide_on_background</item>
        <item name="colorSurface">@color/codeide_surface</item>
        <item name="colorOnSurface">@color/codeide_on_surface</item>
        <item name="colorSurfaceVariant">@color/codeide_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/codeide_on_surface_variant</item>
        <item name="colorOutline">@color/codeide_outline</item>
        <item name="colorOutlineVariant">@color/codeide_outline_variant</item>
        <item name="colorSurfaceInverse">@color/codeide_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/codeide_on_inverse_surface</item>
    </style>

