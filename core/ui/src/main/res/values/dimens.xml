<?xml version="1.0" encoding="utf-8"?>
<!--
  Espacements, rayons et tailles — tokens uniques de l'interface.
  Aucune dimension en dur dans les écrans : tout passe par ces tokens
  (règle 3 du prompt maître).
-->
<resources>

    <!-- Échelle d'espacement (base 4 dp). -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>
    <dimen name="spacing_xl">32dp</dimen>

    <!-- Marge latérale standard des écrans (recommandation Material : 16 dp). -->
    <dimen name="screen_horizontal_margin">16dp</dimen>

    <!-- Rayons de coins. -->
    <dimen name="corner_radius_small">8dp</dimen>
    <dimen name="corner_radius_medium">12dp</dimen>
    <dimen name="corner_radius_large">16dp</dimen>

    <!-- Cibles tactiles minimales (accessibilité, section 12.1). -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- Composants d'état (vide, chargement, erreur). -->
    <dimen name="state_icon_size">64dp</dimen>
    <dimen name="state_padding">32dp</dimen>
    <dimen name="state_spacing">16dp</dimen>

</resources>
