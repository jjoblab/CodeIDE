    <color name="codeide_succes">#2E7D32</color>
    <color name="codeide_info">#1A5FB4</color>

    <!-- ============================================================
         Canaux tooling (ADR 0056 décision 5) : une couleur par canal —
         Sync (teal), Build (bleu accent), Taches (violet). Valeurs de
         marque : harmonisées avec colorPrimary à l'exécution via
         ThemeHarmonizer quand les couleurs dynamiques sont actives.
         ============================================================ -->
    <color name="codeide_canal_sync">#0E7490</color>
    <color name="codeide_canal_build">#1E6EC8</color>
    <color name="codeide_canal_taches">#7C3AED</color>

