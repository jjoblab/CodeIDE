<?xml version="1.0" encoding="utf-8"?>
<!--
  Palette CodeIDE — mode clair.
  Les noms sont indépendants de leur valeur : un écran ne référence jamais
  une couleur directement, mais le rôle sémantique via le thème
  (règle 3 : aucune ressource en dur).

  Depuis l'ADR 0059, la palette porte AUSSI les rôles sémantiques étendus
  (journal, canaux tooling, statuts Git, accents par langage, succès) et
  les jetons de conception des panneaux (explorateur, terminal, barre de
  symboles) — centralisés ici pour être partagés entre features, avec
  déclinaison nuit dans values-night/.
-->
<resources>
    <!-- Couleurs de marque (indigo). -->
    <color name="codeide_primary">#43559E</color>
    <color name="codeide_on_primary">#FFFFFF</color>
    <color name="codeide_primary_container">#DCE1FF</color>
    <color name="codeide_on_primary_container">#001159</color>

    <!-- Couleurs secondaires (tons neutres froids). -->
    <color name="codeide_secondary">#595D72</color>
    <color name="codeide_on_secondary">#FFFFFF</color>
    <color name="codeide_secondary_container">#DDE1F9</color>
    <color name="codeide_on_secondary_container">#161B2C</color>

    <!-- Couleurs tertiaires (accent discret). -->
