    <!-- ============================================================
         Rôles sémantiques étendus (ADR 0059) — journal & sortie.

         Niveaux de journal partagés par la console compacte de l'éditeur
         et l'écran Diagnostic (les valeurs étaient dupliquées entre
         features ; teintes fonctionnelles, jamais harmonisées : la
         sévérité doit rester reconnaissable).
         ============================================================ -->
    <color name="codeide_journal_debug">#5F6368</color>
    <color name="codeide_journal_info">#1A5FB4</color>
    <color name="codeide_journal_warn">#9A6700</color>
