<?xml version="1.0" encoding="utf-8"?>
<!--
  Styles de composants CodeIDE — points d'ancrage uniques pour boutons,
  barres d'outils et composants d'état. Les écrans référencent toujours
  Widget.CodeIDE.*, jamais les styles Material directement.
-->
<resources>

    <!-- Bouton principal : cible tactile minimale 48 dp (accessibilité). -->
    <style name="Widget.CodeIDE.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.CodeIDE.LabelLarge</item>
    </style>

    <!-- Bouton tonal (action secondaire). -->
    <style name="Widget.CodeIDE.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.CodeIDE.LabelLarge</item>
    </style>

    <!-- Bouton texte (action tertiaire). -->
    <style name="Widget.CodeIDE.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- Bouton compact encadré (tri de l'accueil, étape 7). -->
    <style name="Widget.CodeIDE.Button.Outlined.Compact" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.CodeIDE.LabelLarge</item>
    </style>

    <!-- Bouton encadré STANDARD (ADR 0127 §3, lot UI-1) : remplace
         ?attr/materialButtonOutlinedStyle et Widget.Material3.Button
         .OutlinedButton bruts — la variante Compact reste pour les
         barres denses d'IDE. -->
    <style name="Widget.CodeIDE.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.CodeIDE.LabelLarge</item>
    </style>

    <!-- Bouton icône seul (réglages de l'accueil, étape 7) : le rôle est
         porté par la description de contenu, jamais par un texte. -->
    <style name="Widget.CodeIDE.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- Champ de saisie encadré (recherche, renommage — étape 7). -->
    <!-- Progression circulaire thématisée (lot UI-5, audit C3) : le
         cliquet R4 refuse tout style Material brut dans les écrans. -->
    <style name="Widget.CodeIDE.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator" />

    <style name="Widget.CodeIDE.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.CodeIDE.BodyMedium</item>
    </style>

    <!-- Champ de liste déroulante exposée (paramètres du wizard, étape 10). -->
    <style name="Widget.CodeIDE.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:textAppearance">@style/TextAppearance.CodeIDE.BodyMedium</item>
    </style>

    <!-- Barre d'outils de haut d'écran (sans action, titre TitleLarge). -->
    <style name="Widget.CodeIDE.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.CodeIDE.TitleLarge</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- ============================================================
         Composants partagés ADR 0127 (lot UI-1) : carte, chips,
         en-tête de section. Un seul point d'ancrage par famille,
         les variantes par héritage implicite (aucune recopie).
         ============================================================ -->

    <!-- Carte de réglage STANDARD : remplie, contour 1 dp variante,
         forme moyenne, AUCUNE élévation (remplace les 4 recettes C4 :
         ombre / contour / fond plat / style par défaut). -->
    <style name="Widget.CodeIDE.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">@dimen/separateur_epaisseur</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CodeIDE.Medium</item>
        <item name="cardElevation">@dimen/elevation_aucune</item>
    </style>

    <!-- Chips thématisées (ADR 0127 §3) : remplacent les
         Widget.Material3.Chip.* bruts (audit C8). -->
    <style name="Widget.CodeIDE.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.CodeIDE.Small</item>
    </style>

    <style name="Widget.CodeIDE.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.CodeIDE.Small</item>
    </style>

    <style name="Widget.CodeIDE.Chip.Input" parent="Widget.Material3.Chip.Input">
        <item name="shapeAppearance">@style/ShapeAppearance.CodeIDE.Small</item>
    </style>

    <!-- En-tête de section d'un écran de réglages (ADR 0127 §3) :
         remplace le libellé recopié carte par carte (audit C6). -->
    <style name="EnteteSection" parent="">
        <item name="android:textAppearance">@style/TextAppearance.CodeIDE.SectionLabel</item>
        <item name="android:paddingStart">@dimen/spacing_md_compact</item>
        <item name="android:paddingEnd">@dimen/spacing_md_compact</item>
        <item name="android:paddingTop">@dimen/spacing_sm</item>
        <item name="android:paddingBottom">@dimen/spacing_sm</item>
    </style>

    <!-- Appbar COMPACTE de l'aperçu XML (PE10, miroir `.ttl` de la
         maquette : le fichier en 13 px gras, le sous-titre en 11 px) —
         la toolbar passe de TitleLarge (22 sp) à 14 sp + 11 sp. -->
    <style name="TextAppearance.CodeIDE.PreviewTitre" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CodeIDE.PreviewSousTitre" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

</resources>
