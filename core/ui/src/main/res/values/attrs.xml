<?xml version="1.0" encoding="utf-8"?>
<!--
  Attributs XML des composants d'état de core:ui.
  Les attributs communs (stateIcon, stateTitle, stateMessage) sont déclarés
  une seule fois puis réutilisés par chaque composant.

  Depuis l'ADR 0059 : rôles de couleur sémantiques étendus, exposés comme
  attrs de thème (même patron que les rôles Material 3 — voir themes.xml).
  Un écran référence ?attr/colorJournalInfo, jamais une couleur en dur.
-->
<resources>

    <declare-styleable name="EmptyStateView">
        <attr name="stateIcon" format="reference" />
        <attr name="stateTitle" format="string" />
        <attr name="stateMessage" format="string" />
    </declare-styleable>

    <declare-styleable name="LoadingView">
        <attr name="stateMessage" />
    </declare-styleable>

    <declare-styleable name="ErrorStateView">
        <attr name="stateIcon" />
        <attr name="stateTitle" />
        <attr name="stateMessage" />
        <attr name="errorRetryText" format="string" />
    </declare-styleable>

    <!-- ============================================================
         Composants partagés ADR 0127 (lot UI-1) : RangeeParametre,
         VueEtat, IndicateurEtat. Les attributs sont préfixés par
         composant pour éviter toute collision avec les libs ; les
         attributs communs stateIcon/stateTitle/stateMessage sont
         réutilisés par VueEtat (patron du fichier : déclarés une
         fois, consommés partout).
         ============================================================ -->
    <declare-styleable name="RangeeParametre">
        <!-- Icône de la rangée (facultative : absente, le titre part au bord). -->
        <attr name="rangeeIcone" format="reference" />
        <attr name="rangeeTitre" format="string" />
        <!-- Sous-titre d'état ; vide, la ligne n'est pas gonflée. -->
        <attr name="rangeeSousTitre" format="string" />
        <!-- Texte de la valeur affichée à droite (type=valeur). -->
        <attr name="rangeeValeur" format="string" />
        <!-- Puce « Bientôt » à la place du contrôle ; la rangée devient
             non interactive (miroir du badge_bientot des Paramètres). -->
        <attr name="rangeeBientot" format="boolean" />
        <!-- Contrôle de droite : chevron naviguant, interrupteur,
         valeur, ou aucun (lecture seule). -->
        <attr name="rangeeType" format="enum">
            <enum name="chevron" value="0" />
            <enum name="interrupteur" value="1" />
            <enum name="valeur" value="2" />
            <enum name="aucun" value="3" />
        </attr>
    </declare-styleable>

    <declare-styleable name="VueEtat">
        <!-- Variante de l'état : fixe l'icône par défaut et remplace
             l'icône par un indicateur de chargement si besoin. -->
        <attr name="etatVariante" format="enum">
            <enum name="vide" value="0" />
            <enum name="erreur" value="1" />
            <enum name="horsLigne" value="2" />
            <enum name="chargement" value="3" />
        </attr>
        <attr name="stateIcon" />
        <attr name="stateTitle" />
        <attr name="stateMessage" />
        <!-- Libellé du bouton d'action ; absent, le bouton est masqué. -->
        <attr name="etatActionLibelle" format="string" />
    </declare-styleable>

    <declare-styleable name="IndicateurEtat">
        <!-- Niveau de la pastille : forme ET couleur, jamais la
             couleur seule (accessibilité ADR 0127 §3). -->
        <attr name="indicateurEtat" format="enum">
            <enum name="ok" value="0" />
            <enum name="avertissement" value="1" />
            <enum name="erreur" value="2" />
            <enum name="neutre" value="3" />
        </attr>
        <attr name="indicateurTexte" format="string" />
    </declare-styleable>

    <!-- Niveaux de journal (console compacte, écran Diagnostic). -->
    <attr name="colorJournalDebug" format="color" />
    <attr name="colorJournalInfo" format="color" />
    <attr name="colorJournalWarn" format="color" />
    <attr name="colorJournalError" format="color" />

    <!-- Sortie du build. -->
    <attr name="colorStdout" format="color" />
    <attr name="colorStderr" format="color" />

    <!-- États positifs et signal d'information. -->
    <attr name="colorSucces" format="color" />
    <attr name="colorInfo" format="color" />

    <!-- Pastilles d'état ADR 0127 (lot UI-1) : conteneurs des
         composants IndicateurEtat ; l'erreur reste sur les rôles
         Material colorError / colorErrorContainer existants. -->
    <attr name="colorSuccesContainer" format="color" />
    <attr name="colorAvertissement" format="color" />
    <attr name="colorAvertissementContainer" format="color" />

    <!-- Canaux tooling : Sync, Build, Taches (+ étiquette de pastille). -->
    <attr name="colorCanalSync" format="color" />
    <attr name="colorCanalBuild" format="color" />
    <attr name="colorCanalTaches" format="color" />
    <attr name="colorCanalEtiquette" format="color" />

    <!-- Statuts Git. -->
    <attr name="colorGitAjoute" format="color" />
    <attr name="colorGitModifie" format="color" />
    <attr name="colorGitSupprime" format="color" />

    <!-- Accents par langage. -->
    <attr name="colorLangageKotlin" format="color" />
    <attr name="colorLangageJava" format="color" />
    <attr name="colorLangageGradle" format="color" />
    <attr name="colorLangageMarkdown" format="color" />
    <attr name="colorLangageXml" format="color" />
    <attr name="colorLangageJson" format="color" />

</resources>
