<?xml version="1.0" encoding="utf-8"?>
<!--
  Attributs XML des composants d'état de core:ui.
  Les attributs communs (stateIcon, stateTitle, stateMessage) sont déclarés
  une seule fois puis réutilisés par chaque composant.
-->
<resources>

    <declare-styleable name="EmptyStateView">
        <attr name="stateIcon" format="reference" />
        <attr name="stateTitle" format="string" />
        <attr name="stateMessage" format="string" />
    </declare-styleable>

    <declare-styleable name="LoadingView">
        <attr name="stateMessage" />
    </declare-styleable>

    <declare-styleable name="ErrorStateView">
        <attr name="stateIcon" />
        <attr name="stateTitle" />
        <attr name="stateMessage" />
        <attr name="errorRetryText" format="string" />
    </declare-styleable>

</resources>
