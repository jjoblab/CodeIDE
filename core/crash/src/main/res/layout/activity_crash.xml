<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran de plantage (section 5.8) : défilement intégral, boutons pleine
  largeur d'au moins 48 dp (accessibilité), trace monospace sélectionnable
  dans la section repliable. accessibilityHeading cible l'API 28+ : ignoré
  (sans effet, sans erreur) sur API 26-27, déclaré via tools:targetApi.
  Lot UI-4 (audit C1-C4, ADR 0127) : espacements par JETONS, boutons
  Widget.CodeIDE.Button.*, carte Widget.CodeIDE.Card, trace par
  textAppearance — zéro littéral (cliquet checkUiTokens).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <TextView
            android:id="@+id/crash_titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:accessibilityHeading="true"
            tools:targetApi="28"
            android:text="@string/crash_titre_live" />

        <TextView
            android:id="@+id/crash_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:text="@string/crash_message_live" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crash_carte_resume"
            style="@style/Widget.CodeIDE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:contentPadding="@dimen/spacing_md_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/crash_detail_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/crash_detail_ecran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/crash_detail_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/crash_detail_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/crash_conseil_boucle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md_compact"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            android:text="@string/crash_conseil_boucle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_details"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/crash_details_ouvrir" />

        <TextView
            android:id="@+id/crash_trace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="?attr/colorSurfaceVariant"
            android:fontFamily="monospace"
            android:padding="@dimen/spacing_sm"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/crash_appareil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_redemarrer"
            style="@style/Widget.CodeIDE.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/crash_bouton_redemarrer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_copier"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/crash_bouton_copier" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_partager"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/crash_bouton_partager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_zip"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/crash_bouton_zip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_enregistrer"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/crash_bouton_enregistrer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_vider_cache"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            android:text="@string/crash_bouton_vider_cache" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crash_bouton_fermer"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/crash_bouton_fermer" />

    </LinearLayout>
</ScrollView>
