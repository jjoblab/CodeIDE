{
  "schemaVersion": 1,
  "id": "android-app",
  "templateVersion": "1.2.0",
  "nameKey": "template.name",
  "descriptionKey": "template.description",
  "category": "android",
  "iconKey": "template.icon",
  "tags": ["Android", "Kotlin", "Java", "Gradle", "Material 3"],
  "parameters": [
    {
      "id": "appName",
      "type": "TEXT",
      "labelKey": "param.appName.label",
      "helpKey": "param.appName.help",
      "default": "MonApp",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "packageName",
      "type": "TEXT",
      "labelKey": "param.packageName.label",
      "helpKey": "param.packageName.help",
      "defaultFrom": "packageFromAppName",
      "validator": "package-name",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "projectType",
      "type": "CHOICE",
      "labelKey": "param.projectType.label",
      "helpKey": "param.projectType.help",
      "choices": ["empty-activity", "no-activity", "basic-activity"],
      "default": "empty-activity",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "language",
      "type": "CHOICE",
      "labelKey": "param.language.label",
      "helpKey": "param.language.help",
      "choices": ["kotlin", "java"],
      "default": "kotlin",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "minSdk",
      "type": "CHOICE",
      "labelKey": "param.minSdk.label",
      "helpKey": "param.minSdk.help",
      "choices": ["26"],
      "default": "26",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "includeTests",
      "type": "BOOLEAN",
      "labelKey": "param.includeTests.label",
      "helpKey": "param.includeTests.help",
      "default": "true",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "includeWrapper",
      "type": "BOOLEAN",
      "labelKey": "param.includeWrapper.label",
      "helpKey": "param.includeWrapper.help",
      "default": "true",
      "section": "CONFIGURATION",
      "persist": true
    }
  ],
  "computed": [
    {"name": "gradle", "expression": "true"},
    {"name": "langageKotlin", "expression": "language == \"kotlin\""},
    {"name": "estActiviteVide", "expression": "projectType == \"empty-activity\""},
    {"name": "estSansActivite", "expression": "projectType == \"no-activity\""},
    {"name": "estActiviteTiroir", "expression": "projectType == \"basic-activity\""},
    {"name": "avecTests", "expression": "includeTests"},
    {"name": "avecWrapper", "expression": "includeWrapper"}
  ],
  "files": [
    {"path": ".gitattributes", "source": "files/gitattributes.tpl"},
    {"path": ".gitignore", "source": "files/gitignore.tpl", "when": "includeGitignore"},
    {"path": ".editorconfig", "source": "files/editorconfig.tpl", "when": "includeEditorconfig"},
    {"path": "README.md", "source": "files/readme.md.tpl", "when": "includeReadme"},
    {"path": "settings.gradle.kts", "source": "files/settings.gradle.kts.tpl"},
    {"path": "build.gradle.kts", "source": "files/build.gradle.kts.tpl"},
    {"path": "gradle/libs.versions.toml", "source": "files/libs.versions.toml.tpl"},
    {"path": "gradle.properties", "source": "files/gradle.properties.tpl"},
    {"path": "gradle/wrapper/gradle-wrapper.properties", "source": "files/wrapper.properties.tpl", "when": "avecWrapper"},
    {"path": "gradlew", "source": "files/gradlew.tpl", "when": "avecWrapper"},
    {"path": "gradlew.bat", "source": "files/gradlew.bat.tpl", "when": "avecWrapper"},
    {"path": "gradle/wrapper/gradle-wrapper.jar", "source": "files/gradle/wrapper/gradle-wrapper.jar", "when": "avecWrapper", "binary": true},
    {"path": "app/.gitignore", "source": "files/app/gitignore.tpl", "when": "includeGitignore"},
    {"path": "app/build.gradle.kts", "source": "files/app/build.gradle.kts.tpl"},
    {"path": "app/proguard-rules.pro", "source": "files/app/proguard-rules.pro.tpl"},
    {"path": "app/src/main/AndroidManifest.xml", "source": "files/app/AndroidManifest.xml.tpl"},
    {"path": "app/src/main/res/values/strings.xml", "source": "files/app/strings.xml.tpl"},
    {"path": "app/src/main/res/values/colors.xml", "source": "files/app/colors.xml.tpl"},
    {"path": "app/src/main/res/values/themes.xml", "source": "files/app/themes.xml.tpl"},
    {"path": "app/src/main/res/layout/activity_main.xml", "source": "files/app/activity_main.xml.tpl", "when": "estActiviteVide"},
    {"path": "app/src/main/res/layout/activity_main_tiroir.xml", "source": "files/app/activity_main_tiroir.xml.tpl", "when": "estActiviteTiroir"},
    {"path": "app/src/main/res/layout/fragment_accueil.xml", "source": "files/app/fragment_accueil.xml.tpl", "when": "estActiviteTiroir"},
    {"path": "app/src/main/res/menu/tiroir.xml", "source": "files/app/tiroir.xml.tpl", "when": "estActiviteTiroir"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.kt", "source": "files/app/MainActivity.kt.tpl", "when": "langageKotlin && estActiviteVide"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.kt", "source": "files/app/MainActivityTiroir.kt.tpl", "when": "langageKotlin && estActiviteTiroir"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.java", "source": "files/app/MainActivity.java.tpl", "when": "!langageKotlin && estActiviteVide"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.java", "source": "files/app/MainActivityTiroir.java.tpl", "when": "!langageKotlin && estActiviteTiroir"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/FragmentAccueil.kt", "source": "files/app/FragmentAccueil.kt.tpl", "when": "langageKotlin && estActiviteTiroir"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/FragmentAccueil.java", "source": "files/app/FragmentAccueil.java.tpl", "when": "!langageKotlin && estActiviteTiroir"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/Greeter.kt", "source": "files/greeter.kt.tpl", "when": "langageKotlin"},
    {"path": "app/src/main/java/{{packageName|packagePath}}/Greeter.java", "source": "files/Greeter.java.tpl", "when": "!langageKotlin"},
    {"path": "app/src/test/java/{{packageName|packagePath}}/ExampleUnitTest.kt", "source": "files/ExampleUnitTest.kt.tpl", "when": "avecTests && langageKotlin"},
    {"path": "app/src/test/java/{{packageName|packagePath}}/ExampleUnitTest.java", "source": "files/ExampleUnitTest.java.tpl", "when": "avecTests && !langageKotlin"},
    {"path": "app/src/test/java/{{packageName|packagePath}}/GreeterTest.kt", "source": "files/GreeterTest.kt.tpl", "when": "avecTests && langageKotlin"},
    {"path": "app/src/test/java/{{packageName|packagePath}}/GreeterTest.java", "source": "files/GreeterTest.java.tpl", "when": "avecTests && !langageKotlin"}
  ]
}
