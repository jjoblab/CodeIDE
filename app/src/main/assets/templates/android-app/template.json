{
  "schemaVersion": 1,
  "id": "android-app",
  "templateVersion": "2.0.0",
  "nameKey": "template.name",
  "descriptionKey": "template.description",
  "category": "android",
  "iconKey": "template.icon",
  "tags": [
    "Android",
    "Kotlin",
    "Java",
    "Gradle",
    "Material 3"
  ],
  "parameters": [
    {
      "id": "appName",
      "type": "TEXT",
      "labelKey": "param.appName.label",
      "helpKey": "param.appName.help",
      "defaultFrom": "appNameFromNom",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "packageName",
      "type": "TEXT",
      "labelKey": "param.packageName.label",
      "helpKey": "param.packageName.help",
      "defaultFrom": "packageFromAppName",
      "validator": "package-name",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "applicationId",
      "type": "TEXT",
      "labelKey": "param.applicationId.label",
      "helpKey": "param.applicationId.help",
      "defaultFrom": "applicationIdFromPackageName",
      "validator": "package-name",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "projectType",
      "type": "CHOICE",
      "labelKey": "param.projectType.label",
      "helpKey": "param.projectType.help",
      "choices": [
        "empty-activity",
        "no-activity",
        "basic-activity"
      ],
      "default": "empty-activity",
      "groupe": "demarrage",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "language",
      "type": "CHOICE",
      "labelKey": "param.language.label",
      "helpKey": "param.language.help",
      "choices": [
        "kotlin",
        "java"
      ],
      "default": "kotlin",
      "groupe": "demarrage",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "minSdk",
      "type": "CHOICE",
      "labelKey": "param.minSdk.label",
      "helpKey": "param.minSdk.help",
      "choices": [
        "24",
        "26",
        "29",
        "34"
      ],
      "default": "26",
      "groupe": "plateforme",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "targetSdk",
      "type": "CHOICE",
      "labelKey": "param.targetSdk.label",
      "helpKey": "param.targetSdk.help",
      "choices": [
        "34",
        "35",
        "36"
      ],
      "default": "36",
      "groupe": "plateforme",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "includeCoroutines",
      "type": "BOOLEAN",
      "labelKey": "param.includeCoroutines.label",
      "helpKey": "param.includeCoroutines.help",
      "default": "false",
      "visibleWhen": "language == \"kotlin\"",
      "groupe": "bibliotheques",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeRetrofit",
      "type": "BOOLEAN",
      "labelKey": "param.includeRetrofit.label",
      "helpKey": "param.includeRetrofit.help",
      "default": "false",
      "enabledWhen": "projectType != \"no-activity\"",
      "disabledReasonKey": "param.includeRetrofit.raison",
      "groupe": "bibliotheques",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeNavigation",
      "type": "BOOLEAN",
      "labelKey": "param.includeNavigation.label",
      "helpKey": "param.includeNavigation.help",
      "default": "false",
      "enabledWhen": "projectType != \"no-activity\"",
      "disabledReasonKey": "param.includeNavigation.raison",
      "groupe": "bibliotheques",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeRoom",
      "type": "BOOLEAN",
      "labelKey": "param.includeRoom.label",
      "helpKey": "param.includeRoom.help",
      "default": "false",
      "groupe": "bibliotheques",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeHilt",
      "type": "BOOLEAN",
      "labelKey": "param.includeHilt.label",
      "helpKey": "param.includeHilt.help",
      "default": "false",
      "groupe": "bibliotheques",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeTests",
      "type": "BOOLEAN",
      "labelKey": "param.includeTests.label",
      "helpKey": "param.includeTests.help",
      "default": "true",
      "groupe": "qualite",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "includeWrapper",
      "type": "BOOLEAN",
      "labelKey": "param.includeWrapper.label",
      "helpKey": "param.includeWrapper.help",
      "default": "true",
      "avance": true,
      "groupe": "qualite",
      "section": "CONFIGURATION",
      "persist": true
    }
  ],
  "computed": [
    {
      "name": "gradle",
      "expression": "true"
    },
    {
      "name": "langageKotlin",
      "expression": "language == \"kotlin\""
    },
    {
      "name": "estActiviteVide",
      "expression": "projectType == \"empty-activity\""
    },
    {
      "name": "estSansActivite",
      "expression": "projectType == \"no-activity\""
    },
    {
      "name": "estActiviteTiroir",
      "expression": "projectType == \"basic-activity\""
    },
    {
      "name": "avecTests",
      "expression": "includeTests"
    },
    {
      "name": "avecWrapper",
      "expression": "includeWrapper"
    },
    {
      "name": "avecCoroutines",
      "expression": "includeCoroutines"
    },
    {
      "name": "avecRetrofit",
      "expression": "includeRetrofit"
    },
    {
      "name": "avecNavigation",
      "expression": "includeNavigation"
    },
    {
      "name": "avecRoom",
      "expression": "includeRoom"
    },
    {
      "name": "avecHilt",
      "expression": "includeHilt"
    },
    {
      "name": "avecKsp",
      "expression": "avecRoom || avecHilt"
    },
    {
      "name": "avecModuleBdd",
      "expression": "avecRoom && avecHilt"
    },
    {
      "name": "sansHilt",
      "expression": "!avecHilt"
    }
  ],
  "constraints": [
    {
      "when": "minSdk > targetSdk",
      "severity": "ERREUR",
      "messageKey": "regle.minSdk.sup.targetSdk"
    },
    {
      "when": "targetSdk > plateformeMajeure",
      "severity": "ERREUR",
      "messageKey": "regle.targetSdk.sup.plateforme"
    },
    {
      "when": "includeRetrofit && language == \"kotlin\" && !includeCoroutines",
      "severity": "AVERTISSEMENT",
      "messageKey": "hint.retrofit.sans.coroutines"
    },
    {
      "when": "includeRoom && !includeHilt",
      "severity": "INFO",
      "messageKey": "hint.room.sans.hilt"
    }
  ],
  "wizard": {
    "etapes": [
      {
        "id": "plateforme",
        "titreKey": "etape.plateforme.titre",
        "parametres": [
          "minSdk",
          "targetSdk",
          "includeTests",
          "includeWrapper"
        ]
      },
      {
        "id": "demarrage",
        "titreKey": "etape.demarrage.titre",
        "parametres": [
          "projectType",
          "language"
        ]
      },
      {
        "id": "bibliotheques",
        "titreKey": "etape.bibliotheques.titre",
        "parametres": [
          "includeCoroutines",
          "includeRetrofit",
          "includeNavigation",
          "includeRoom",
          "includeHilt"
        ]
      }
    ],
    "presets": [
      {
        "id": "app-complete",
        "nomKey": "preset.app-complete.nom",
        "descriptionKey": "preset.app-complete.description",
        "valeurs": {
          "projectType": "basic-activity",
          "language": "kotlin",
          "includeCoroutines": true,
          "includeNavigation": true,
          "includeRoom": true,
          "includeHilt": true
        }
      },
      {
        "id": "app-reseau",
        "nomKey": "preset.app-reseau.nom",
        "descriptionKey": "preset.app-reseau.description",
        "valeurs": {
          "projectType": "empty-activity",
          "language": "kotlin",
          "includeCoroutines": true,
          "includeRetrofit": true
        }
      }
    ]
  },
  "files": [
    {
      "path": ".gitattributes",
      "source": "commun:gitattributes.tpl"
    },
    {
      "path": ".gitignore",
      "source": "files/gitignore.tpl",
      "when": "includeGitignore"
    },
    {
      "path": ".editorconfig",
      "source": "commun:editorconfig.tpl"
    },
    {
      "path": "README.md",
      "source": "files/readme.md.tpl",
      "when": "includeReadme"
    },
    {
      "path": "settings.gradle.kts",
      "source": "files/settings.gradle.kts.tpl"
    },
    {
      "path": "build.gradle.kts",
      "source": "files/build.gradle.kts.tpl"
    },
    {
      "path": "gradle/libs.versions.toml",
      "source": "files/libs.versions.toml.tpl"
    },
    {
      "path": "gradle.properties",
      "source": "files/gradle.properties.tpl"
    },
    {
      "path": "gradle/wrapper/gradle-wrapper.properties",
      "source": "commun:gradle/wrapper/wrapper.properties.tpl",
      "when": "avecWrapper"
    },
    {
      "path": "gradlew",
      "source": "commun:gradlew.tpl",
      "when": "avecWrapper"
    },
    {
      "path": "gradlew.bat",
      "source": "commun:gradlew.bat.tpl",
      "when": "avecWrapper"
    },
    {
      "path": "gradle/wrapper/gradle-wrapper.jar",
      "source": "commun:gradle/wrapper/gradle-wrapper.jar",
      "when": "avecWrapper",
      "binary": true
    },
    {
      "path": "app/.gitignore",
      "source": "files/app/gitignore.tpl",
      "when": "includeGitignore"
    },
    {
      "path": "app/build.gradle.kts",
      "source": "files/app/build.gradle.kts.tpl"
    },
    {
      "path": "app/proguard-rules.pro",
      "source": "files/app/proguard-rules.pro.tpl"
    },
    {
      "path": "app/src/main/AndroidManifest.xml",
      "source": "files/app/AndroidManifest.xml.tpl"
    },
    {
      "path": "app/src/main/res/values/strings.xml",
      "source": "files/app/strings.xml.tpl"
    },
    {
      "path": "app/src/main/res/values/colors.xml",
      "source": "files/app/colors.xml.tpl"
    },
    {
      "path": "app/src/main/res/values/themes.xml",
      "source": "files/app/themes.xml.tpl"
    },
    {
      "path": "app/src/main/res/values-night/themes.xml",
      "source": "files/app/themes_nuit.xml.tpl"
    },
    {
      "path": "app/src/main/res/xml/backup_rules.xml",
      "source": "files/app/backup_rules.xml.tpl"
    },
    {
      "path": "app/src/main/res/xml/data_extraction_rules.xml",
      "source": "files/app/data_extraction_rules.xml.tpl"
    },
    {
      "path": "app/src/main/res/drawable/ic_launcher_foreground.xml",
      "source": "files/app/ic_launcher_foreground.xml.tpl"
    },
    {
      "path": "app/src/main/res/mipmap-anydpi/ic_launcher.xml",
      "source": "files/app/ic_launcher.xml.tpl"
    },
    {
      "path": "app/src/main/res/mipmap-anydpi/ic_launcher_round.xml",
      "source": "files/app/ic_launcher.xml.tpl"
    },
    {
      "path": "app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml",
      "source": "files/app/ic_launcher_adaptatif.xml.tpl"
    },
    {
      "path": "app/src/main/res/mipmap-anydpi-v26/ic_launcher_round.xml",
      "source": "files/app/ic_launcher_adaptatif.xml.tpl"
    },
    {
      "path": "app/src/main/res/layout/activity_main.xml",
      "source": "files/app/activity_main.xml.tpl",
      "when": "estActiviteVide"
    },
    {
      "path": "app/src/main/res/layout/activity_main_tiroir.xml",
      "source": "files/app/activity_main_tiroir.xml.tpl",
      "when": "estActiviteTiroir"
    },
    {
      "path": "app/src/main/res/layout/fragment_accueil.xml",
      "source": "files/app/fragment_accueil.xml.tpl",
      "when": "estActiviteTiroir"
    },
    {
      "path": "app/src/main/res/layout/fragment_bienvenue.xml",
      "source": "files/app/fragment_bienvenue.xml.tpl",
      "when": "estActiviteVide && avecNavigation"
    },
    {
      "path": "app/src/main/res/menu/tiroir.xml",
      "source": "files/app/tiroir.xml.tpl",
      "when": "estActiviteTiroir"
    },
    {
      "path": "app/src/main/res/navigation/graphe_principal.xml",
      "source": "files/app/graphe_principal.xml.tpl",
      "when": "avecNavigation"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.kt",
      "source": "files/app/MainActivity.kt.tpl",
      "when": "langageKotlin && estActiviteVide && !avecNavigation"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.kt",
      "source": "files/app/MainActivityNavigation.kt.tpl",
      "when": "langageKotlin && estActiviteVide && avecNavigation"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.kt",
      "source": "files/app/MainActivityTiroir.kt.tpl",
      "when": "langageKotlin && estActiviteTiroir"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.java",
      "source": "files/app/MainActivity.java.tpl",
      "when": "!langageKotlin && estActiviteVide && !avecNavigation"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.java",
      "source": "files/app/MainActivityNavigation.java.tpl",
      "when": "!langageKotlin && estActiviteVide && avecNavigation"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/MainActivity.java",
      "source": "files/app/MainActivityTiroir.java.tpl",
      "when": "!langageKotlin && estActiviteTiroir"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/BienvenueFragment.kt",
      "source": "files/app/BienvenueFragment.kt.tpl",
      "when": "langageKotlin && estActiviteVide && avecNavigation"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/BienvenueFragment.java",
      "source": "files/app/BienvenueFragment.java.tpl",
      "when": "!langageKotlin && estActiviteVide && avecNavigation"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/FragmentAccueil.kt",
      "source": "files/app/FragmentAccueil.kt.tpl",
      "when": "langageKotlin && estActiviteTiroir"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/FragmentAccueil.java",
      "source": "files/app/FragmentAccueil.java.tpl",
      "when": "!langageKotlin && estActiviteTiroir"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/{{appName|resourceName}}Application.kt",
      "source": "files/app/Application.kt.tpl",
      "when": "avecHilt && langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/{{appName|resourceName}}Application.java",
      "source": "files/app/Application.java.tpl",
      "when": "avecHilt && !langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/ModuleApplication.kt",
      "source": "files/app/ModuleApplication.kt.tpl",
      "when": "avecHilt && langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/ModuleApplication.java",
      "source": "files/app/ModuleApplication.java.tpl",
      "when": "avecHilt && !langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/ModuleDonnees.kt",
      "source": "files/app/ModuleDonnees.kt.tpl",
      "when": "avecModuleBdd && langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/ModuleDonnees.java",
      "source": "files/app/ModuleDonnees.java.tpl",
      "when": "avecModuleBdd && !langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/BddLocale.kt",
      "source": "files/app/BddLocale.kt.tpl",
      "when": "avecRoom && langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/TacheEntity.java",
      "source": "files/app/TacheEntity.java.tpl",
      "when": "avecRoom && !langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/TacheDao.java",
      "source": "files/app/TacheDao.java.tpl",
      "when": "avecRoom && !langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/BddLocale.java",
      "source": "files/app/BddLocale.java.tpl",
      "when": "avecRoom && !langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/ServiceCitations.kt",
      "source": "files/app/ServiceCitations.kt.tpl",
      "when": "avecRetrofit && langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/ServiceCitations.java",
      "source": "files/app/ServiceCitations.java.tpl",
      "when": "avecRetrofit && !langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/Greeter.kt",
      "source": "files/greeter.kt.tpl",
      "when": "langageKotlin"
    },
    {
      "path": "app/src/main/java/{{packageName|packagePath}}/Greeter.java",
      "source": "files/Greeter.java.tpl",
      "when": "!langageKotlin"
    },
    {
      "path": "app/src/test/java/{{packageName|packagePath}}/ExampleUnitTest.kt",
      "source": "files/ExampleUnitTest.kt.tpl",
      "when": "avecTests && langageKotlin"
    },
    {
      "path": "app/src/test/java/{{packageName|packagePath}}/ExampleUnitTest.java",
      "source": "files/ExampleUnitTest.java.tpl",
      "when": "avecTests && !langageKotlin"
    },
    {
      "path": "app/src/test/java/{{packageName|packagePath}}/GreeterTest.kt",
      "source": "files/GreeterTest.kt.tpl",
      "when": "avecTests && langageKotlin"
    },
    {
      "path": "app/src/test/java/{{packageName|packagePath}}/GreeterTest.java",
      "source": "files/GreeterTest.java.tpl",
      "when": "avecTests && !langageKotlin"
    }
  ]
}
