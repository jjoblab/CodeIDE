<?xml version="1.0" encoding="utf-8"?>
<!-- Règles de transfert de données Android 12+ (sauvegarde cloud et
     transfert d'appareil à appareil). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- À adapter : <exclude domain="sharedpref" path="prefs_sensibles.xml" /> -->
    </cloud-backup>
    <device-transfer>
        <!-- À adapter : <exclude domain="database" path="taches.db" /> -->
    </device-transfer>
</data-extraction-rules>
