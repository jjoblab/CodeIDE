{
  "schemaVersion": 1,
  "id": "spring-boot",
  "templateVersion": "2.0.0",
  "nameKey": "template.name",
  "descriptionKey": "template.description",
  "category": "jvm",
  "iconKey": "template.icon",
  "tags": [
    "Spring Boot",
    "Kotlin",
    "Java",
    "REST"
  ],
  "parameters": [
    {
      "id": "artifactId",
      "type": "TEXT",
      "labelKey": "param.artifactId.label",
      "helpKey": "param.artifactId.help",
      "defaultFrom": "slug",
      "validator": "regex:^[a-z0-9][a-z0-9._-]*$",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "packageName",
      "type": "TEXT",
      "labelKey": "param.packageName.label",
      "helpKey": "param.packageName.help",
      "defaultFrom": "packageFromArtifactId",
      "validator": "package-name",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "groupId",
      "type": "TEXT",
      "labelKey": "param.groupId.label",
      "helpKey": "param.groupId.help",
      "defaultFrom": "parentPackage",
      "section": "INFORMATION",
      "persist": true,
      "validator": "package-name"
    },
    {
      "id": "version",
      "type": "TEXT",
      "labelKey": "param.version.label",
      "helpKey": "param.version.help",
      "default": "0.1.0",
      "validator": "semver",
      "section": "INFORMATION",
      "persist": true
    },
    {
      "id": "langage",
      "type": "CHOICE",
      "labelKey": "param.langage.label",
      "helpKey": "param.langage.help",
      "choices": [
        "kotlin",
        "java"
      ],
      "default": "kotlin",
      "groupe": "plateforme",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "buildSystem",
      "type": "CHOICE",
      "labelKey": "param.buildSystem.label",
      "helpKey": "param.buildSystem.help",
      "choices": [
        "gradle",
        "maven"
      ],
      "default": "gradle",
      "groupe": "plateforme",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "jdkVersion",
      "type": "CHOICE",
      "labelKey": "param.jdkVersion.label",
      "helpKey": "param.jdkVersion.help",
      "choices": [
        "17",
        "21"
      ],
      "default": "21",
      "groupe": "plateforme",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "includeWrapper",
      "type": "BOOLEAN",
      "labelKey": "param.includeWrapper.label",
      "helpKey": "param.includeWrapper.help",
      "default": "true",
      "visibleWhen": "buildSystem == \"gradle\"",
      "avance": true,
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "includeJpa",
      "type": "BOOLEAN",
      "labelKey": "param.includeJpa.label",
      "helpKey": "param.includeJpa.help",
      "default": "false",
      "groupe": "donnees",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeValidation",
      "type": "BOOLEAN",
      "labelKey": "param.includeValidation.label",
      "helpKey": "param.includeValidation.help",
      "default": "false",
      "groupe": "donnees",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeTests",
      "type": "BOOLEAN",
      "labelKey": "param.includeTests.label",
      "helpKey": "param.includeTests.help",
      "default": "true",
      "groupe": "qualite",
      "section": "CONFIGURATION",
      "persist": true
    },
    {
      "id": "includeSecurity",
      "type": "BOOLEAN",
      "labelKey": "param.includeSecurity.label",
      "helpKey": "param.includeSecurity.help",
      "default": "false",
      "groupe": "exploitation",
      "section": "CONFIGURATION",
      "persist": false
    },
    {
      "id": "includeActuator",
      "type": "BOOLEAN",
      "labelKey": "param.includeActuator.label",
      "helpKey": "param.includeActuator.help",
      "default": "false",
      "groupe": "exploitation",
      "section": "CONFIGURATION",
      "persist": false
    }
  ],
  "computed": [
    {
      "name": "gradle",
      "expression": "buildSystem == \"gradle\""
    },
    {
      "name": "langageKotlin",
      "expression": "langage == \"kotlin\""
    },
    {
      "name": "langageJava",
      "expression": "langage == \"java\""
    },
    {
      "name": "estGradle",
      "expression": "buildSystem == \"gradle\""
    },
    {
      "name": "estMaven",
      "expression": "buildSystem == \"maven\""
    },
    {
      "name": "avecTests",
      "expression": "includeTests"
    },
    {
      "name": "avecWrapper",
      "expression": "buildSystem == \"gradle\" && includeWrapper"
    },
    {
      "name": "avecJpa",
      "expression": "includeJpa"
    },
    {
      "name": "avecValidation",
      "expression": "includeValidation"
    },
    {
      "name": "avecSecurity",
      "expression": "includeSecurity"
    },
    {
      "name": "avecActuator",
      "expression": "includeActuator"
    }
  ],
  "constraints": [
    {
      "when": "includeJpa && langage == \"kotlin\" && buildSystem == \"maven\"",
      "severity": "INFO",
      "messageKey": "hint.jpa.kotlin.maven"
    }
  ],
  "autoDefinit": [],
  "wizard": {
    "etapes": [
      {
        "id": "langage-build",
        "titreKey": "etape.langage-build.titre",
        "parametres": [
          "langage",
          "buildSystem",
          "jdkVersion",
          "includeWrapper"
        ]
      },
      {
        "id": "modules",
        "titreKey": "etape.modules.titre",
        "parametres": [
          "includeJpa",
          "includeValidation",
          "includeTests"
        ]
      },
      {
        "id": "exploitation",
        "titreKey": "etape.exploitation.titre",
        "parametres": [
          "includeSecurity",
          "includeActuator"
        ]
      }
    ],
    "presets": [
      {
        "id": "api-rest-jpa",
        "nomKey": "preset.api-rest.nom",
        "descriptionKey": "preset.api-rest.description",
        "valeurs": {
          "includeJpa": true,
          "includeValidation": true
        }
      }
    ]
  },
  "files": [
    {
      "path": ".gitattributes",
      "source": "commun:gitattributes.tpl",
      "when": "includeGitattributes"
    },
    {
      "path": ".gitignore",
      "source": "files/gitignore.tpl",
      "when": "includeGitignore",
      "group": "gitignore"
    },
    {
      "path": ".editorconfig",
      "source": "commun:editorconfig.tpl",
      "when": "includeEditorconfig",
      "group": "editorconfig"
    },
    {
      "path": "README.md",
      "source": "files/readme.md.tpl",
      "when": "includeReadme",
      "group": "readme"
    },
    {
      "path": "settings.gradle.kts",
      "source": "files/settings.gradle.kts.tpl",
      "when": "estGradle"
    },
    {
      "path": "build.gradle.kts",
      "source": "files/build.gradle.kts.tpl",
      "when": "estGradle"
    },
    {
      "path": "gradle/libs.versions.toml",
      "source": "files/libs.versions.toml.tpl",
      "when": "estGradle"
    },
    {
      "path": "gradle.properties",
      "source": "files/gradle.properties.tpl",
      "when": "estGradle"
    },
    {
      "path": "gradle/wrapper/gradle-wrapper.properties",
      "source": "commun:gradle/wrapper/wrapper.properties.tpl",
      "when": "avecWrapper"
    },
    {
      "path": "gradlew",
      "source": "commun:gradlew.tpl",
      "when": "avecWrapper"
    },
    {
      "path": "gradlew.bat",
      "source": "commun:gradlew.bat.tpl",
      "when": "avecWrapper"
    },
    {
      "path": "gradle/wrapper/gradle-wrapper.jar",
      "source": "commun:gradle/wrapper/gradle-wrapper.jar",
      "when": "avecWrapper",
      "binary": true
    },
    {
      "path": "pom.xml",
      "source": "files/pom.xml.tpl",
      "when": "estMaven"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/Application.kt",
      "source": "files/Application.kt.tpl",
      "when": "langageKotlin"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/GreeterController.kt",
      "source": "files/GreeterController.kt.tpl",
      "when": "langageKotlin"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/GreeterService.kt",
      "source": "files/GreeterService.kt.tpl",
      "when": "langageKotlin"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/Salutation.kt",
      "source": "files/Salutation.kt.tpl",
      "when": "langageKotlin"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/DepotSalutations.kt",
      "source": "files/DepotSalutations.kt.tpl",
      "when": "langageKotlin"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/GreeterRepository.kt",
      "source": "files/GreeterRepositoryJpa.kt.tpl",
      "when": "langageKotlin && avecJpa"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/EntiteSalutation.kt",
      "source": "files/EntiteSalutation.kt.tpl",
      "when": "langageKotlin && avecJpa"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/DepotEntitesSalutation.kt",
      "source": "files/DepotEntitesSalutation.kt.tpl",
      "when": "langageKotlin && avecJpa"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/GreeterRepository.kt",
      "source": "files/GreeterRepositoryMemoire.kt.tpl",
      "when": "langageKotlin && !avecJpa"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/DemandeSalutation.kt",
      "source": "files/DemandeSalutation.kt.tpl",
      "when": "langageKotlin && avecValidation"
    },
    {
      "path": "src/main/kotlin/{{packageName|packagePath}}/SecuriteConfiguration.kt",
      "source": "files/SecuriteConfiguration.kt.tpl",
      "when": "langageKotlin && avecSecurity"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/Application.java",
      "source": "files/Application.java.tpl",
      "when": "langageJava"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/GreeterController.java",
      "source": "files/GreeterController.java.tpl",
      "when": "langageJava"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/GreeterService.java",
      "source": "files/GreeterService.java.tpl",
      "when": "langageJava"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/Salutation.java",
      "source": "files/Salutation.java.tpl",
      "when": "langageJava"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/DepotSalutations.java",
      "source": "files/DepotSalutations.java.tpl",
      "when": "langageJava"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/GreeterRepository.java",
      "source": "files/GreeterRepositoryJpa.java.tpl",
      "when": "langageJava && avecJpa"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/EntiteSalutation.java",
      "source": "files/EntiteSalutation.java.tpl",
      "when": "langageJava && avecJpa"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/DepotEntitesSalutation.java",
      "source": "files/DepotEntitesSalutation.java.tpl",
      "when": "langageJava && avecJpa"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/GreeterRepository.java",
      "source": "files/GreeterRepositoryMemoire.java.tpl",
      "when": "langageJava && !avecJpa"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/DemandeSalutation.java",
      "source": "files/DemandeSalutation.java.tpl",
      "when": "langageJava && avecValidation"
    },
    {
      "path": "src/main/java/{{packageName|packagePath}}/SecuriteConfiguration.java",
      "source": "files/SecuriteConfiguration.java.tpl",
      "when": "langageJava && avecSecurity"
    },
    {
      "path": "src/main/resources/application.yml",
      "source": "files/application.yml.tpl"
    },
    {
      "path": "src/main/resources/application-dev.yml",
      "source": "files/application-dev.yml.tpl"
    },
    {
      "path": "src/main/resources/application-prod.yml",
      "source": "files/application-prod.yml.tpl"
    },
    {
      "path": "src/test/kotlin/{{packageName|packagePath}}/ApplicationTests.kt",
      "source": "files/ApplicationTests.kt.tpl",
      "when": "langageKotlin && avecTests"
    },
    {
      "path": "src/test/kotlin/{{packageName|packagePath}}/GreeterServiceTest.kt",
      "source": "files/GreeterServiceTest.kt.tpl",
      "when": "langageKotlin && avecTests"
    },
    {
      "path": "src/test/kotlin/{{packageName|packagePath}}/ValidationSalutationsTest.kt",
      "source": "files/ValidationSalutationsTest.kt.tpl",
      "when": "langageKotlin && avecTests && avecValidation"
    },
    {
      "path": "src/test/kotlin/{{packageName|packagePath}}/SecuriteEndpointsTest.kt",
      "source": "files/SecuriteEndpointsTest.kt.tpl",
      "when": "langageKotlin && avecTests && avecSecurity"
    },
    {
      "path": "src/test/java/{{packageName|packagePath}}/ApplicationTests.java",
      "source": "files/ApplicationTests.java.tpl",
      "when": "langageJava && avecTests"
    },
    {
      "path": "src/test/java/{{packageName|packagePath}}/GreeterServiceTest.java",
      "source": "files/GreeterServiceTest.java.tpl",
      "when": "langageJava && avecTests"
    },
    {
      "path": "src/test/java/{{packageName|packagePath}}/ValidationSalutationsTest.java",
      "source": "files/ValidationSalutationsTest.java.tpl",
      "when": "langageJava && avecTests && avecValidation"
    },
    {
      "path": "src/test/java/{{packageName|packagePath}}/SecuriteEndpointsTest.java",
      "source": "files/SecuriteEndpointsTest.java.tpl",
      "when": "langageJava && avecTests && avecSecurity"
    }
  ]
}
