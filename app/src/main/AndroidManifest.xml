<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions (ADR 0034 ; stockage révisé par ADR 0047, v0.31.3) :

      - INTERNET : unique usage réseau depuis l'étape T3 — téléchargement
        du bootstrap et de ses paquets d'outils.

      - Stockage partagé, OPT-IN (ADR 0047) : l'environnement Linux vit
        dans le stockage privé de l'application, qui ne demande RIEN pour
        fonctionner (apt compris — l'erreur d'appareil réel `mkstemp`
        ENOENT était un répertoire `$PREFIX/tmp` absent, errno 2, pas un
        refus de permission, errno 13). Le trio ci-dessous ne sert qu'à
        l'accès OPTIONNEL au stockage partagé (`/storage/emulated/0`)
        depuis les sessions du terminal — modèle repris de Termux,
        même contrainte cible 28 (W^X, ADR 0045) : READ/WRITE couvrent
        l'accès legacy (Android < 11), MANAGE_EXTERNAL_STORAGE le réglage
        « Tous les fichiers » (Android 11+). Jamais exigés : la page de
        l'assistant les propose, « Suivant » passe sans rien accorder.

      localeConfig (ADR 0013) : langues proposées par le réglage
      « langue par application » du système (Android 13+) — la source
      de vérité reste AppSettings, appliquée via
      AppCompatDelegate.setApplicationLocales. Ignoré sans effet sous
      API 33 (attribut décoratif : tools:targetApi coupe le faux
      positif lint UnusedAttribute, minSdk = 26).
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name="jo.codeide.CodeIdeApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeIDE"
        tools:targetApi="33">

        <!--
          Thème de l'écran de démarrage : installSplashScreen() le
          convertit en Theme.CodeIDE dès que la fenêtre est prête
          (définitions dans core:ui).

          singleTop (v0.31.4, ADR 0048) : les activités plein écran
          (terminal, éditeur) remontent cette activité via
          REORDER_TO_FRONT | SINGLE_TOP avec un extra de routage —
          l'instance existante reçoit onNewIntent SANS recréation ni
          duplication, l'activité appelante survit dessous.
        -->
        <activity
            android:name="jo.codeide.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CodeIDE.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Partage des archives de journaux (section 5.7) : le FileProvider
          n'expose que cache/exports/ (voir res/xml/file_paths.xml), et
          uniquement sur demande explicite de l'utilisateur.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
