<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Aucune permission : règle 7 du prompt maître (pas de INTERNET,
      pas de MANAGE_EXTERNAL_STORAGE — jamais à ce stade).
    -->

    <application
        android:name="jo.codeide.CodeIdeApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeIDE">

        <!--
          Thème de l'écran de démarrage : installSplashScreen() le
          convertit en Theme.CodeIDE dès que la fenêtre est prête
          (définitions dans core:ui).
        -->
        <activity
            android:name="jo.codeide.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CodeIDE.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
