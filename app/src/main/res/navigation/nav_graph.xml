<?xml version="1.0" encoding="utf-8"?>
<!--
  Graphe de navigation CodeIDE — étape 7 : le wizard de création
  (destination placeholder, écran complet à l'étape 10) rejoint le
  graphe depuis l'accueil. La destination initiale reste l'accueil ;
  `MainActivity` route vers l'assistant (en racine) quand
  `isSetupCompleted` est faux. Le diagnostic et l'éditeur rejoindront
  le graphe aux étapes 12 et 13.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="jo.codeide.feature.home.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settings" />
        <action
            android:id="@+id/action_home_to_onboarding"
            app:destination="@id/onboarding" />
        <action
            android:id="@+id/action_home_to_newproject"
            app:destination="@id/newproject" />
        <action
            android:id="@+id/action_home_to_installation"
            app:destination="@id/installation" />
    </fragment>

    <fragment
        android:id="@+id/settings"
        android:name="jo.codeide.feature.settings.SettingsFragment"
        android:label="@string/settings_title"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_onboarding"
            app:destination="@id/onboarding" />
        <action
            android:id="@+id/action_settings_to_diagnostics"
            app:destination="@id/diagnostics" />
    </fragment>

    <!-- ===== Sections des Paramètres (ADR 0059 : deux niveaux) ===== -->

    <fragment
        android:id="@+id/settings_apparence"
        android:name="jo.codeide.feature.settings.ApparenceFragment"
        android:label="@string/settings_apparence_titre"
        tools:layout="@layout/fragment_settings_apparence" />

    <fragment
        android:id="@+id/settings_langue"
        android:name="jo.codeide.feature.settings.LangueFragment"
        android:label="@string/settings_langue_titre"
        tools:layout="@layout/fragment_settings_langue" />

    <fragment
        android:id="@+id/settings_notifications"
        android:name="jo.codeide.feature.settings.NotificationsFragment"
        android:label="@string/settings_notifications_titre"
        tools:layout="@layout/fragment_settings_notifications" />

    <fragment
        android:id="@+id/settings_editeur"
        android:name="jo.codeide.feature.settings.EditeurFragment"
        android:label="@string/settings_editeur_titre"
        tools:layout="@layout/fragment_settings_editeur" />

    <fragment
        android:id="@+id/settings_terminal"
        android:name="jo.codeide.feature.settings.TerminalSectionFragment"
        android:label="@string/settings_terminal_titre"
        tools:layout="@layout/fragment_settings_terminal" />

    <fragment
        android:id="@+id/settings_projets"
        android:name="jo.codeide.feature.settings.ProjetsFragment"
        android:label="@string/settings_projets_titre"
        tools:layout="@layout/fragment_settings_projets" />

    <fragment
        android:id="@+id/settings_apropos"
        android:name="jo.codeide.feature.settings.AProposFragment"
        android:label="@string/settings_apropos_titre"
        tools:layout="@layout/fragment_settings_apropos" />

    <fragment
        android:id="@+id/settings_avance"
        android:name="jo.codeide.feature.settings.AvanceFragment"
        android:label="@string/settings_avance_titre"
        tools:layout="@layout/fragment_settings_avance" />

    <!-- Écran générique « bientôt disponible » : IA, Outils de
         développement, Sécurité — le même fragment, les arguments
         portent la section (patron réutilisable, ADR 0059). -->
    <fragment
        android:id="@+id/settings_bientot"
        android:name="jo.codeide.feature.settings.BientotFragment"
        android:label="@string/settings_title">
        <argument
            android:name="section"
            app:argType="jo.codeide.core.ui.SectionParametres" />
    </fragment>

    <fragment
        android:id="@+id/diagnostics"
        android:name="jo.codeide.feature.diagnostics.DiagnosticFragment"
        android:label="@string/diagnostics_title"
        tools:layout="@layout/fragment_diagnostic" />

    <fragment
        android:id="@+id/onboarding"
        android:name="jo.codeide.feature.onboarding.OnboardingFragment"
        android:label="@string/onboarding_title"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_installation"
            app:destination="@id/installation" />
    </fragment>

    <!-- Écran d'installation du bootstrap (Terminal T3) : atteint depuis
         l'accueil (bandeau) et l'assistant (étape Terminal) — l'état de
         l'installation est partagé, jamais relancé à l'ouverture. -->
    <fragment
        android:id="@+id/installation"
        android:name="jo.codeide.feature.install.InstallFragment"
        android:label="@string/installation_titre"
        tools:layout="@layout/fragment_install" />

    <fragment
        android:id="@+id/newproject"
        android:name="jo.codeide.feature.newproject.NewProjectFragment"
        android:label="@string/newproject_title"
        tools:layout="@layout/fragment_newproject" />

</navigation>
