<?xml version="1.0" encoding="utf-8"?>
<!--
  Carte d'un préréglage déclaré (ADR 0155, B-8) : pose un jeu de valeurs
  cohérent en un geste. Le bouton éclair lance le mode rapide (L5d) :
  préréglage puis récapitulatif.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CodeIDE.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titre_preset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/description_preset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_mode_rapide"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/wizard_preset_rapide_desc"
            app:icon="@drawable/ic_mode_rapide" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
