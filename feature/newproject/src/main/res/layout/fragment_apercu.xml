<?xml version="1.0" encoding="utf-8"?>
<!--
  Aperçu en direct du plan (L5d, ADR 0155 §6) : différentiel ajouté/retiré,
  progression, erreur et arborescence prévue — utilisé tel quel comme panneau
  latéral (tablette) et comme contenu de la feuille basse (téléphone).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/titre_apercu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:text="@string/wizard_apercu_titre"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <LinearLayout
        android:id="@+id/ligne_differences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <com.google.android.material.chip.Chip
            android:id="@+id/puce_ajoutes"
            style="@style/Widget.CodeIDE.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:checkable="false"
            android:visibility="gone" />

        <com.google.android.material.chip.Chip
            android:id="@+id/puce_retires"
            style="@style/Widget.CodeIDE.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_sm"
            android:checkable="false"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progression_apercu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:indeterminate="true"
        android:visibility="gone" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/texte_erreur_apercu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:text="@string/wizard_apercu_erreur"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_reessayer_apercu"
        style="@style/Widget.CodeIDE.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/wizard_recap_plan_reessayer"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/liste_apercu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingBottom="@dimen/spacing_md"
        android:overScrollMode="never" />
</LinearLayout>
