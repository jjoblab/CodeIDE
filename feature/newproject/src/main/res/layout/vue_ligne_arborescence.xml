<?xml version="1.0" encoding="utf-8"?>
<!--
  Une ligne de l'arborescence du récapitulatif (section 12.3) : dossier
  repliable (chevron d'état, indentation par profondeur) ou fichier feuille.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal">

    <Space
        android:id="@+id/espace_indentation"
        android:layout_width="16dp"
        android:layout_height="0dp" />

    <ImageView
        android:id="@+id/icone_dossier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:src="@drawable/ic_dossier_arborescence"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/texte_noeud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="src/main/kotlin" />
</LinearLayout>
