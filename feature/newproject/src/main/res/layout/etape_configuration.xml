<?xml version="1.0" encoding="utf-8"?>
<!--
  Étape 2 « Configuration » : rendu dynamique des paramètres (section 12.3)
  + rangée de puces récapitulatives en direct. Le conteneur anime
  l'apparition/disparition des champs (animateLayoutChanges).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contenu_configuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingBottom="@dimen/spacing_md">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/puces_recapitulatif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:singleLine="true" />

        <LinearLayout
            android:id="@+id/conteneur_parametres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
