<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran de création (section 12.3, hors numérotation) : progression en
  temps réel avec annulation, ou écran de succès / d'échec avec actions.
  V0.31.5 : l'échec porte ses détails techniques (bornés, monospace) et
  propose « Changer de nom ou d'emplacement » en cas de collision.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Progression en cours -->
    <LinearLayout
        android:id="@+id/conteneur_progression"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingBottom="@dimen/spacing_md">

        <TextView
            android:id="@+id/texte_titre_creation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/wizard_creation_titre"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progression_creation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:indeterminate="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/liste_evenements"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_weight="1"
            android:overScrollMode="never" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_annuler"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/wizard_creation_annuler" />
    </LinearLayout>

    <!-- Succès -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteneur_succes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:id="@+id/icone_succes"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_creation_succes"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/texte_succes_titre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_horizontal"
                android:text="@string/wizard_succes_titre"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/texte_succes_projet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_horizontal"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_ouvrir_projet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/wizard_succes_ouvrir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_retour_accueil"
                style="@style/Widget.CodeIDE.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/wizard_succes_accueil" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_autre_projet"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/wizard_succes_autre" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Échec -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteneur_echec"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_creation_echec"
                app:tint="?attr/colorError" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_horizontal"
                android:text="@string/wizard_echec_titre"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/texte_echec_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_horizontal"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/texte_echec_nettoyage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_horizontal"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- V0.31.5 : diagnostic technique VISIBLE (borné) — URI de
                 l'homonyme, pré-vol, insertion refusée ; reste copiable. -->
            <TextView
                android:id="@+id/texte_echec_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- V0.31.5 : sortie du piège « choisis un autre nom » —
                 l'écran le propose enfin (collision uniquement). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_corriger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/wizard_echec_corriger"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_reessayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/wizard_echec_reessayer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_copier_details"
                style="@style/Widget.CodeIDE.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/wizard_echec_copier" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_retour_recapitulatif"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/wizard_echec_retour" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
