<?xml version="1.0" encoding="utf-8"?>
<!--
  Onglet Journaux de l'écran Diagnostic (lot L4, ADR 0162) — le chrome
  des ACTIONS autour du lecteur UNIQUE du Centre de sorties (famille
  JOURNAL) : filtres par niveau (persistés), réglage du niveau de
  journalisation, partage / enregistrement / effacement, occupation
  disque, bandeau honnête si la lecture d'historique a échoué. La
  visionneuse (recherche n/N insensible aux accents, fenêtre, suivi,
  état vide) est le lecteur embarqué — pas un second afficheur.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_sm"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="false"
            app:singleLine="true"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_debug"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_niveau_debug" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_info"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_niveau_info" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_warn"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_niveau_warn" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_error"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_niveau_error" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_verbosite"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            tools:text="Niveau : Normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_partager"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/diagnostics_partager_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            app:icon="@drawable/ic_partager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_enregistrer"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/diagnostics_enregistrer_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            app:icon="@drawable/ic_enregistrer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_effacer"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/diagnostics_effacer_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            app:icon="@drawable/ic_effacer" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/texte_usage_disque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_xs"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Journaux : 12 Ko · 2 fichiers" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/texte_erreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_xs"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone"
        tools:text="Opération impossible pour le moment." />

    <!-- Lecture d'historique en échec : bandeau honnête (règle 14) — le
         lecteur reste utilisable (les entrées vivantes continuent). -->
    <jo.codeide.core.ui.BandeauSorties
        android:id="@+id/bandeau_lecture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_xs"
        app:bandeauSortiesEtat="erreur"
        app:bandeauSortiesTitre="@string/diagnostics_lecture_echec"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- ===================== Le lecteur (UNE fenêtre) ================== -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/conteneur_lecteur"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_weight="1"
        tools:layout="@layout/fragment_lecteur_sorties" />

</LinearLayout>
