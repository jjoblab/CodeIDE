<?xml version="1.0" encoding="utf-8"?>
<!--
  Ligne d'un rapport de plantage (étape 12) : date, type, classe
  d'exception, résumé, pastille « Non consulté » et suppression propre.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/date_rapport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="3 sept. 2026 · 14:23:05" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/type_rapport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                tools:text="Exception" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/pastille_non_consulte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/diagnostics_non_consulte"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/exception_rapport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="IllegalStateException" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/resume_rapport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Plantage de test provoqué depuis le menu debug" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_supprimer"
        style="@style/Widget.CodeIDE.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:minWidth="@dimen/touch_target_min"
        android:minHeight="@dimen/touch_target_min"
        app:icon="@drawable/ic_supprimer" />
</LinearLayout>
