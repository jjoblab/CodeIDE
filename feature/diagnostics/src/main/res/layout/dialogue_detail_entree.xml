<?xml version="1.0" encoding="utf-8"?>
<!--
  Détail d'une entrée de journal (étape 12) : dialogue à vue dédiée —
  métadonnées, message complet et exception repliable.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_horodatage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="jeudi 3 septembre 2026 · 14:23:05.128" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_niveau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="Erreur" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_etiquette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Étiquette : Session" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_thread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Thread : main" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Session : 3f9c…" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true"
            tools:text="Message complet de l'entrée…" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_exception"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/diagnostics_detail_voir_exception" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_exception"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textIsSelectable="true"
            android:visibility="gone"
            tools:text="IllegalStateException: …"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
