<?xml version="1.0" encoding="utf-8"?>
<!--
  Hôte de l'assistant : indicateur de progression, pager des cinq pages
  (non swipable — navigation aux boutons, étape 5) et barre inférieure.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".OnboardingFragment">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:max="5"
        android:progress="1"
        tools:progress="2" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_precedent"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/onboarding_precedent"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_suivant"
            style="@style/Widget.CodeIDE.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_commencer" />

    </LinearLayout>

</LinearLayout>
