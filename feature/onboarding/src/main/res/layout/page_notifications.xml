<?xml version="1.0" encoding="utf-8"?>
<!--
  Page Notifications de l'assistant (v0.31.2, ADR 0046) : pourquoi
  l'application notifie (service du terminal, installations longues),
  pourquoi AUCUNE permission de stockage n'est demandée (SAF + stockage
  privé), demande directe ou repli vers les réglages. Jamais bloquante.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/page_notifications_titre"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/page_notifications_texte"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/page_notifications_stockage"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_autoriser_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/page_notifications_autoriser" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_notifications_activees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/page_notifications_activees"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_reglages_notifications"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/page_notifications_reglages" />

    </LinearLayout>

</ScrollView>
