<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 2 — Dossier de travail : sélecteur SAF, état de la vérification,
  message des dossiers refusés et « Plus tard » (étape passable).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/titre_dossier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/page_dossier_titre"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/texte_dossier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/page_dossier_texte"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progression_dossier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/texte_etat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone"
        tools:text="Dossier de travail : CodeIDE"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/texte_erreur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone"
        tools:text="Android interdit ce dossier."
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_choisir"
        style="@style/Widget.CodeIDE.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/page_dossier_choisir" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_passer"
        style="@style/Widget.CodeIDE.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/page_dossier_passer" />

</LinearLayout>
