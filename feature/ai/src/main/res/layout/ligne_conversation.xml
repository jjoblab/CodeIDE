<?xml version="1.0" encoding="utf-8"?>
<!--
  Ligne de conversation (mission IA, lot IA-6, spec E6) : titre auto ou
  renommé, date relative, épinglage en UN appui + suppression DIRECTE
  avec « Annuler » côté Snackbar (rapport IA, lot 3 — d'après la
  maquette), menu Renommer. Appui = rouvrir dans le chat. TalkBack :
  description complète de la ligne et de chaque bouton.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_conversation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_sm"
    android:paddingVertical="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/titre_conversation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Corriger le plantage du terminal" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/meta_conversation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="il y a 3 min · claude-test" />
    </LinearLayout>

    <!-- Épinglage (rapport IA, lot 3 — d'après la maquette) : UN appui
         épingle/détache — une discussion épinglée reste en tête de
         liste, l'icône est teintée primaire quand épinglée. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_epingle_conversation"
        style="@style/Widget.CodeIDE.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ia_historique_epingler_cd"
        app:icon="@drawable/ic_epingle" />

    <!-- Suppression DIRECTE (rapport IA, lot 3 — d'après la maquette) :
         la ligne part immédiatement, l'annulation vit dans le Snackbar
         « Annuler » (restauration complète, conversation + messages). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_supprimer_conversation"
        style="@style/Widget.CodeIDE.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ia_historique_supprimer_cd"
        app:icon="@drawable/ic_fermer_onglet" />

    <!-- Menu de ligne : Renommer (spec E6 — renommage conservé ; la
         suppression vit directement sur la ligne depuis le lot 3). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_menu_conversation"
        style="@style/Widget.CodeIDE.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ia_historique_menu_cd"
        app:icon="@drawable/ic_outils" />
</LinearLayout>
