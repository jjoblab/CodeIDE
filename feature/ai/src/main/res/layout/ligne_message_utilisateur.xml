<?xml version="1.0" encoding="utf-8"?>
<!-- Message utilisateur : bulle alignée à droite (colorPrimaryContainer). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_sm"
    android:paddingVertical="@dimen/spacing_xs">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/texte_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/fond_bulle_utilisateur"
        android:maxWidth="320dp"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_sm"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnPrimaryContainer" />
</FrameLayout>
