<?xml version="1.0" encoding="utf-8"?>
<!--
  Paramètres → Assistant IA (mission IA, lot IA-2 — spec E4, maquette
  docs/mockups/ia/ia-ecrans.html). Cinq cartes : Activation (+ lien
  consentement) / Fournisseur (liste + pastille d'état de clé) /
  Modèle (champ + actualisation) / Confidentialité (3 interrupteurs,
  ADR 0124 §4) / Limites (plafonds de la mission, ADR 0123 point 6).
  Les cartes Historique (IA-6) et Agent (IA-7) arriveront avec leurs lots :
  « aucun contrôle sans effet » (ADR 0059) — elles sont absentes ici.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_reglages_ia"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/ia_retour_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ia_reglages_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Carte « Activer l'assistant IA » : interrupteur maître +
                 lien vers le consentement (ce qui est envoyé). -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_carte_activation_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_carte_activation_titre"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/ia_activation_sous_titre"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_ia_active"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ligne_consentement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/ia_cd_consentement"
                            android:src="@drawable/ic_bouclier"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:text="@string/ia_ligne_consentement"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/ia_cd_consentement"
                            android:src="@drawable/ic_chevron_droite"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Fournisseur » : deux lignes (identifiants fermés
                 de FournisseursIa), pastille d'état de clé par ligne —
                 l'appui ouvre le détail (URL, clé, test). -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_carte_fournisseur_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <LinearLayout
                        android:id="@+id/rangee_fournisseur_anthropic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_fournisseur_anthropic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:contentDescription="@string/ia_cd_ligne_fournisseur"
                            android:focusable="false" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_fournisseur_anthropic"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/sous_titre_fournisseur_anthropic"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Clé enregistrée ••••1234" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rangee_fournisseur_openai"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_fournisseur_openai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:contentDescription="@string/ia_cd_ligne_fournisseur"
                            android:focusable="false" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_fournisseur_openai"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/sous_titre_fournisseur_openai"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Clé à saisir" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Modèle » : champ libre (jamais de nom codé en dur,
                 ADR 0123 point 6) + bouton Actualiser (listModels du
                 fournisseur actif) + suggestions déroulantes. -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_carte_modele_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/ia_modele_hint">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/champ_modele_ia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                tools:ignore="TextFields" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/bouton_actualiser_modeles"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/ia_actualiser_cd"
                            android:src="@drawable/ic_synchronisation"
                            app:tint="?attr/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Confidentialité » : trois interrupteurs réels
                 (ADR 0124 §4) consommés par l'assembleur de contexte IA-4. -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_carte_confidentialite_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_conf_fichier"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_conf_fichier_sous"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_conf_fichier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_conf_chemins"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_conf_chemins_sous"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_conf_chemins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_conf_diagnostics"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ia_conf_diagnostics_sous"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_conf_diagnostics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Limites » : plafonds consommés par les requêtes
                 (jetons de réponse) et le routeur (délai). -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_carte_limites_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ia_limites_jetons_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/champ_max_jetons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ia_limites_delai_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/champ_delai"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Historique » (mission IA, lot IA-6, ADR 0124 §5,
                 spec E4) : rétention des conversations (7 j / 30 j /
                 illimitée) + tout effacer. -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_sm"
                android:layout_marginVertical="@dimen/spacing_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_carte_historique_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ia_carte_historique_message"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Rétention : sélecteur (dialogue à choix unique). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_retention_historique"
                        style="@style/Widget.CodeIDE.Button.Outlined.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/ia_retention_libelle_30j" />

                    <!-- Tout effacer (confirmation préalable). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_tout_effacer_historique"
                        style="@style/Widget.CodeIDE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ia_historique_tout_effacer"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/ia_historique_tout_effacer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
