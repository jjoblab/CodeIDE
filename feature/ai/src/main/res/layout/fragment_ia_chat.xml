<?xml version="1.0" encoding="utf-8"?>
<!--
  Onglet Chat du tiroir IA (mission IA, lots IA-3 et IA-4 — spec E1 ;
  v0.188.0, rapport IA §5 Lot 3 — B1a/B1b : la zone de saisie masquée) :
  liste des messages (DiffUtil), rangée de PUCES de contexte (ce qui
  part — retirable, sélecteur @, budget de jetons), et compositeur
  (saisie multi-ligne + Envoyer/Arrêter — le bouton bascule pendant la
  génération).

  v0.188.0 : le calque `etat_transverse` vit DANS la zone des messages
  (FrameLayout à poids 1 qui contient la liste ET le calque) — AVANT il
  était un frère FULL-SCREEN du compositeur déclaré APRÈS lui : il le
  recouvrait quand l'IA était active et la conversation vide
  (exactement au moment de taper le premier message). Le compositeur
  (`composeur_ia`) n'est PLUS jamais recouvert : il ne se masque que
  dans les états INACTIF et CLE_ABSENTE (choix explicite du fragment,
  plus de recouvrement).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- En-tête du chat (rapport IA, Lot 5, point 3) : le modèle actif
         se lit et se choisit ICI, sans repasser par Paramètres. La
         visibilité suit l'état d'écran (masqué si l'assistant est
         inactif ou la clé absente — jamais de contrôle sans effet). -->
    <LinearLayout
        android:id="@+id/en_tete_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_modele"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/ia_chat_modele_cd"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            tools:text="claude-sonnet-4" />

        <!-- Compteur d'usage de la conversation (rapport IA, Lot 5,
             point 4) : jetons RAPPORTÉS par le fournisseur, cumulés
             depuis le premier message — masqué tant que rien n'a été
             rapporté (jamais d'estimation locale). -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Entrée 123 · Sortie 45"
            tools:visibility="visible" />

        <!-- ＋ Nouvelle discussion (B3, rapport IA lot 1) : referme la
             conversation courante (messages, pièces de contexte,
             jetons, annulation d'une génération en cours) — une
             discussion VIDE n'est jamais persistée, aucune fantôme
             dans l'historique. Zone tactile ≥ 48 dp (style Icon). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_nouvelle_discussion"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:contentDescription="@string/ia_chat_nouvelle_discussion"
            app:icon="@drawable/ic_plus" />
    </LinearLayout>

    <!-- Zone des messages : la liste ET son calque d'état vivent
         ENSEMBLE ici — le calque couvre les messages, JAMAIS la saisie. -->
    <FrameLayout
        android:id="@+id/zone_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/liste_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_sm"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/ligne_message_assistant" />

        <!-- « Revenir en bas » (v0.196.0, retour propriétaire) : petit
             bouton flottant du bas, comme les clients de chat — visible
             SEULEMENT quand la conversation dépasse l'écran et que la
             lecture a remonté ; un appui recolle au bas et reprend le
             suivi du flux. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/bouton_revenir_bas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_sm"
            android:contentDescription="@string/ia_revenir_bas_cd"
            android:visibility="gone"
            app:backgroundTint="?attr/colorSurface"
            app:fabCustomSize="@dimen/touch_target_min"
            app:maxImageSize="@dimen/icon_size_sm"
            app:srcCompat="@drawable/ic_chevron_bas"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <!-- État transverse (v0.188.0 : DANS la zone des messages) :
             IA non activée (consentement), clé absente (S3 — bouton
             « Ajouter une clé » vers le fournisseur actif) ou
             conversation vide (accueil — la saisie reste LIBRE).
             Rapport IA, lot 3 — d'après la maquette : l'accueil vide
             porte les ACTIONS RAPIDES (Expliquer, Corriger, Tests,
             Documenter) — un appui PRÉREMPLIT la commande « / »
             correspondante (l'utilisateur garde la main : rien n'est
             envoyé sans lui). -->
        <LinearLayout
            android:id="@+id/etat_transverse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_smart_toy"
                app:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/etat_titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/etat_texte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_consentement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/ia_ia_inactive_bouton"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- S3 (rapport IA) : la clé du fournisseur actif manque —
                 la saisie est fermée, l'ajout de clé est à UN appui. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_ajouter_cle"
                style="@style/Widget.CodeIDE.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/ia_cle_absente_bouton"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Actions rapides de l'accueil vide (rapport IA, lot 3 —
                 d'après la maquette) : une commande « / » par geste —
                 l'appui PRÉREMPLIT la saisie, rien n'est envoyé sans
                 l'utilisateur. -->
            <LinearLayout
                android:id="@+id/rangee_actions_rapides"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_rapide_expliquer"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:minWidth="0dp"
                    android:text="@string/ia_commande_expliquer_libelle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_rapide_corriger"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:minWidth="0dp"
                    android:text="@string/ia_commande_corriger_libelle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_rapide_tests"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:minWidth="0dp"
                    android:text="@string/ia_commande_tests_libelle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_rapide_documenter"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/ia_commande_doc_libelle" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Rangée de puces de contexte (IA-4) : ce qui part EST ce qui
         est affiché — puce retirable (×), puce « @ Fichier » (sélec-
         teur), puce budget (jetons estimés). Masquée sans pièce. -->
    <HorizontalScrollView
        android:id="@+id/rangee_puces"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/conteneur_puces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs" />
    </HorizontalScrollView>

    <!-- Suggestions de COMMANDES « / » (rapport IA, lot 3 — d'après
         la maquette) : la frappe d'un « / » non encore tranché (aucun
         espace) suggère les commandes correspondantes — un appui
         complète la saisie. Vide ou commande tranchée : masquée. -->
    <HorizontalScrollView
        android:id="@+id/rangee_commandes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/conteneur_commandes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs" />
    </HorizontalScrollView>

    <!-- Compositeur (v0.188.0 : identifié `composeur_ia` — le calque
         d'état ne vit plus au-dessus, il ne peut plus le recouvrir ;
         sa VISIBILITÉ est un choix d'état du fragment, jamais un
         recouvrement). -->
    <LinearLayout
        android:id="@+id/composeur_ia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="1dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_xs">

        <com.google.android.material.textfield.TextInputLayout
            style="?attr/textInputOutlinedDenseStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ia_chat_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/saisie_ia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_envoyer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/ia_envoyer_cd"
            android:minWidth="88dp"
            android:text="@string/ia_envoyer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_arreter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/ia_arreter_cd"
            android:minWidth="88dp"
            android:text="@string/ia_arreter"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
