<?xml version="1.0" encoding="utf-8"?>
<!--
  Détail d'un fournisseur IA (mission IA, lot IA-2 — spec E4) : URL de
  base (HTTPS, boucle locale acceptée), clé d'API MASQUÉE (aperçu
  « ••••1234 » — jamais affichée, jamais dans un état, ADR 0124 §1),
  test de connexion (ping), remplacement/suppression de clé, sélection
  du fournisseur actif. Le titre est porté par le fragment (nom du
  fournisseur en argument de navigation).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_fournisseur_ia"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/ia_retour_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ia_fournisseur_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Carte « Connexion » : URL de base + clé masquée + test. -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/saisie_url_fournisseur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ia_url_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/champ_url_fournisseur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/etat_cle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Clé enregistrée ••••1234" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:hint="@string/ia_cle_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/champ_cle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/ia_cle_cd"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_enregistrer_cle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/ia_bouton_enregistrer_cle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_supprimer_cle"
                            style="@style/Widget.CodeIDE.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/ia_bouton_supprimer_cle"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_tester_connexion"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/ia_bouton_tester" />

                    <ProgressBar
                        android:id="@+id/progression_test"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:visibility="gone" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/resultat_test"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="Échec : clé refusée"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sélection : « Utiliser ce fournisseur » (le routeur IA ne
                 parle qu'au fournisseur actif). -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/etat_actif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Fournisseur actif" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_utiliser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ia_bouton_utiliser" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
