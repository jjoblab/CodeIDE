<?xml version="1.0" encoding="utf-8"?>
<!--
  Consentement IA (mission IA, lot IA-2 — spec E5, ADR 0121 point 3) :
  affiché au premier usage et depuis les Réglages IA. « Ce qui peut être
  envoyé » / « Jamais envoyé », boutons Activer / Pas maintenant —
  PAS de case « ne plus afficher » : la révocation vit dans les Réglages
  (interrupteur maître). Activer positionne assistantActive +
  consentementDonne + date (garde du routeur IA).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_consentement_ia"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/ia_retour_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ia_consentement_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_sm"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:contentDescription="@string/ia_consentement_titre"
                        android:src="@drawable/ic_bouclier"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/ia_consentement_intro"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/ia_consentement_envoye_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ia_consentement_envoye_1"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_consentement_envoye_2"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_consentement_envoye_3"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_consentement_envoye_4"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/ia_consentement_jamais_titre"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/ia_consentement_jamais_1"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_consentement_jamais_2"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ia_consentement_jamais_3"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_pas_maintenant"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ia_consentement_pas_maintenant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_activer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/ia_consentement_activer" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
