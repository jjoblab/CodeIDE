<?xml version="1.0" encoding="utf-8"?>
<!-- Un fichier de la revue (spec E2) : case à cocher (hors conflit),
     chemin, type, badge Conflit si divergence depuis la proposition. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_sm">

    <CheckBox
        android:id="@+id/case_retenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/chemin_fichier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/type_fichier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/badge_conflit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="?attr/colorErrorContainer"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="2dp"
        android:text="@string/agent_revue_conflit"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnErrorContainer"
        android:visibility="gone" />
</LinearLayout>
