<?xml version="1.0" encoding="utf-8"?>
<!--
  Section Notifications — section dédiée des Paramètres (ADR 0059) : sa propre
  toolbar (flèche retour + titre), le même SettingsViewModel que le
  maître — seule la présentation change.
  Lot UI-3 (audit C6, ADR 0127) : rangées `RangeeParametre`, carte
  `Widget.CodeIDE.Card`, filet porté par le conteneur.
-->
<!-- Fond opaque volontaire sur la racine (retour utilisateur v0.35) :
     garantit qu'aucun écran sous-jacent ne transparaît ; le double-peint
     avec windowBackground est assumé (une surface plein écran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_notifications_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CodeIDE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginVertical="@dimen/spacing_sm"
            app:contentPadding="@dimen/spacing_md">

            <!-- La carte est un FrameLayout : ses rangées s'empilent dans ce
                 conteneur vertical unique (régression corrigée v0.35.4, ADR 0064) ;
                 le filet entre rangées lui appartient (ADR 0127 §3). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/separateur_rangee"
                android:orientation="vertical"
                android:showDividers="middle">

                <jo.codeide.core.ui.RangeeParametre
                    android:id="@+id/rangee_notif_sync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rangeeIcone="@drawable/ic_synchronisation"
                    app:rangeeSousTitre="@string/settings_notif_sync_sous"
                    app:rangeeTitre="@string/settings_notif_sync"
                    app:rangeeType="interrupteur" />

                <jo.codeide.core.ui.RangeeParametre
                    android:id="@+id/rangee_notif_build"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rangeeIcone="@drawable/ic_outils"
                    app:rangeeSousTitre="@string/settings_notif_build_sous"
                    app:rangeeTitre="@string/settings_notif_build"
                    app:rangeeType="interrupteur" />

                <jo.codeide.core.ui.RangeeParametre
                    android:id="@+id/rangee_notif_son"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rangeeIcone="@drawable/ic_volume"
                    app:rangeeTitre="@string/settings_notif_son"
                    app:rangeeType="interrupteur" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</LinearLayout>
