<?xml version="1.0" encoding="utf-8"?>
<!--
  Section Historique — section dédiée des Paramètres (ADR 0059) : sa propre
  toolbar (flèche retour + titre), le même SettingsViewModel que le
  maître — seule la présentation change.
  Lot UI-3 (audit C6, ADR 0127) : rangées `RangeeParametre` (valeur ou
  lecture seule), cartes `Widget.CodeIDE.Card` ; pas de filet — chaque
  carte ne porte qu'une rangée et ses notes d'action composites.
-->
<!-- Fond opaque volontaire sur la racine (retour utilisateur v0.35) :
     garantit qu'aucun écran sous-jacent ne transparaît ; le double-peint
     avec windowBackground est assumé (une surface plein écran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_historique_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============= Carte Rétention ============= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                app:contentPadding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Rangée de rétention : dialogue à choix unique, la
                         valeur courante pré-cochée (patron licence). -->
                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_retention"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_historique"
                        app:rangeeTitre="@string/settings_historique_retention"
                        app:rangeeType="valeur" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/settings_historique_retention_detail"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============= Carte Entretien ============= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPadding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Empreinte au stockage : mesurée hors fil principal
                         (null : « … » le temps du retour). -->
                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_empreinte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_enregistrer"
                        app:rangeeType="aucun" />

                    <!-- Effacement total : confirmé AVANT l'action (dialogue),
                         tous projets — jamais silencieux. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_effacer_historique"
                        style="@style/Widget.CodeIDE.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/settings_historique_effacer" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_retour_historique"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/settings_historique_efface"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/settings_historique_effacer_detail"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
