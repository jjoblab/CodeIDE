<?xml version="1.0" encoding="utf-8"?>
<!-- Écran Environnement des Paramètres (E5, § 7, ADR 0089) : composants
     (versions, tailles, état vérifié), actions Vérifier (légère /
     approfondie), Réparer, Désinstaller (confirmation), diagnostic.
     Lot UI-3 (audit C1/C3/C4, ADR 0127) : espacements aux jetons de
     l'échelle, carte Widget.CodeIDE.Card, boutons Widget.CodeIDE.Button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <com.google.android.material.textview.MaterialTextView
                style="?attr/textAppearanceHeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/environnement_titre" />

            <com.google.android.material.textview.MaterialTextView
                style="?attr/textAppearanceBodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/environnement_sous_titre" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md_compact">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/liste_composants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/journal_environnement"
        style="?attr/textAppearanceBodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="6"
        android:paddingHorizontal="@dimen/spacing_md"
        android:textIsSelectable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md_compact">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_verifier"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/environnement_verifier" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_verifier_profond"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/environnement_verifier_profond" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_reparer"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/environnement_reparer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_diagnostic"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/environnement_diagnostic" />
    </LinearLayout>
</LinearLayout>
