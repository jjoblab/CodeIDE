<?xml version="1.0" encoding="utf-8"?>
<!--
  Section Apparence — section dédiée des Paramètres (ADR 0059) : sa propre
  toolbar (flèche retour + titre), le même SettingsViewModel que le
  maître — seule la présentation change.
-->
<!-- Fond opaque volontaire sur la racine (retour utilisateur v0.35) :
     garantit qu'aucun écran sous-jacent ne transparaît ; le double-peint
     avec windowBackground est assumé (une surface plein écran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_apparence_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginVertical="@dimen/spacing_sm"
            app:cardBackgroundColor="?attr/colorSurface"
            app:contentPadding="@dimen/spacing_md"
            app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <!-- La carte est un FrameLayout : ses rangées s'empilent dans ce
                 conteneur vertical unique (régression corrigée v0.35.4, ADR 0064). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_xs">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_contraste"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:text="@string/settings_theme_libelle"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupe_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_theme_1"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_theme_systeme" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_theme_2"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_theme_clair" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_theme_3"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_theme_sombre" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/spacing_sm"
                    android:background="?attr/colorOutlineVariant" />
                <LinearLayout
                    android:id="@+id/couleurs_dynamiques"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_auto_awesome"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_couleurs_dynamiques"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_couleurs_dynamiques_sous"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/interrupteur_couleurs_dynamiques"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/apercu_palette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="?attr/colorSurfaceVariant"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <View
                        android:id="@+id/pastille_primaire"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/pastille_palette_primaire"
                        android:backgroundTint="?attr/colorPrimary" />

                    <View
                        android:id="@+id/pastille_secondaire"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/pastille_palette_secondaire"
                        android:backgroundTint="?attr/colorSecondary" />

                    <View
                        android:id="@+id/pastille_tertiaire"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/pastille_palette_tertiaire"
                        android:backgroundTint="?attr/colorTertiary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:text="@string/settings_palette_legende"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/spacing_sm"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Palette statique (ADR 0060) : une rangée par palette, trois
                     pastilles (primaire / conteneur primaire / tertiaire) et un
                     bouton radio — le conteneur est gonflé programmatiquement par
                     ApparenceFragment (les couleurs des pastilles sont propres à
                     chaque palette, les attrs de thème ne peuvent pas les porter
                     toutes à la fois). -->
                <LinearLayout
                    android:id="@+id/rangees_palette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/texte_palette_dynamique"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/settings_palette_indisponible_dynamiques"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</LinearLayout>
