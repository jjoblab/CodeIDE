<?xml version="1.0" encoding="utf-8"?>
<!--
  Section Projets — section dédiée des Paramètres (ADR 0059) : sa propre
  toolbar (flèche retour + titre), le même SettingsViewModel que le
  maître — seule la présentation change.
  Lot UI-3 (audit C6, ADR 0127) : rangées `RangeeParametre`, carte
  `Widget.CodeIDE.Card`, filet au conteneur ; le champ auteur
  (TextInputLayout) et les boutons d'action restent des composites.
-->
<!-- Fond opaque volontaire sur la racine (retour utilisateur v0.35) :
     garantit qu'aucun écran sous-jacent ne transparaît ; le double-peint
     avec windowBackground est assumé (une surface plein écran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_projets_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CodeIDE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginVertical="@dimen/spacing_sm"
            app:contentPadding="@dimen/spacing_md">

            <!-- La carte est un FrameLayout : ses rangées s'empilent dans ce
                 conteneur vertical unique (régression corrigée v0.35.4, ADR 0064) ;
                 le filet entre blocs lui appartient (ADR 0127 §3). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/separateur_rangee"
                android:orientation="vertical"
                android:showDividers="middle">

                <jo.codeide.core.ui.RangeeParametre
                    android:id="@+id/rangee_dossier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rangeeIcone="@drawable/ic_dossier"
                    app:rangeeTitre="@string/settings_dossier_travail"
                    app:rangeeType="aucun" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_xs">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_changer_dossier"
                            style="@style/Widget.CodeIDE.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_dossier_changer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_effacer_dossier"
                            style="@style/Widget.CodeIDE.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/settings_dossier_effacer" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progression_dossier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_retour_dossier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:visibility="gone"
                        tools:text="Dossier changé." />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/champ_nom_auteur_conteneur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_nom_auteur"
                    app:startIconDrawable="@drawable/ic_personne">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/champ_nom_auteur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <jo.codeide.core.ui.RangeeParametre
                    android:id="@+id/rangee_licence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rangeeIcone="@drawable/ic_etiquette"
                    app:rangeeTitre="@string/settings_licence_defaut"
                    app:rangeeType="valeur" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</LinearLayout>
