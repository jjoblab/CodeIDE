<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran générique « bientôt disponible » (ADR 0059) : icône + titre +
  une phrase, pilotés par les arguments de navigation — le patron reste
  réutilisable pour toute future section sans retoucher le maître.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <ImageView
            android:id="@+id/icone_bientot"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_smart_toy"
            app:tint="?attr/colorOutline" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/titre_bientot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Assistant IA — bientôt disponible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_bientot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Cette section apparaîtra dans le menu dès que le module sera prêt." />
    </LinearLayout>
</LinearLayout>
