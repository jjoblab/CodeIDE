<?xml version="1.0" encoding="utf-8"?>
<!--
  Section Éditeur (v0.37.0) : les réglages deviennent **consommés** par
  cel-ui — chaque contrôle projette une API réelle de la bibliothèque
  (thème, zoom, word wrap, minimap, caractères non imprimables,
  ligatures, badges de diagnostic, sauvegarde automatique). Trois cartes
  à libellé de section, comme le maître des Paramètres (ADR 0059) :
  Apparence de l'éditeur / Affichage / Édition.

  Lot UI-3 (audit C6, ADR 0127) : plus AUCUNE rangée recopiée — chaque
  rangée vit dans `RangeeParametre` (core:ui), chaque carte porte
  `Widget.CodeIDE.Card` + `EnteteSection`, le filet entre rangées
  appartient au conteneur (divider/showDividers), jamais recopié.
-->
<!-- Fond opaque volontaire sur la racine (retour utilisateur v0.35) :
     garantit qu'aucun écran sous-jacent ne transparaît ; le double-peint
     avec windowBackground est assumé (une surface plein écran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_editeur_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Carte « Apparence de l'éditeur » : thème de coloration,
                 taille de police, ligatures. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:contentPadding="@dimen/spacing_sm">

                <!-- La carte est un FrameLayout : ses rangées s'empilent dans ce
                     conteneur vertical unique (régression corrigée v0.35.4, ADR 0064) ;
                     le filet entre enfants lui appartient (ADR 0127 §3). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/separateur_rangee"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/EnteteSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_editeur_apparence" />

                    <!-- Thème de coloration : rangée à choix, ouvre le
                         sélecteur (choix unique) — la valeur courante
                         s'affiche à droite, comme la licence par défaut. -->
                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_theme_editeur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_contraste"
                        app:rangeeTitre="@string/settings_theme_editeur"
                        app:rangeeType="valeur" />

                    <!-- Taille de police : en-tête de groupe + trio de boutons
                         (miroir du terminal). -->
                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_police_editeur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_taille_police"
                        app:rangeeTitre="@string/settings_taille_police"
                        app:rangeeType="aucun" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupe_police_editeur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_police_editeur_1"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_police_petite" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_police_editeur_2"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_police_moyenne" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_police_editeur_3"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_police_grande" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Ligatures : l'avertissement compte — activer coupe la
                         coloration syntaxique (compromis documenté de cel-ui). -->
                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_ligatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_ligatures"
                        app:rangeeSousTitre="@string/settings_ligatures_sous"
                        app:rangeeTitre="@string/settings_ligatures"
                        app:rangeeType="interrupteur" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Affichage » : retour à la ligne, minimap,
                 caractères non imprimables, badges de diagnostic. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:contentPadding="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/separateur_rangee"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/EnteteSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_editeur_affichage" />

                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_retour_ligne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_retour_ligne"
                        app:rangeeSousTitre="@string/settings_retour_ligne_sous"
                        app:rangeeTitre="@string/settings_retour_ligne"
                        app:rangeeType="interrupteur" />

                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_minimap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_minimap"
                        app:rangeeSousTitre="@string/settings_minimap_sous"
                        app:rangeeTitre="@string/settings_minimap"
                        app:rangeeType="interrupteur" />

                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_caracteres_non_imprimables"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_non_imprimables"
                        app:rangeeSousTitre="@string/settings_caracteres_non_imprimables_sous"
                        app:rangeeTitre="@string/settings_caracteres_non_imprimables"
                        app:rangeeType="interrupteur" />

                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_chips_diagnostics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_legende"
                        app:rangeeSousTitre="@string/settings_chips_diagnostics_sous"
                        app:rangeeTitre="@string/settings_chips_diagnostics"
                        app:rangeeType="interrupteur" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Édition » : sauvegarde automatique. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:contentPadding="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/separateur_rangee"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/EnteteSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_editeur_edition" />

                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_sauvegarde_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_enregistrer"
                        app:rangeeSousTitre="@string/settings_sauvegarde_auto_sous"
                        app:rangeeTitre="@string/settings_sauvegarde_auto"
                        app:rangeeType="interrupteur" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
