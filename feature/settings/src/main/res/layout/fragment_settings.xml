<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran maître des Paramètres (ADR 0059) : cartes M3 groupées par
  domaine (Général, Modules, Environnement, Application), une rangée par
  section — chaque section s'ouvre dans son propre fragment. Lot UI-3
  (audit C6) : les rangées sont des RangeeParametre posés par
  SettingsFragment, le filet entre rangées vit au conteneur, les cartes
  portent Widget.CodeIDE.Card + EnteteSection (ADR 0127 §3).
-->
<!-- Fond opaque volontaire sur la racine (retour utilisateur v0.35) :
     garantit qu'aucun écran sous-jacent ne transparaît ; le double-peint
     avec windowBackground est assumé (une surface plein écran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_title" />

    <ScrollView
        android:id="@+id/defilement_parametres"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm">

            <!-- Carte « Général » : Apparence, Langue, Notifications. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carte_general"
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:contentPadding="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/EnteteSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_general" />

                    <LinearLayout
                        android:id="@+id/rangees_general"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/separateur_rangee"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Modules » : Éditeur, Terminal, IA (bientôt). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carte_modules"
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:contentPadding="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/EnteteSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_modules" />

                    <LinearLayout
                        android:id="@+id/rangees_modules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/separateur_rangee"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Environnement » : Projets, Outils de développement (bientôt). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carte_environnement"
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:contentPadding="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/EnteteSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_environnement" />

                    <LinearLayout
                        android:id="@+id/rangees_environnement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/separateur_rangee"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte « Application » : Sécurité (bientôt), À propos, Avancé. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carte_application"
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:contentPadding="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/EnteteSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_application" />

                    <LinearLayout
                        android:id="@+id/rangees_application"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/separateur_rangee"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
