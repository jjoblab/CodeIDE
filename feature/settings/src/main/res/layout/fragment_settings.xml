<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran Paramètres personnalisé Material 3 (étape 6 — pas de
  PreferenceFragmentCompat) : sections extensibles rendues par
  SettingsFragment. Chaque réglage se persiste à l'instant.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_title" />

    <ScrollView
        android:id="@+id/defilement_parametres"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm">

            <!-- ================= Apparence ================= -->

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/settings_section_apparence"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <RadioGroup
                android:id="@+id/groupe_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_theme_systeme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_systeme" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_theme_clair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_clair" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_theme_sombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_sombre" />
            </RadioGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interrupteur_dynamique"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/settings_couleurs_dynamiques" />

            <!-- ================= Langue ================= -->

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/settings_section_langue"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <RadioGroup
                android:id="@+id/groupe_langue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_langue_systeme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_langue_systeme" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_langue_fr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_langue_fr" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_langue_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_langue_en" />
            </RadioGroup>

            <!-- ================= Projets ================= -->

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/settings_section_projets"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/settings_dossier_travail"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/texte_dossier"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="CodeIDE" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_changer_dossier"
                    style="@style/Widget.CodeIDE.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_dossier_changer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_effacer_dossier"
                    style="@style/Widget.CodeIDE.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/settings_dossier_effacer" />
            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progression_dossier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xs"
                android:indeterminate="true"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_retour_dossier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone"
                tools:text="Dossier changé." />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/champ_nom_auteur_conteneur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:hint="@string/settings_nom_auteur">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/champ_nom_auteur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/settings_licence_defaut"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/valeur_licence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="MIT" />

            <!-- ================= À propos ================= -->

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/settings_section_a_propos"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/settings_a_propos_version_libelle"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="0.7.0 (700)" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/settings_a_propos_build_libelle"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="debug" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/valeur_licences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="@dimen/spacing_xs"
                android:text="@string/settings_licences"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- ================= Avancé ================= -->

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/settings_section_avance"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_diagnostic"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/settings_diagnostic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_reinitialiser"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="start|center_vertical"
                android:text="@string/settings_reinitialiser" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_relancer_assistant"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/settings_relancer_assistant" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
