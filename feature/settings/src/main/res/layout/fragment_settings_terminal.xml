<?xml version="1.0" encoding="utf-8"?>
<!--
  Section Terminal — section dédiée des Paramètres (ADR 0059) : sa propre
  toolbar (flèche retour + titre), le même SettingsViewModel que le
  maître — seule la présentation change.
  Lot UI-3 (audit C6, ADR 0127) : en-têtes `RangeeParametre` (aucun),
  rangée interrupteur `RangeeParametre`, carte `Widget.CodeIDE.Card`,
  filet entre blocs au conteneur.
-->
<!-- Fond opaque volontaire sur la racine (retour utilisateur v0.35) :
     garantit qu'aucun écran sous-jacent ne transparaît ; le double-peint
     avec windowBackground est assumé (une surface plein écran). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/settings_back_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_terminal_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CodeIDE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginVertical="@dimen/spacing_sm"
            app:contentPadding="@dimen/spacing_md">

            <!-- La carte est un FrameLayout : ses blocs s'empilent dans ce
                 conteneur vertical unique (régression corrigée v0.35.4, ADR 0064) ;
                 le filet entre blocs lui appartient (ADR 0127 §3). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/separateur_rangee"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_xs">

                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_police_terminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_taille_police"
                        app:rangeeTitre="@string/settings_taille_police"
                        app:rangeeType="aucun" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupe_police_terminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_police_terminal_1"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_police_petite" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_police_terminal_2"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_police_moyenne" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_police_terminal_3"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_police_grande" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_xs">

                    <jo.codeide.core.ui.RangeeParametre
                        android:id="@+id/rangee_curseur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rangeeIcone="@drawable/ic_curseur"
                        app:rangeeTitre="@string/settings_style_curseur"
                        app:rangeeType="aucun" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupe_curseur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_curseur_1"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_curseur_bloc" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_curseur_2"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_curseur_ligne" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_curseur_3"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_curseur_barre" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <jo.codeide.core.ui.RangeeParametre
                    android:id="@+id/rangee_copie_selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rangeeIcone="@drawable/ic_copie"
                    app:rangeeTitre="@string/settings_copie_selection"
                    app:rangeeType="interrupteur" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</LinearLayout>
