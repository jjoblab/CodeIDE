<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton de mode d'affichage de l'entête (liste / splits) : état
     sélectionné = surface 3 + bordure, comme .bt-entete de la maquette. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/codeide_explorateur_poignee_fond_actif" />
            <stroke android:width="1dp" android:color="@color/codeide_explorateur_poignee_bordure" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
