<?xml version="1.0" encoding="utf-8"?>
<!--
  Fragment Terminal du tiroir (v0.32.2, ADR 0053) : entête à la maquette
  (emblème violet, titre, sous-titre « N sessions actives · termux »,
  ligne d'actions : nouvelle session + modes liste / split vertical /
  split colonnes), corps à deux zones — la liste de cartes de sessions
  (chemin · heure, badge d'état, boutons « agrandir dans le tiroir » et
  « plein écran ») et le conteneur des panneaux de rendu (TerminalView
  par session) — et clavier étendu partagé au-dessus du rail.
  Vit dans feature:terminal : seul feature autorisé à dépendre du
  runtime des sessions.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ============ Entête du fragment (maquette § 4) ============ -->
    <LinearLayout
        android:id="@+id/entete_terminal_tiroir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_entete_terminal_tiroir"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp">

        <!-- Ligne de titre : emblème 32 dp + titre + sous-titre sessions. -->
        <LinearLayout android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/fond_embleme_terminal_violet">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_terminal"
                    app:tint="@color/codeide_explorateur_violet" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/terminal_title"
                    android:textColor="@color/codeide_explorateur_texte"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/sous_titre_terminal_tiroir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:textColor="@color/codeide_explorateur_sous_titre_entete"
                    android:textSize="10.5sp" tools:ignore="SmallSp"
                    tools:text="2 sessions actives · termux" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ligne d'actions : nouvelle session (violet) + modes
             d'affichage (liste, split vertical, split colonnes) —
             boutons 32 dp, même gabarit que l'explorateur. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bouton_nouvelle_session_tiroir"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tiroir_terminal_nouvelle_session_cd"
                android:padding="7dp"
                android:src="@drawable/ic_nouvelle_session"
                app:tint="@color/codeide_explorateur_violet" />

            <ImageView
                android:id="@+id/bouton_mode_liste"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/fond_bouton_mode_terminal"
                android:contentDescription="@string/tiroir_terminal_mode_liste_cd"
                android:padding="7dp"
                android:src="@drawable/ic_vue_liste"
                app:tint="@color/codeide_explorateur_texte_2" />

            <ImageView
                android:id="@+id/bouton_mode_split_vertical"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/fond_bouton_mode_terminal"
                android:contentDescription="@string/tiroir_terminal_split_vertical_cd"
                android:padding="7dp"
                android:src="@drawable/ic_split_vertical"
                app:tint="@color/codeide_explorateur_texte_2" />

            <ImageView
                android:id="@+id/bouton_mode_split_colonnes"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/fond_bouton_mode_terminal"
                android:contentDescription="@string/tiroir_terminal_split_colonnes_cd"
                android:padding="7dp"
                android:src="@drawable/ic_split_colonnes"
                app:tint="@color/codeide_explorateur_texte_2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/hint_split_indisponible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/tiroir_terminal_split_indisponible"
                android:textColor="@color/codeide_explorateur_texte_3"
                android:textSize="9.5sp" tools:ignore="SmallSp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Corps : liste de cartes OU panneaux de rendu ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Zone liste (mode Liste) : cartes de sessions gonflées au
             rendu + états vides (aucune session / non installé). -->
        <ScrollView
            android:id="@+id/zone_liste_sessions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <LinearLayout
                    android:id="@+id/liste_sessions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:layout_height="120dp" />

                <!-- État vide : aucune session — création directe. -->
                <LinearLayout
                    android:id="@+id/bloc_aucune_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/tiroir_terminal_aucune_session"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/codeide_explorateur_texte_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_creer_session_tiroir"
                        style="@style/Widget.CodeIDE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:minWidth="@dimen/touch_target_min"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/tiroir_terminal_nouvelle_session" />
                </LinearLayout>

                <!-- Bootstrap absent : l'installation d'abord (garde-fou). -->
                <LinearLayout
                    android:id="@+id/bloc_non_installe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/tiroir_terminal_non_installe"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/codeide_explorateur_texte_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_installer_terminal_tiroir"
                        style="@style/Widget.CodeIDE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:minWidth="@dimen/touch_target_min"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/tiroir_terminal_installer" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Zone split (modes SplitVertical / SplitColonnes /
             PleinEcranDansTiroir) : un panneau par session affichée,
             orientation posée au rendu. -->
        <LinearLayout
            android:id="@+id/conteneur_split"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_sm"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Clavier étendu partagé (visible dès qu'un panneau de rendu
         l'est) : Tab/Ctrl/Alt/Échap/flèches — la séquence part vers la
         session du panneau FOCALISÉ. -->
    <jo.codeide.feature.terminal.ClavierEtenduView
        android:id="@+id/clavier_etendu_tiroir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
