<?xml version="1.0" encoding="utf-8"?>
<!--
  Snackbar maison de l'explorateur (étape 31, § 15, EXPLORATEUR_V2) :
  centré au-dessus du rail du tiroir, fond et bordure dédiés, rayon 12,
  message 12,5 sp + chemin en seconde ligne mono 10,5 sp, action unique
  (« Annuler ») à droite. Masquage automatique après 4 600 ms (posé par
  le fragment).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_snackbar_arbre"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_snackbar_arbre"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_snackbar_arbre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/codeide_explorateur_texte"
            android:textSize="12.5sp"
            tools:text="Créé — TestClass.kt" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/chemin_snackbar_arbre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/codeide_explorateur_texte_3"
            android:textSize="10.5sp" tools:ignore="SmallSp"
            android:visibility="gone"
            tools:text="feature/editor/src/main/kotlin"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/action_snackbar_arbre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="@string/notif_annuler"
        android:textColor="@color/codeide_explorateur_accent"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
