<?xml version="1.0" encoding="utf-8"?>
<!--
  Snackbar maison de l'explorateur (étape 31, § 15, EXPLORATEUR_V2) :
  centré au-dessus du rail du tiroir, fond et bordure dédiés, rayon 12,
  message 12 sp (LabelMedium — table §4 ADR 0127) + chemin en seconde
  ligne mono Micro, action unique (« Annuler ») à droite. Masquage
  automatique après 4 600 ms (posé par le fragment).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_snackbar_arbre"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_snackbar_arbre"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_snackbar_arbre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            tools:text="Créé — TestClass.kt" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/chemin_snackbar_arbre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.CodeIDE.Micro"
            android:visibility="gone"
            tools:text="feature/editor/src/main/kotlin"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/action_snackbar_arbre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_xs"
        android:text="@string/notif_annuler"
        android:textColor="?attr/colorPrimary"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
