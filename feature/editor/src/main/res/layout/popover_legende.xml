<?xml version="1.0" encoding="utf-8"?>
<!--
  Popover « Légende » (étape 31, § 10.5) : sections Points d'état (les
  quatre états du § 7 avec pastilles dessinées) et Notation (chevron,
  trait parent → enfant, rappel de l'appui long).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="258dp"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/fleche_popover"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/fond_fleche_popover"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/coque_popover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_popover"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md_compact">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/legende_titre"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold" />

        <!-- Affichage (v0.80.1) : les trois bascules de l'explorateur,
             enfin câblées — compactage, fichiers cachés, dossiers de
             build (.gradle et app/build visibles par défaut). Le popover
             reste ouvert : l'utilisateur peut enchaîner les bascules. -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/legende_affichage"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.CodeIDE.Micro" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/case_affichage_compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:minHeight="34dp"
            android:text="@string/legende_compact"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/case_masquer_fichiers_caches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:text="@string/legende_masquer_caches"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/case_masquer_dossiers_build"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:text="@string/legende_masquer_build"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/legende_points_etat"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.CodeIDE.Micro"
            android:textAllCaps="true" />

        <!-- Pastilles : vues VuePointEtat réutilisées à l'état figé. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <jo.codeide.feature.editor.VuePointEtat
                android:id="@+id/legende_point_defaut"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/legende_point_defaut"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelSmall" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <jo.codeide.feature.editor.VuePointEtat
                android:id="@+id/legende_point_ouvert"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/legende_point_ouvert"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelSmall" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <jo.codeide.feature.editor.VuePointEtat
                android:id="@+id/legende_point_actif"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/legende_point_actif"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelSmall" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <jo.codeide.feature.editor.VuePointEtat
                android:id="@+id/legende_point_selectionne"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/legende_point_selectionne"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelSmall" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md_compact"
            android:text="@string/legende_notation"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.CodeIDE.Micro" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/legende_ligne_dossier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/legende_notation_dossier"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/legende_ligne_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/legende_notation_guide"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/legende_ligne_astuce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/legende_notation_astuce"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>
</FrameLayout>
