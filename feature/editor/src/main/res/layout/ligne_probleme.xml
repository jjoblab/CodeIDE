<?xml version="1.0" encoding="utf-8"?>
<!-- Un diagnostic de l'onglet Problèmes (G5) : pastille, message, ligne. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_ligne"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_sm"
    android:paddingVertical="@dimen/spacing_xs"
    tools:ignore="HardcodedText">

    <ImageView
        android:id="@+id/point_probleme"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        tools:src="@drawable/point_probleme_erreur" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/message_probleme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="';' expected" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/position_probleme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="5" />

    <!-- « Corriger avec l'IA » (mission IA, lot IA-5, spec E3) : ouvre
         le chat pré-rempli avec ce diagnostic — action de ligne. -->
    <ImageButton
        android:id="@+id/bouton_corriger_ia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ia_corriger_ia_cd"
        android:minWidth="@dimen/touch_target_min"
        android:minHeight="@dimen/touch_target_min"
        android:src="@drawable/ic_auto_awesome"
        app:tint="?attr/colorPrimary" />
</LinearLayout>
