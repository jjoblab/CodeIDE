<?xml version="1.0" encoding="utf-8"?>
<!--
  Barre de l'histogramme « ce qui a coûté le plus de temps » du panneau
  de détail d'indexation (maquette §4 — v0.178.0, ADR 0145) : libellé de
  l'indexeur + durée, barre horizontale de largeur RELATIVE au plus
  coûteux (fraction portée par le modèle, appliquée par le code).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/libelle_cout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Noms de classes Java" />

        <TextView
            android:id="@+id/duree_cout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="1,8 s" />
    </LinearLayout>

    <!-- La fraction est appliquée par le code (setProgress) — couleur
         d'indicateur par token, aucune valeur en dur. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barre_cout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant"
        app:trackThickness="8dp" />
</LinearLayout>
