<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne d'une dépendance déclarée (P3, ADR 0095) :
     coordonnées (groupe:nom:version) + configuration + script d'origine. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_md_compact"
    android:paddingVertical="@dimen/spacing_sm">

    <ImageView
        android:id="@+id/icone_dependance"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_fichier_gradle"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/coordonnees_dependance"
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:ignore="HardcodedText"
            tools:text="org.jetbrains.kotlin:kotlin-stdlib:2.2.10" />

        <TextView
            android:id="@+id/configuration_dependance"
            style="?attr/textAppearanceLabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            tools:ignore="HardcodedText"
            tools:text="implementation — build.gradle.kts" />
    </LinearLayout>

</LinearLayout>
