<?xml version="1.0" encoding="utf-8"?>
<!-- Section Recherche du tiroir (mission Recherche S2-S5, ADR 0094) :
     champ de recherche avec bascules, remplacement, navigation, Go to File. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Entête : emblème orange + mode + actions. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_entete_explorateur"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_recherche"
            app:tint="?attr/colorPrimary" />

        <TextView
            style="?attr/textAppearanceTitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/recherche_titre" />

        <!-- S5 : bascule Texte | Fichiers. -->
        <TextView
            android:id="@+id/bascule_mode_fichiers"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recherche_mode_fichiers_cd"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/recherche_mode_fichiers"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/bouton_effacer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recherche_effacer_cd"
            android:padding="6dp"
            android:src="@drawable/ic_fermer_onglet"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Champ de recherche + bascules. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/champ_recherche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="search"
            android:background="@drawable/fond_champ_inline"
            android:hint="@string/recherche_hint"
            android:inputType="text"
            android:padding="8dp"
            android:textSize="13sp" />

        <!-- S4 : champ de remplacement (masqué par défaut). -->
        <LinearLayout
            android:id="@+id/zone_remplacement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/champ_remplacement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="text"
                android:background="@drawable/fond_champ_inline"
                android:hint="@string/recherche_remplacement_hint"
                android:inputType="text"
                android:padding="8dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/bouton_tout_remplacer"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/recherche_tout_remplacer"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bascule_casse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/recherche_bascule_casse_cd"
                android:gravity="center"
                android:text="@string/recherche_bascule_casse"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bascule_mot_entier"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/recherche_bascule_mot_entier_cd"
                android:gravity="center"
                android:text="@string/recherche_bascule_mot_entier"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bascule_regex"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/recherche_bascule_regex_cd"
                android:gravity="center"
                android:text="@string/recherche_bascule_regex"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- S4 : bouton remplacement. -->
            <TextView
                android:id="@+id/bouton_remplacer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/recherche_remplacer_cd"
                android:gravity="center"
                android:text="@string/recherche_remplacer_label"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chargement. -->
    <ProgressBar
        android:id="@+id/chargement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Résumé + navigation S3. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/resume"
            style="?attr/textAppearanceLabelSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- S3 : navigation précédent/suivant. -->
        <ImageView
            android:id="@+id/bouton_precedent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recherche_precedent_cd"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_noeud"
            android:rotation="270"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/bouton_suivant"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recherche_suivant_cd"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_noeud"
            android:rotation="90"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Liste des résultats (texte simple pour la v1). -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/liste_resultats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textSize="11sp"
            android:visibility="gone" />
    </ScrollView>

    <!-- État vide. -->
    <LinearLayout
        android:id="@+id/zone_vide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recherche_aucun_resultat"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Plafond atteint. -->
    <TextView
        android:id="@+id/plafoid_atteint"
        style="?attr/textAppearanceLabelSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/recherche_plafond"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <!-- Erreur. -->
    <TextView
        android:id="@+id/erreur"
        style="?attr/textAppearanceBodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="?attr/colorError"
        android:visibility="gone" />
</LinearLayout>
