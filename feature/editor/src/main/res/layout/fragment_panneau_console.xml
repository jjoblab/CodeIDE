<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Sortie du panneau inférieur (G5 §6, v0.32.4 ADR 0055 ; v4 §3.3
     étape 5 ; v5 — aperçu ; v0.40.1 : UN SEUL chip d'action reflète
     l'action Gradle courante, NON cliquable ; v0.46.0 — REFONTE TOTALE
     (ADR 0078) : CONSOLE FLUX BRUT UNIQUE — un TextView monospace PAR
     CANAL (Sync / Build), le flux stdout/stderr de Gradle reconstitué
     comme la fenêtre Build d'Android Studio. Plus de RecyclerView, plus
     de rangées structurées : le chip choisit la console VISIBLE, l'autre
     s'accumule en coulisses. Boutons Tâches et Configuration inchangés. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenu de la console (masqué quand la configuration s'affiche). -->
    <LinearLayout
        android:id="@+id/contenu_console"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Barre d'outils (§3.3 ; v0.40.1 §3) : chip d'action UNIQUE +
         boutons Tâches / Configuration / Annuler à droite. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="@dimen/spacing_xs">

        <!-- Chip d'action unique (v0.40.1, prompt de suivi §3) : reflète
             l'action Gradle courante (Sync / Build / Tâches / Classpaths…).
             NON cliquable — pas de bascule utilisateur. La console montre
             toujours l'action courante (ou la dernière exécutée).
             Aucun chip s'il n'y a eu aucune action. Couleur de canal
             harmonisée via chipBackgroundColor + chipStrokeColor au
             rendu. -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_action_courante"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:text="@string/editor_tooling_canal_sync"
            android:visibility="gone"
            app:chipBackgroundColor="?attr/colorSurfaceVariant"
            app:chipStrokeWidth="1dp"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tâches : actif dès que la sync a rempli le cache (aucun
             aller-retour) ; l'info-bulle + le contentDescription disent
             POURQUOI il est éteint avant la sync. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_taches_sortie"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_console_taches_indisponible"
            android:enabled="false"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/editor_tooling_canal_taches"
            android:tooltipText="@string/editor_console_taches_indisponible"
            app:icon="@drawable/ic_liste_taches" />

        <!-- Configuration (§3.3) : accès LIBELLÉ depuis la barre d'outils —
             la page s'affiche DANS le conteneur de la console, plus de
             dialogue plein écran au-dessus de l'éditeur. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_config_tooling"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_config_tooling_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/editor_config_tooling_libelle"
            app:icon="@drawable/ic_outils" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_annuler_build"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_sortie_annuler_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:visibility="gone"
            app:icon="@drawable/ic_arreter_build"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Canal du statut (v0.32.5) : l'icône signature de la provenance
         (Sync teal / Build bleu) — l'information affichée ici porte
         TOUJOURS son canal, comme chaque ligne et chaque entrée d'en-tête. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="@dimen/spacing_xs">

        <ImageView
            android:id="@+id/icone_canal_sortie"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_executer" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/statut_sortie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingBottom="@dimen/spacing_xs"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Build en cours" />
    </LinearLayout>

    <!-- Bandeau d'échec du build (§3.3) : message + actions « Voir les
         problèmes » (onglet Problèmes) et « Réessayer » (relance les
         mêmes tâches) — plus d'échec muet. -->
    <LinearLayout
        android:id="@+id/bandeau_echec_build"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:background="@drawable/fond_bandeau_echec"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icone_echec_build"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_avertissement"
                app:tint="?attr/colorOnErrorContainer" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/message_echec_build"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer"
                tools:text="Échec du build — tâche compileDebugKotlin échouée" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_voir_problemes"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/editor_console_echec_voir_problemes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_reessayer_build"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/editor_console_echec_reessayer" />
        </LinearLayout>
    </LinearLayout>

    <!-- Corps de la console (v0.46.0, ADR 0078 — console FLUX BRUT
         UNIQUE) : DEUX consoles monospace, UNE PAR CANAL — Sync (étapes
         de la synchronisation, conclusion) et Build (flux stdout/stderr
         de Gradle : lignes « > Task », diagnostics, « BUILD SUCCESSFUL »,
         plus les statuts de l'orchestrateur et les téléchargements). Le
         chip d'action rend l'une VISIBLE, l'autre continue de
         s'accumuler en coulisses (GONE : aucun layout). L'état vide
         recouvre le corps (centré). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Console du canal SYNC : étapes (une ligne par transition,
             « Libellé… » puis « Libellé ✓ durée ») + conclusion. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/defilement_console_sync"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_console_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="Vérification des outils ✓ 120ms" />
        </androidx.core.widget.NestedScrollView>

        <!-- Console du canal BUILD : le flux brut de Gradle, ligne par
             ligne, append direct O(1) (le tampon est un Editable posé
             par le fragment, l'auto-défilement suit le bas pendant
             l'écoulement tant que l'utilisateur y est resté). -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/defilement_console_build"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_console_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="&gt; Task :app:compileDebugKotlin" />
        </androidx.core.widget.NestedScrollView>

        <!-- État vide de la console (la console du canal courant n'a
             encore rien écrit) — recouvre le corps, centré. -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_sortie_vide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/state_padding"
            android:text="@string/editor_sortie_vide"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

        <!-- v0.41.1 : champ de saisie stdin pour readln()/Scanner(System.in).
             Visible seulement pendant un build EN_COURS (le programme peut
             attendre une entrée). L'utilisateur tape, appuie sur Entrée,
             le texte est envoyé au serveur via BuildInput. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/champ_entree_console"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="@dimen/spacing_xs"
            android:hint="@string/editor_console_entree_hint"
            android:visibility="gone"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_executer"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_entree_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Page de configuration (v4, §3.3) : vit DANS le conteneur de la
         console (fragment enfant), flèche retour en tête — remplacé le
         dialogue plein écran. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/conteneur_config_tooling"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
