<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Sortie du panneau inférieur (G5 §6, v0.32.4 ADR 0055 ; v4 §3.3
     étape 5 ; v5 — aperçu ; v0.40.1 : UN SEUL chip d'action reflète
     l'action Gradle courante, NON cliquable ; L5b — spec SORTIES § 5.7 :
     PANNEAU COMPACT REBRANCHÉ — il n'embarque PLUS de moteur à lui : le
     corps est le LECTEUR du Centre de sorties (fenêtre sur le MÊME
     composant, fragment enfant). Le chip choisit le canal dont le FILTRE
     est poussé au lecteur ; recherche, pause, effacement et consultation
     vivent DANS le lecteur. Boutons Tâches / Configuration / Annuler,
     stdin et bandeau d'échec inchangés. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenu de la console (masqué quand la configuration s'affiche). -->
    <LinearLayout
        android:id="@+id/contenu_console"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Barre d'outils (§3.3 ; v0.40.1 §3) : chip d'action UNIQUE +
         boutons Tâches / Configuration / Annuler à droite. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md_compact"
        android:paddingVertical="@dimen/spacing_xs">

        <!-- Sélecteur de canal (INC-20, volet C du prompt « retard
             d'affichage des sorties de build » §6.3) : SEGMENTÉ Sync |
             Build, CLIQUABLE — la sélection manuelle persiste jusqu'à la
             prochaine action Gradle (qui sélectionne automatiquement son
             canal). Point d'actualité sur le canal non affiché qui a du
             neuf (activité en vol) ou un échec. Aucun sélecteur s'il n'y
             a eu aucune action (état vierge). Couleurs de canal posées au
             rendu (harmonisées), comme l'ancien chip unique v0.40.1. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupe_canaux_console"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_console_selecteur_canal_cd"
            android:visibility="gone"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true"
            tools:visibility="visible">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_canal_sync"
                style="@style/Widget.CodeIDE.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/editor_tooling_canal_sync" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_canal_build"
                style="@style/Widget.CodeIDE.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_tooling_canal_build" />
        </com.google.android.material.chip.ChipGroup>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tâches : actif dès que la sync a rempli le cache (aucun
             aller-retour) ; l'info-bulle + le contentDescription disent
             POURQUOI il est éteint avant la sync. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_taches_sortie"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_console_taches_indisponible"
            android:enabled="false"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/editor_tooling_canal_taches"
            android:tooltipText="@string/editor_console_taches_indisponible"
            app:icon="@drawable/ic_liste_taches" />

        <!-- Configuration (§3.3) : accès LIBELLÉ depuis la barre d'outils —
             la page s'affiche DANS le conteneur de la console, plus de
             dialogue plein écran au-dessus de l'éditeur. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_config_tooling"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_config_tooling_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/editor_config_tooling_libelle"
            app:icon="@drawable/ic_outils" />

        <!-- « Expliquer » (mission IA, lot IA-5, spec E3) : la sortie
             visible du canal courant part en pré-remplissage du chat
             (bouton panneau — console flux brut, pas de rangée
             cliquable, ADR 0078). -->
        <ImageButton
            android:id="@+id/bouton_expliquer_ia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ia_expliquer_ia_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:src="@drawable/ic_auto_awesome"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_annuler_build"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_sortie_annuler_cd"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:visibility="gone"
            app:icon="@drawable/ic_arreter_build"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Ligne de statut (v0.32.5 ; INC-22 finale : l'activité et le
         verdict vivent dans l'en-tête du sheet — ligne enrichie sur
         Console replié, indicateurs compacts ailleurs, INC-10) : elle
         n'apparaît plus que pour l'état que l'en-tête ne porte pas,
         l'orchestrateur déconnecté avant toute activité. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/statut_sortie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md_compact"
        android:paddingBottom="@dimen/spacing_xs"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Outils Gradle non connectés"
        tools:visibility="visible" />

    <!-- Bandeau d'échec DU CANAL AFFICHÉ (§3.3 ; INC-21, volet C : parité
         sync/build — un échec de sync avait seulement une ligne de statut,
         sans « Voir les problèmes » ni « Réessayer ») : message + actions
         « Voir les problèmes » (onglet Problèmes, si des diagnostics
         existent) et « Réessayer » (relance la MÊME activité — la sync
         pour le canal Sync, les mêmes tâches pour le canal Build) — plus
         d'échec muet. -->
    <LinearLayout
        android:id="@+id/bandeau_echec_canal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md_compact"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:background="@drawable/fond_bandeau_echec"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icone_echec_canal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_avertissement"
                app:tint="?attr/colorOnErrorContainer" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/message_echec_canal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer"
                tools:text="Échec du build — tâche compileDebugKotlin échouée" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- L5d (spec SORTIES § 5.7) : le FIL DE L'INCIDENT — un seul
                 geste ouvre les destinations qui comptent (sorties,
                 problèmes, diagnostics/journaux du serveur, logcat de la
                 session). Toujours visible avec le bandeau. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_fil_incident"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/editor_console_echec_fil" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_voir_problemes"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/editor_console_echec_voir_problemes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_reessayer_canal"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/editor_console_echec_reessayer" />
        </LinearLayout>
    </LinearLayout>

    <!-- Corps du panneau compact (L5b — spec SORTIES § 5.7 : le panneau
         compact N'EMBARQUE PLUS de moteur à lui : c'est une FENÊTRE sur le
         même composant) — le lecteur du Centre de sorties (famille GRADLE,
         fragment enfant), ajouté une fois par le fragment. Le chip de
         canal pousse son filtre par source au lecteur (FiltreSorties —
         le tampon ne bouge pas, les lignes masquées sont comptées) ;
         recherche, pause, effacement, regroupé et consultation vivent
         DANS le lecteur. Les deux consoles TextView et leur vidage loti
         sont SUPPRIMÉS (moteur mort, ADR 0078 retiré au profit du
         composant unique). -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/conteneur_lecteur_panneau"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

        <!-- v0.41.1 : champ de saisie stdin pour readln()/Scanner(System.in).
             Visible seulement pendant un build EN_COURS (le programme peut
             attendre une entrée). L'utilisateur tape, appuie sur Entrée,
             le texte est envoyé au serveur via BuildInput. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/champ_entree_console"
            style="@style/Widget.CodeIDE.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md_compact"
            android:layout_marginVertical="@dimen/spacing_xs"
            android:hint="@string/editor_console_entree_hint"
            android:visibility="gone"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_executer"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_entree_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Page de configuration (v4, §3.3) : vit DANS le conteneur de la
         console (fragment enfant), flèche retour en tête — remplacé le
         dialogue plein écran. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/conteneur_config_tooling"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
