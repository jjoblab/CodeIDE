<?xml version="1.0" encoding="utf-8"?>
<!--
  Popover « Déplacer vers… » (étape 31, § 10.5) : origine statique
  (chemin relatif mono), destination éditable + icône liste déroulante
  ouvrant le popover de choix du dossier (v0.32.1), erreurs en ligne,
  boutons Annuler/Déplacer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="258dp"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/fleche_popover"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/fond_fleche_popover"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/coque_popover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_popover"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md_compact">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/titre_deplacer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/popover_deplacer_vers"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/deplacer_origine"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.CodeIDE.Micro" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/champ_origine_deplacer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:background="@drawable/fond_champ_inline"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            tools:text="docs/adr" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/deplacer_destination"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.CodeIDE.Micro" />

        <!-- Champ destination + icône liste déroulante (v0.32.1) : un
             seul fond de champ, l'icône vit DANS la boîte au bout ; un
             appui ouvre le popover de choix du dossier destination. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs">

            <EditText
                android:id="@+id/champ_destination_deplacer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fond_champ_inline"
                android:fontFamily="monospace"
                android:hint="@string/deplacer_destination"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xs"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_xl"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                tools:text="docs" />

            <ImageView
                android:id="@+id/bouton_destination_deroulante"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/deplacer_destination_choisir_cd"
                android:padding="@dimen/spacing_xs"
                android:src="@drawable/ic_liste_deroulante"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <!-- Erreur en ligne (rouge LabelSmall, § 10.5). -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/erreur_deplacer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/codeide_explorateur_rouge"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone"
            tools:text="Dossier introuvable — chemin relatif attendu"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md_compact"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/bouton_annuler_deplacer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fond_action_popover"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="@dimen/spacing_md_compact"
                android:paddingVertical="@dimen/spacing_sm"
                android:text="@string/deplacer_annuler"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/bouton_valider_deplacer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/fond_bouton_primaire_popover"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm"
                android:text="@string/deplacer_valider"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
