<?xml version="1.0" encoding="utf-8"?>
<!--
  Espace de travail (étape 13, prompt compagnon section 5.1) : tiroir de
  navigation à gauche, zone centrale (toolbar + onglets vides + état vide),
  panneau inférieur replié à trois onglets vides.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_editeur"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <!-- ================= Contenu principal ================= -->

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/zone_centrale"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_editeur"
                style="@style/Widget.CodeIDE.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:navigationContentDescription="@string/editor_ouvrir_tiroir_cd"
                app:navigationIcon="@drawable/ic_menu_tiroir"
                app:title="@string/editor_title" />

            <!-- Onglets de fichiers ouverts : remplis à l'étape 15. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/onglets_fichiers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:tabMode="scrollable" />

            <FrameLayout
                android:id="@+id/conteneur_editeur"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Éditeur du fichier actif : une seule vue, rebranchée sur
                     la session de l'onglet sélectionné (ADR 0028). -->
                <jo.codeeditor.view.EditorView
                    android:id="@+id/vue_editeur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- État vide : aucun fichier ouvert (icône + invitation). -->
                <LinearLayout
                    android:id="@+id/zone_vide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/state_padding"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/state_icon_size"
                        android:layout_height="@dimen/state_icon_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ill_editeur_vide"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/state_spacing"
                        android:gravity="center"
                        android:text="@string/editor_vide_titre"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/editor_vide_message"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Projet introuvable : identifiant inconnu au registre. -->
                <LinearLayout
                    android:id="@+id/zone_introuvable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/state_padding"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/editor_introuvable_titre"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/editor_introuvable_message"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ================= Panneau inférieur (étape 16) =================
             Trois états gérés par BottomSheetBehavior : replié (en-tête seul,
             peekHeight 48 dp), mi-hauteur (ratio 0,5), étendu. -->

        <LinearLayout
            android:id="@+id/panneau_inferieur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.5"
            app:behavior_peekHeight="@dimen/editor_panneau_replie"
            app:behavior_skipCollapsed="false"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <!-- En-tête toujours visible : poignée, titre de l'onglet actif,
                 badge de compte, agrandir, réduire. Un appui bascule
                 replié <-> mi-hauteur (prompt compagnon 5.5). -->
            <LinearLayout
                android:id="@+id/entete_panneau"
                android:layout_width="match_parent"
                android:layout_height="@dimen/editor_panneau_replie"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <View
                    android:id="@+id/poignee_panneau"
                    android:layout_width="24dp"
                    android:layout_height="4dp"
                    android:background="?attr/colorOutline"
                    android:contentDescription="@string/editor_panneau_poignee_cd" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/titre_panneau"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Journal" />

                <!-- Badge de compte (nombre d'entrées affichées). -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/badge_panneau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="@drawable/badge_panneau"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:visibility="gone"
                    tools:text="12"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_agrandir_panneau"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_panneau_agrandir_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_agrandir_panneau" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_fermer_panneau"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_panneau_reduire_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_reduire_panneau" />
            </LinearLayout>

            <!-- Trois onglets : Journal fonctionnel, Sortie et Problèmes en
                 stub explicite (étape 16, prompt compagnon 5.5). -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/onglets_panneau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_console" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_problemes" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_journal" />
            </com.google.android.material.tabs.TabLayout>

            <FrameLayout
                android:id="@+id/conteneur_panneau"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Onglet Journal applicatif (fonctionnel) : filtres par
                     niveau, fenêtre compacte, lien vers l'écran Diagnostic. -->
                <LinearLayout
                    android:id="@+id/contenu_journal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/filtres_journal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="false"
                            app:singleLine="true"
                            app:singleSelection="false">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_debug"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_debug" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_info"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_info" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_warn"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_warn" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_error"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_error" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/liste_journal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingHorizontal="@dimen/screen_horizontal_margin"
                        android:paddingBottom="@dimen/spacing_xs"
                        tools:itemCount="6"
                        tools:listitem="@layout/ligne_entree_journal_compacte" />

                    <!-- Fenêtre vide après filtres (jamais un blanc muet). -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_journal_vide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="@dimen/state_padding"
                        android:text="@string/editor_journal_vide"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- Lien vers l'écran Diagnostic complet (historique,
                         exports, effacement — hors du panneau compact). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_journal_complet"
                        style="@style/Widget.CodeIDE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:text="@string/editor_journal_complet" />
                </LinearLayout>

                <!-- Onglet Sortie (G5, section 6) : état de
                     synchronisation/build, annulation, console du build
                     (fenêtre bornée, auto-défilement). -->
                <LinearLayout
                    android:id="@+id/contenu_sortie"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_xs"
                        android:paddingVertical="@dimen/spacing_xs">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/statut_sortie"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Build en cours" />

                        <ImageButton
                            android:id="@+id/bouton_annuler_build"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/editor_sortie_annuler_cd"
                            android:src="@drawable/ic_arreter_build"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/liste_sortie"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/spacing_xs" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_sortie_vide"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/state_padding"
                        android:text="@string/editor_sortie_vide"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Onglet Problèmes (G5, section 6) : diagnostics groupés
                     par fichier, saut à la ligne. -->
                <FrameLayout
                    android:id="@+id/contenu_problemes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/liste_problemes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/spacing_xs" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_problemes_vide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="@dimen/state_padding"
                        android:text="@string/editor_problemes_vide"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ================= Tiroir de navigation (v2, étape 31) =================
         Architecture à fragments (ADR 0052) : chaque destination (Fichiers,
         Recherche, Git, Terminal) est un fragment portant son propre entête
         — plus d'entête commun. Le tiroir (FrameLayout) porte le contenu
         des fragments (FragmentContainerView), le rail de fragments commun
         (§ 14), la zone du snackbar maison (§ 15) et la poignée ⋮ de
         redimensionnement collée au bord droit (§ 13, déborde à moitié :
         la largeur du tiroir inclut le débord de 13 dp).

         Largeur : posée à l'exécution (largeurTiroirPx dans EditorActivity,
         bornes 45-98 %, aimants 55/69/85/98) — la valeur XML n'est que la
         valeur par défaut de premier affichage. -->

    <FrameLayout
        android:id="@+id/tiroir"
        android:layout_width="@dimen/editor_tiroir_largeur"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/explorateur_fond_tiroir">

        <!-- Colonne : fragment courant + rail commun. Le rebord droit de
             13 dp laisse la poignée déborder à moitié (§ 13). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="13dp"
            android:orientation="vertical">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/conteneur_fragments_tiroir"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Rail de fragments (§ 14) : quatre destinations, remplies
                 par EditorActivity (icônes + libellés + état actif). -->
            <LinearLayout
                android:id="@+id/rail_fragments"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@color/explorateur_rail_fond"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Zone du snackbar maison (§ 15) : flottante au-dessus du rail,
             centrée — la vue est gonflée/masquée par le fragment. -->
        <FrameLayout
            android:id="@+id/zone_snackbar_tiroir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="74dp"
            android:paddingHorizontal="10dp" />

        <!-- Poignée ⋮ de redimensionnement (§ 13) : 26 × 78 dp, collée au
             bord droit à mi-hauteur, glissement = bornes/aimants. -->
        <ImageView
            android:id="@+id/poignee_tiroir"
            android:layout_width="26dp"
            android:layout_height="78dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/fond_poignee_tiroir"
            android:contentDescription="@string/poignee_cd"
            android:src="@drawable/ic_poignee_tiroir" />

        <!-- Pastille de taille (§ 13) : au-dessus de la poignée, visible
             pendant le glissement puis fondue. -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/pastille_taille_tiroir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="54dp"
            android:background="@drawable/fond_pastille_taille"
            android:elevation="6dp"
            android:fontFamily="monospace"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="@color/explorateur_accent"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="55 %" />
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
