<?xml version="1.0" encoding="utf-8"?>
<!--
  Espace de travail (étape 13, prompt compagnon section 5.1) : tiroir de
  navigation à gauche, zone centrale (toolbar + onglets vides + état vide),
  panneau inférieur replié à trois onglets vides.

  v0.80.3 (ADR 0100) : la racine est un FrameLayout de superposition —
  le TiroirPoussantLayout (id racine_editeur) en dessous, le calque de la
  poignée (conteneur_poignee, DERNIER enfant) au-dessus. Le calque ne doit
  PAS vivre dans le DrawerLayout : tout enfant sans gravité y est un enfant
  de contenu mesuré pleine taille (onMeasure), et tiroir ouvert,
  DrawerLayout.onInterceptTouchEvent intercepte toute touche dont l'enfant
  le plus haut est une vue de contenu (findTopChildUnder + isContentView
  quand mScrimOpacity > 0) — la régression v0.80.2 bloquait ainsi toutes
  les touches du tiroir.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <jo.codeide.feature.editor.TiroirPoussantLayout
        android:id="@+id/racine_editeur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:openDrawer="start">

        <!-- ================= Contenu principal ================= -->

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/zone_centrale"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar_editeur"
                    style="@style/Widget.CodeIDE.Toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:navigationContentDescription="@string/editor_ouvrir_tiroir_cd"
                    app:navigationIcon="@drawable/ic_menu_tiroir"
                    app:title="@string/editor_title" />

                <!-- Onglets de fichiers ouverts : remplis à l'étape 15.
                     v0.183.0 (retour propriétaire) : l'onglet ACTIF gagne
                     un fond net (state_selected du sélecteur
                     fond_onglet_editeur — surface surélevée, suivie en
                     jour/nuit/couleurs dynamiques) et l'indicateur de
                     soulignement est RETIRÉ (fond + trait = double
                     signal ; Android Studio : fond net, pas de trait).
                     v0.184.0 (retour propriétaire : « trop gros — une
                     forme RECTANGULAIRE au lieu de la pilule ») : le
                     fond devient un RECTANGLE aux coins 4 dp, la
                     cellule se resserre (hauteur EXPLICITE 44 dp au
                     lieu du wrap_content ~48 dp de Material, padding
                     horizontal 8 dp) — l'onglet actif lit comme un
                     bloc plat d'IDE, pas comme une pastille gonflée. -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/onglets_fichiers"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/editor_onglets_hauteur"
                    android:visibility="gone"
                    app:tabBackground="@drawable/fond_onglet_editeur"
                    app:tabIndicatorHeight="0dp"
                    app:tabPaddingEnd="@dimen/editor_onglets_padding_horizontal"
                    app:tabPaddingStart="@dimen/editor_onglets_padding_horizontal"
                    app:tabMode="scrollable" />

                <!-- (v0.32.5) Plus de fil d'Ariane ici : retiré sur retour
                     d'appareil réel — le rendu de la bibliothèque ne
                     donnait pas le design espéré (ADR 0056, décision 1). -->

                <!-- (v0.124.12) barre_etat_lsp RETIRÉE — remplacée par la
                     pastille de toolbar VuePointIndexation (menu_indexation).
                     La ligne consommait de la hauteur dans la colonne
                     centrale (incident v0.100.2 « la barre avalait
                     l'éditeur ») et n'affichait ni les avertissements ni
                     les erreurs du modèle EtatIndex. La pastille vit dans
                     la toolbar qui existe déjà — aucun saut de mise en
                     page pendant l'indexation (Phase B prompt 2, ADR 0117). -->

                <!-- L5c (spec SORTIES § 5.7, M8) : la zone centrale devient
                     une RANGÉE code | sorties — sur tablette, l'éditeur
                     dédié vit DANS UN VOLET À CÔTÉ DU CODE (jamais
                     par-dessus) ; le volet est GONE par défaut (téléphone)
                     et l'activité le montre (poids) quand l'utilisateur
                     l'ouvre. Le conteneur historique devient [zone_code],
                     sa colonne conserve TOUS ses enfants existants. -->
                <!-- baselineAligned=false : les enfants sont des conteneurs
                     à poids (FrameLayout), jamais des rangées de texte —
                     l'alignement de baseline n'a aucun sens ici (lint
                     DisableBaselineAlignment). -->
                <LinearLayout
                    android:id="@+id/conteneur_editeur"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Poids imbriqué VOLONTAIRE (lint NestedWeights) : le
                         rang code | sorties hérite du poids vertical du
                         conteneur central et partage sa largeur entre le
                         code et le volet tablette (motif M8, spec SORTIES
                         § 5.7) — le surcoût de mesure (deux passes) est
                         négligeable face à une restructuration risquée. -->
                    <FrameLayout
                        android:id="@+id/zone_code"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        tools:ignore="NestedWeights">

                    <!-- Éditeur du fichier actif (pleine largeur — l'aperçu
                         XML se superpose en overlay quand activé, plus de
                         split 50/50 qui rendait l'éditeur illisible). -->
                    <jo.codeeditor.view.EditorView
                        android:id="@+id/vue_editeur"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- CE3 (B10) : barre de recherche/remplacement —
                         GONE par défaut, ouverte par Ctrl+F ou menu.
                         Se pose entre l'en-tête et l'éditeur. -->
                    <jo.codeeditor.view.chrome.EditorSearchBar
                        android:id="@+id/barre_recherche"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- PE6-0 : le bloc colonne_apercu (overlay de la
                         preview XML, PE1 → PE5) est RETIRÉ — l'aperçu vit
                         désormais dans PreviewActivity (:feature:preview),
                         ouverte par AppNavigator.openPreview (maquette
                         docs/mockups/apercu-xml.html § « Activité
                         dédiée ») ; l'éditeur garde sa pleine largeur. -->

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progression"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <!-- État vide (v0.32.3) : illustration riche, deux actions
                         directes et astuces de découverte — plus une simple
                         icône + invitation. -->
                    <LinearLayout
                        android:id="@+id/zone_vide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/state_padding"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ill_editeur_code" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/state_spacing"
                            android:gravity="center"
                            android:text="@string/editor_vide_titre"
                            android:textAppearance="?attr/textAppearanceTitleLarge" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:gravity="center"
                            android:maxWidth="320dp"
                            android:text="@string/editor_vide_message"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Deux actions directes : ouvrir le tiroir des fichiers
                             (le geste que l'utilisateur cherche) ou le terminal. -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/state_spacing"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/bouton_vide_explorer"
                                style="@style/Widget.CodeIDE.Button.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_vide_action_explorer"
                                app:icon="@drawable/ic_explorateur" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/bouton_vide_terminal"
                                style="@style/Widget.CodeIDE.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:text="@string/editor_vide_action_terminal"
                                app:icon="@drawable/ic_terminal" />
                        </LinearLayout>

                        <!-- Astuces de découverte (retour d'appareil : les gestes
                             de l'étape 31 ne se devinent pas). -->
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:text="@string/editor_vide_astuces"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:gravity="center"
                            android:text="@string/editor_vide_astuce_explorateur"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:drawableStartCompat="@drawable/point_onglet"
                            app:drawableTint="?attr/colorPrimary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:gravity="center"
                            android:text="@string/editor_vide_astuce_poignee"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:drawableStartCompat="@drawable/point_onglet"
                            app:drawableTint="?attr/colorPrimary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_sm"
                            android:gravity="center"
                            android:text="@string/editor_vide_astuce_terminal"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:drawableStartCompat="@drawable/point_onglet"
                            app:drawableTint="?attr/colorPrimary" />
                    </LinearLayout>

                    <!-- Projet introuvable : identifiant inconnu au registre. -->
                    <LinearLayout
                        android:id="@+id/zone_introuvable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/state_padding"
                        android:visibility="gone">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/editor_introuvable_titre"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:gravity="center"
                            android:text="@string/editor_introuvable_message"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </FrameLayout>

                <!-- L5c (spec SORTIES § 5.7, M8) : le VOLET tablette —
                     l'éditeur dédié À CÔTÉ DU CODE, jamais par-dessus.
                     FragmentLecteurSorties (famille GRADLE) y vit ; l'état
                     d'ouverture (téléphone : absent) est porté par
                     l'activité, la largeur par son poids face au code. -->
                <FrameLayout
                    android:id="@+id/conteneur_lecteur_volet"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:visibility="gone" />
                </LinearLayout>

                <!-- Barre de symboles collée au clavier (v0.32.5, ADR 0056
                     décision 2, patron du projet de référence) : DERNIÈRE vue de la
                     colonne centrale — quand l'IME s'ouvre, le bas de la
                     zone est remonté de la hauteur du clavier (insets IME
                     appliqués en padding, animés), la barre se retrouve
                     posée juste au-dessus des touches : « collée ».
                     Masquée sinon (et le panneau réapparaît). La VRAIE
                     SymbolBarView de la bibliothèque code-editor. -->
                <!-- Mission IA, lot IA-5 (ADR 0126, spec E3) : barre de
                     consigne en ligne + carte de proposition (diff),
                     entre l'éditeur et la barre de symboles — JAMAIS en
                     overlay ; elles montent avec le clavier (insets de
                     la zone centrale, ADR 0118). Masquées par défaut. -->
                <include
                    android:id="@+id/barre_consigne_ia"
                    layout="@layout/vue_barre_consigne_ia" />

                <include
                    android:id="@+id/carte_diff_ia"
                    layout="@layout/vue_carte_diff_ia" />

                <jo.codeeditor.view.chrome.SymbolBarView
                    android:id="@+id/barre_symboles"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/fond_barre_symboles"
                    android:contentDescription="@string/barre_symboles_cd"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </LinearLayout>

            <!-- ================= Panneau inférieur (étape 16, v0.32.4/0.32.5 ; en-tête unifié v2) =================
                 Trois états gérés par BottomSheetBehavior : replié (rang 1
                 seul, peekHeight 48 dp), mi-hauteur (ratio 0,5), étendu.
                 EN-TÊTE UNIFIÉ (maquette sorties v2) : l'ancienne pile de
                 TROIS sections — entete_panneau (poignée + titre d'onglet +
                 sous-titre + badge + indicateur compact n°1), ligne_tooling
                 (pastille 34 dp + titre + étape + chrono + arrêt) et
                 rang_onglets_panneau (onglets + indicateur compact n°2) —
                 disait l'onglet DEUX fois, répétait le compte en badge ET en
                 sous-titre, et faisait lire TROIS rangs avant la première
                 ligne de sortie. Désormais DEUX rangs, une seule
                 responsabilité chacun :
                   - rang 1 (48 dp, TOUJOURS visible) : poignée + indicateur
                     compact UNIQUE (pastille + titre + étape + chrono +
                     arrêter) + agrandir + réduire ;
                   - rang 2 : les onglets — le badge de compte vit SUR
                     l'onglet Problèmes (BadgeDrawable), plus de
                     sous-titre duplicata.
                 Architecture à fragments (ADR 0055, retour v0.32.3) : le
                 chrome (rang 1 + onglets) reste à l'hôte, le contenu des
                 quatre onglets vit dans des fragments ajoutés une fois puis
                 montrés/cachés. Fond opaque arrondi (v0.32.5, ADR 0056
                 décision 4) : le panneau n'est plus transparent, il se pose
                 SUR l'éditeur. -->

            <LinearLayout
                android:id="@+id/panneau_inferieur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fond_panneau_inferieur"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:orientation="vertical"
                app:behavior_fitToContents="false"
                app:behavior_halfExpandedRatio="0.5"
                app:behavior_peekHeight="@dimen/editor_panneau_replie"
                app:behavior_skipCollapsed="false"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

                <!-- RANG 1 — en-tête unifié (maquette sorties v2) : 48 dp
                     TOUJOURS visibles, replié comme étendu. Un appui
                     bascule replié <-> mi-hauteur (prompt compagnon 5.5) ;
                     l'indicateur compact porte l'état tooling (pastille de
                     canal, titre, étape courante, chrono, bouton Arrêter)
                     et la poignée d'extension reste à droite. Le
                     paddingBottom d'inset de barre de navigation est posé
                     par GestionnaireInsetsEditeur : replié, le contenu vit
                     ENTIÈREMENT au-dessus de la barre transparente, seul
                     l'espace rembourré pend derrière elle. -->
                <LinearLayout
                    android:id="@+id/rang_entete_panneau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/editor_panneau_replie"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/editor_panneau_poignee_cd"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md">

                    <View
                        android:id="@+id/poignee_panneau"
                        android:layout_width="24dp"
                        android:layout_height="4dp"
                        android:background="?attr/colorOutline"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <!-- Indicateur tooling COMPACT UNIQUE (INC-10, volet C ;
                         en-tête unifié v2) : le retour d'activité vit ICI,
                    dans le rang 1, pour TOUS les onglets et TOUS les états
                    du sheet — l'ancien doublon du rang des onglets a
                    disparu. Il occupe l'espace flexible : son titre et son
                    sous-titre d'étape ellipsent, le chrono et le bouton
                    Arrêter restent entiers. Piloté par
                    PanneauToolingController avec le MÊME EtatEnteteTooling
                    que l'ancienne ligne enrichie (INC-02 : une seule
                    dérivation). -->
                    <include
                        android:id="@+id/indicateur_compact_entete"
                        layout="@layout/indicateur_tooling_compact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_agrandir_panneau"
                        style="@style/Widget.CodeIDE.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/editor_panneau_agrandir_cd"
                        android:minWidth="@dimen/touch_target_min"
                        android:minHeight="@dimen/touch_target_min"
                        app:icon="@drawable/ic_agrandir_panneau" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_fermer_panneau"
                        style="@style/Widget.CodeIDE.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/editor_panneau_reduire_cd"
                        android:minWidth="@dimen/touch_target_min"
                        android:minHeight="@dimen/touch_target_min"
                        app:icon="@drawable/ic_reduire_panneau" />
                </LinearLayout>

                <!-- Progression du canal actif (v4, §3.3 ; en-tête unifié
                     v2 : bande du rang 1, pour TOUS les onglets) :
                     DÉTERMINÉE quand une progression existe (octets
                     reçus/total), indéterminée sinon — couleur de canal au
                     rendu, pleine verte sur succès. Repliée, elle vit sous
                     le peek de 48 dp : la pastille du rang 1 (spinner en
                     vol) porte seule le retour d'activité, le peek ne
                     bouge plus JAMAIS (INC-18). -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progression_tooling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- RANG 2 — onglets (chrome de l'hôte, v0.32.4) : la
                     sélection commute les fragments du conteneur
                     ci-dessous. Le badge de compte (diagnostics) vit SUR
                     l'onglet Problèmes (BadgeMaterial, posé par
                     EditorActivity rendreBadgeOnglets) — plus de titre ni
                     de sous-titre d'onglet dans l'en-tête : l'onglet se
                     dit lui-même. -->
                <LinearLayout
                    android:id="@+id/rang_onglets_panneau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/onglets_panneau"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_panneau_console" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_panneau_problemes" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_panneau_journal" />

                        <!-- Mission « Exécuter » R3 (ADR 0103) : journaux des
                             applications exécutées, sans adb. L'ordre des
                             TabItem suit STRICTEMENT l'enum OngletPanneau. -->
                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_panneau_logcat" />
                    </com.google.android.material.tabs.TabLayout>
                </LinearLayout>

                <!-- Contenu des onglets (v0.32.4, ADR 0055) : fragments
                     Journal / Sortie / Problèmes, ajoutés une fois par
                     l'activité puis montrés/cachés — l'état de défilement
                     survit aux changements d'onglet (même pattern que le
                     tiroir, ADR 0052). -->
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/conteneur_fragments_panneau"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- ================= Tiroir de navigation (v2, étape 31) =================
             Architecture à fragments (ADR 0052) : chaque destination (Fichiers,
             Recherche, Git, Terminal) est un fragment portant son propre entête
             — plus d'entête commun. Le tiroir (FrameLayout) porte le contenu
             des fragments (FragmentContainerView), le rail de fragments commun
             (§ 14), la zone du snackbar maison (§ 15) et la pastille de taille.

             Fond : fond_tiroir, pleine largeur (v0.80.2 : plus de bande de
             débord — la poignée ⋮ de redimensionnement ne vit plus DANS le
             tiroir mais dans conteneur_poignee, superposé au TiroirPoussantLayout
             à la racine (v0.80.3, ADR 0100), à cheval réellement sur le bord
             du tiroir et la zone centrale).

             Largeur : posée à l'exécution (largeurTiroirPx dans EditorActivity,
             bornes 45-98 %, aimants 55/69/85/98) — la valeur XML n'est que la
             valeur par défaut de premier affichage. Marge haute posée aux
             insets système (v0.32.1) : le tiroir ne passe jamais derrière la
             barre de statut. -->

        <FrameLayout
            android:id="@+id/tiroir"
            android:layout_width="@dimen/editor_tiroir_largeur"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/fond_tiroir">

            <!-- Colonne : fragment courant + rail commun (v0.80.2 : pleine
                 largeur du tiroir — le débord de 13 dp a disparu avec la
                 poignée racine). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/conteneur_fragments_tiroir"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Rail de fragments (§ 14) : quatre destinations, remplies
                     par EditorActivity (icônes + libellés + état actif). -->
                <LinearLayout
                    android:id="@+id/rail_fragments"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_xs"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_xs" />
            </LinearLayout>

            <!-- Zone du snackbar maison (§ 15) : flottante au-dessus du rail,
                 centrée — la vue est gonflée/masquée par le fragment. -->
            <FrameLayout
                android:id="@+id/zone_snackbar_tiroir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/editor_snackbar_marge_bas"
                android:paddingHorizontal="@dimen/spacing_md_compact" />

            <!-- Pastille de taille (§ 13) : flottante au-dessus du rail,
                 visible pendant le glissement puis fondue (v0.80.2 : reste
                 dans le tiroir — elle suit son bord sans recalage). -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/pastille_taille_tiroir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/spacing_md_compact"
                android:layout_marginBottom="@dimen/editor_pastille_taille_marge_bas"
                android:background="@drawable/fond_pastille_taille"
                android:elevation="6dp"
                android:fontFamily="monospace"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xs"
                android:textColor="?attr/colorPrimary"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:visibility="gone"
                tools:text="55 %" />
        </FrameLayout>
    </jo.codeide.feature.editor.TiroirPoussantLayout>

    <!-- ================= Poignée ⋮ de redimensionnement (v0.80.2, ADR 0100) =================
         HORS du TiroirPoussantLayout (v0.80.3) : le calque est le DERNIER
         enfant du FrameLayout racine — superposé au DrawerLayout, dessiné
         APRÈS lui (au-dessus) et touché AVANT lui. Il ne doit surtout pas
         vivre DANS le DrawerLayout : tout enfant sans gravité y est un
         enfant de contenu mesuré pleine taille (onMeasure), et tiroir
         ouvert, DrawerLayout.onInterceptTouchEvent intercepte toute touche
         dont l'enfant le plus haut est une vue de contenu
         (findTopChildUnder + isContentView, mScrimOpacity > 0) — la
         régression v0.80.2 bloquait ainsi TOUTES les touches du tiroir.
         Plein écran et transparent, le calque ne consomme AUCUNE touche
         (FrameLayout non cliquable) : les contacts hors poignée tombent
         normalement sur le tiroir puis la zone centrale. La poignée
         (26 × 78 dp, § 13) est posée à l'exécution (recalerPoignee) à
         CHEVAL sur le bord du tiroir : moitié de gauche sur le tiroir,
         moitié de droite sur la zone centrale — un VRAI chevauchement,
         plus de bande de débord transparente empruntée au tiroir. -->
    <FrameLayout
        android:id="@+id/conteneur_poignee"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/poignee_tiroir"
            android:layout_width="26dp"
            android:layout_height="78dp"
            android:background="@drawable/fond_poignee_tiroir"
            android:contentDescription="@string/poignee_cd"
            android:src="@drawable/ic_poignee_tiroir"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

</FrameLayout>
