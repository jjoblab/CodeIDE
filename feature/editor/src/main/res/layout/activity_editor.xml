<?xml version="1.0" encoding="utf-8"?>
<!--
  Espace de travail (étape 13, prompt compagnon section 5.1) : tiroir de
  navigation à gauche, zone centrale (toolbar + onglets vides + état vide),
  panneau inférieur replié à trois onglets vides.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_editeur"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <!-- ================= Contenu principal ================= -->

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/zone_centrale"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_editeur"
                style="@style/Widget.CodeIDE.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:navigationContentDescription="@string/editor_ouvrir_tiroir_cd"
                app:navigationIcon="@drawable/ic_menu_tiroir"
                app:title="@string/editor_title" />

            <!-- Onglets de fichiers ouverts : remplis à l'étape 15. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/onglets_fichiers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:tabMode="scrollable" />

            <FrameLayout
                android:id="@+id/conteneur_editeur"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Éditeur du fichier actif : une seule vue, rebranchée sur
                     la session de l'onglet sélectionné (ADR 0028). -->
                <jo.codeeditor.view.EditorView
                    android:id="@+id/vue_editeur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- État vide : aucun fichier ouvert (icône + invitation). -->
                <LinearLayout
                    android:id="@+id/zone_vide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/state_padding"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/state_icon_size"
                        android:layout_height="@dimen/state_icon_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ill_editeur_vide"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/state_spacing"
                        android:gravity="center"
                        android:text="@string/editor_vide_titre"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/editor_vide_message"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Projet introuvable : identifiant inconnu au registre. -->
                <LinearLayout
                    android:id="@+id/zone_introuvable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/state_padding"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/editor_introuvable_titre"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/editor_introuvable_message"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ================= Panneau inférieur (étape 16) =================
             Trois états gérés par BottomSheetBehavior : replié (en-tête seul,
             peekHeight 48 dp), mi-hauteur (ratio 0,5), étendu. -->

        <LinearLayout
            android:id="@+id/panneau_inferieur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.5"
            app:behavior_peekHeight="@dimen/editor_panneau_replie"
            app:behavior_skipCollapsed="false"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <!-- En-tête toujours visible : poignée, titre de l'onglet actif,
                 badge de compte, agrandir, réduire. Un appui bascule
                 replié <-> mi-hauteur (prompt compagnon 5.5). -->
            <LinearLayout
                android:id="@+id/entete_panneau"
                android:layout_width="match_parent"
                android:layout_height="@dimen/editor_panneau_replie"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <View
                    android:id="@+id/poignee_panneau"
                    android:layout_width="24dp"
                    android:layout_height="4dp"
                    android:background="?attr/colorOutline"
                    android:contentDescription="@string/editor_panneau_poignee_cd" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/titre_panneau"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Journal" />

                <!-- Badge de compte (nombre d'entrées affichées). -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/badge_panneau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="@drawable/badge_panneau"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:visibility="gone"
                    tools:text="12"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_agrandir_panneau"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_panneau_agrandir_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_agrandir_panneau" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_fermer_panneau"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_panneau_reduire_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_reduire_panneau" />
            </LinearLayout>

            <!-- Trois onglets : Journal fonctionnel, Sortie et Problèmes en
                 stub explicite (étape 16, prompt compagnon 5.5). -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/onglets_panneau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_console" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_problemes" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_journal" />
            </com.google.android.material.tabs.TabLayout>

            <FrameLayout
                android:id="@+id/conteneur_panneau"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Onglet Journal applicatif (fonctionnel) : filtres par
                     niveau, fenêtre compacte, lien vers l'écran Diagnostic. -->
                <LinearLayout
                    android:id="@+id/contenu_journal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/filtres_journal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="false"
                            app:singleLine="true"
                            app:singleSelection="false">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_debug"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_debug" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_info"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_info" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_warn"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_warn" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_journal_error"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_journal_niveau_error" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/liste_journal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingHorizontal="@dimen/screen_horizontal_margin"
                        android:paddingBottom="@dimen/spacing_xs"
                        tools:itemCount="6"
                        tools:listitem="@layout/ligne_entree_journal_compacte" />

                    <!-- Fenêtre vide après filtres (jamais un blanc muet). -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_journal_vide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="@dimen/state_padding"
                        android:text="@string/editor_journal_vide"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- Lien vers l'écran Diagnostic complet (historique,
                         exports, effacement — hors du panneau compact). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_journal_complet"
                        style="@style/Widget.CodeIDE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:text="@string/editor_journal_complet" />
                </LinearLayout>

                <!-- Onglet Sortie — stub explicite (étape 16) : le tooling
                     de compilation est hors périmètre Phase 1. Le point
                     d'ancrage des diagnostics (session.setDiagnostics) est
                     noté pour le tooling futur, non câblé. -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/contenu_sortie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/state_padding"
                    android:text="@string/editor_sortie_stub"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <!-- Onglet Problèmes — stub explicite (étape 16). -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/contenu_problemes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/state_padding"
                    android:text="@string/editor_problemes_stub"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ================= Tiroir de navigation ================= -->

    <LinearLayout
        android:id="@+id/tiroir"
        android:layout_width="@dimen/editor_tiroir_largeur"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical">

        <!-- En-tête fixe : projet, chemin, actualisation, fermeture. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/editor_tiroir_section"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Création à la racine du projet (étape 17) : menu
                     fichier/dossier — le menu contextuel d'un nœud couvre
                     la création dans un dossier. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_nouveau"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_tiroir_nouveau_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_nouveau_fichier" />

                <!-- Revérifie l'état d'accès du projet (prompt compagnon 5.3). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_actualiser"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_tiroir_actualiser_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_actualiser" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nom_projet_tiroir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Mon Projet" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/chemin_tiroir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Projets/Mon Projet" />

            <!-- Type reconnu depuis .codeide/project.json (étape 18). -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/type_projet_tiroir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="Modèle Kotlin · JVM · v1.0.0"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_fermer_projet"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="start|center_vertical"
                android:text="@string/editor_tiroir_fermer_projet" />
        </LinearLayout>

        <!-- Contenu du tiroir : arborescence, bandeau d'accès, états (étape 14). -->
        <FrameLayout
            android:id="@+id/contenu_tiroir"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liste_explorateur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"
                tools:listitem="@layout/ligne_noeud_arborescence" />

            <!-- Arborescence vide : dossier du projet sans enfants. -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_explorateur_vide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="@dimen/state_padding"
                android:text="@string/editor_explorateur_vide"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <!-- Vérification d'accès en vol (première charge, Actualiser). -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progression_tiroir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Bandeau d'accès : permission perdue, introuvable, erreur. -->
            <LinearLayout
                android:id="@+id/bandeau_acces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/icone_acces"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_avertissement"
                    app:tint="?attr/colorError" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/titre_acces"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Permission perdue" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/message_acces"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Le système a révoqué l'accès au dossier du projet." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_resoudre"
                    style="@style/Widget.CodeIDE.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    tools:text="Résoudre à l'accueil" />
            </LinearLayout>

            <!-- Carte d'aperçu du terminal (T6, section 8) : quatrième
                 destination de la barre basse. Métadonnées du registre
                 global SEULEMENT — aucun rendu Termux ici : feature:editor
                 ne dépend d'aucune bibliothèque com.termux:* (critère
                 d'acceptation, section 11 du prompt Terminal-1). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carte_terminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <!-- En-tête : pastille d'état de la session active,
                         titre, bouton d'agrandissement. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/pastille_terminal"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/point_onglet"
                            android:contentDescription="@null" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/titre_carte_terminal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/editor_nav_terminal"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <!-- Agrandissement : même écran plein écran que
                             l'action de la toolbar de l'accueil. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_agrandir_terminal"
                            style="@style/Widget.CodeIDE.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/editor_terminal_agrandir_cd"
                            android:minWidth="@dimen/touch_target_min"
                            android:minHeight="@dimen/touch_target_min"
                            app:icon="@drawable/ic_agrandir_panneau" />
                    </LinearLayout>

                    <!-- Compteur de sessions actives. -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/compteur_sessions_terminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="2 sessions actives" />

                    <!-- Session active : libellé et dernière sortie connue. -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/libelle_session_terminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone"
                        tools:text="Session 1"
                        tools:visibility="visible" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sortie_session_terminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="3"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="$ pwd
/home
$"
                        tools:visibility="visible" />

                    <!-- État vide : aucune session (bouton de création dans
                         le dossier du projet courant). -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_aucune_session_terminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/editor_terminal_aucune_session"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_nouvelle_session_terminal"
                        style="@style/Widget.CodeIDE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:minWidth="@dimen/touch_target_min"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/editor_terminal_nouvelle_session"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Bootstrap absent : installation d'abord, jamais une
                         session sans shell (garde-fou symétrique de
                         l'accueil, section 7). -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_non_installe_terminal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/editor_terminal_non_installe"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_installer_terminal"
                        style="@style/Widget.CodeIDE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:minWidth="@dimen/touch_target_min"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/editor_terminal_installer"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Barre de navigation basse du tiroir (prompt compagnon 5.3) :
             Explorateur active, Recherche et Git visibles mais désactivés.
             Sous thème Material3, BottomNavigationView prend le rendu M3.
             Correctif v0.19.0 : le menu est référencé par app:menu
             (res/menu/menu_tiroir.xml) — un <menu> inline dans un layout
             fait planter LayoutInflater (android.view.menu inexistant). -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/barre_navigation_tiroir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_tiroir" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
