<?xml version="1.0" encoding="utf-8"?>
<!--
  Espace de travail (étape 13, prompt compagnon section 5.1) : tiroir de
  navigation à gauche, zone centrale (toolbar + onglets vides + état vide),
  panneau inférieur replié à trois onglets vides.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_editeur"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <!-- ================= Contenu principal ================= -->

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/zone_centrale"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_editeur"
                style="@style/Widget.CodeIDE.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:navigationContentDescription="@string/editor_ouvrir_tiroir_cd"
                app:navigationIcon="@drawable/ic_menu_tiroir"
                app:title="@string/editor_title" />

            <!-- Onglets de fichiers ouverts : remplis à l'étape 15. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/onglets_fichiers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:tabMode="scrollable" />

            <!-- (v0.32.5) Plus de fil d'Ariane ici : retiré sur retour
                 d'appareil réel — le rendu de la bibliothèque ne
                 donnait pas le design espéré (ADR 0056, décision 1). -->

            <FrameLayout
                android:id="@+id/conteneur_editeur"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Éditeur du fichier actif : une seule vue, rebranchée sur
                     la session de l'onglet sélectionné (ADR 0028). -->
                <jo.codeeditor.view.EditorView
                    android:id="@+id/vue_editeur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- État vide (v0.32.3) : illustration riche, deux actions
                     directes et astuces de découverte — plus une simple
                     icône + invitation. -->
                <LinearLayout
                    android:id="@+id/zone_vide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/state_padding"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ill_editeur_code" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/state_spacing"
                        android:gravity="center"
                        android:text="@string/editor_vide_titre"
                        android:textAppearance="?attr/textAppearanceTitleLarge" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:maxWidth="320dp"
                        android:text="@string/editor_vide_message"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Deux actions directes : ouvrir le tiroir des fichiers
                         (le geste que l'utilisateur cherche) ou le terminal. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/state_spacing"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_vide_explorer"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_vide_action_explorer"
                            app:icon="@drawable/ic_explorateur" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_vide_terminal"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/editor_vide_action_terminal"
                            app:icon="@drawable/ic_terminal" />
                    </LinearLayout>

                    <!-- Astuces de découverte (retour d'appareil : les gestes
                         de l'étape 31 ne se devinent pas). -->
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/editor_vide_astuces"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:drawablePadding="@dimen/spacing_sm"
                        android:gravity="center"
                        android:text="@string/editor_vide_astuce_explorateur"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:drawableStartCompat="@drawable/point_onglet"
                        app:drawableTint="?attr/colorPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:drawablePadding="@dimen/spacing_sm"
                        android:gravity="center"
                        android:text="@string/editor_vide_astuce_poignee"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:drawableStartCompat="@drawable/point_onglet"
                        app:drawableTint="?attr/colorPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:drawablePadding="@dimen/spacing_sm"
                        android:gravity="center"
                        android:text="@string/editor_vide_astuce_terminal"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:drawableStartCompat="@drawable/point_onglet"
                        app:drawableTint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Projet introuvable : identifiant inconnu au registre. -->
                <LinearLayout
                    android:id="@+id/zone_introuvable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/state_padding"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/editor_introuvable_titre"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center"
                        android:text="@string/editor_introuvable_message"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </FrameLayout>

            <!-- Barre de symboles collée au clavier (v0.32.5, ADR 0056
                 décision 2, patron CodeAssist) : DERNIÈRE vue de la
                 colonne centrale — quand l'IME s'ouvre, le bas de la
                 zone est remonté de la hauteur du clavier (insets IME
                 appliqués en padding, animés), la barre se retrouve
                 posée juste au-dessus des touches : « collée ».
                 Masquée sinon (et le panneau réapparaît). La VRAIE
                 SymbolBarView de la bibliothèque code-editor. -->
            <jo.codeeditor.view.SymbolBarView
                android:id="@+id/barre_symboles"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/fond_barre_symboles"
                android:contentDescription="@string/barre_symboles_cd"
                android:visibility="gone"
                tools:visibility="gone" />
        </LinearLayout>

        <!-- ================= Panneau inférieur (étape 16, v0.32.4/0.32.5) =================
             Trois états gérés par BottomSheetBehavior : replié (en-tête seul,
             peekHeight 48 dp, + ligne tooling quand une activité tourne),
             mi-hauteur (ratio 0,5), étendu (alors l'en-tête s'est fondu).
             Architecture à fragments (ADR 0055, retour v0.32.3) : le chrome
             (en-tête, onglets) reste à l'hôte, le contenu des trois onglets
             vit dans des fragments ajoutés une fois puis montrés/cachés.
             Fond opaque arrondi (v0.32.5, ADR 0056 décision 4) : le panneau
             n'est plus transparent, il se pose SUR l'éditeur. -->

        <LinearLayout
            android:id="@+id/panneau_inferieur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fond_panneau_inferieur"
            android:elevation="8dp"
            android:orientation="vertical"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.5"
            app:behavior_peekHeight="@dimen/editor_panneau_replie"
            app:behavior_skipCollapsed="false"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <!-- En-tête toujours visible : poignée, titre de l'onglet actif,
                 badge de compte, agrandir, réduire. Un appui bascule
                 replié <-> mi-hauteur (prompt compagnon 5.5). -->
            <LinearLayout
                android:id="@+id/entete_panneau"
                android:layout_width="match_parent"
                android:layout_height="@dimen/editor_panneau_replie"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <View
                    android:id="@+id/poignee_panneau"
                    android:layout_width="24dp"
                    android:layout_height="4dp"
                    android:background="?attr/colorOutline"
                    android:contentDescription="@string/editor_panneau_poignee_cd" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/titre_panneau"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Journal" />

                <!-- Badge de compte (nombre d'entrées affichées). -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/badge_panneau"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="@drawable/badge_panneau"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:visibility="gone"
                    tools:text="12"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_agrandir_panneau"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_panneau_agrandir_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_agrandir_panneau" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_fermer_panneau"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_panneau_reduire_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    app:icon="@drawable/ic_reduire_panneau" />
            </LinearLayout>

            <!-- Ligne tooling (v0.32.5, ADR 0056 décision 5) : l'activité
                 EN COURS du tooling, sur SON canal — icône et couleur du
                 canal (Sync ou Build), libellé de la tâche, chrono en vol,
                 bouton Arrêter. Visible dès qu'un canal est actif ou a un
                 résultat récent ; le peek s'élargit pour l'accueillir.
                 Fondu avec l'en-tête quand le panneau s'étend. -->
            <LinearLayout
                android:id="@+id/ligne_tooling"
                android:layout_width="match_parent"
                android:layout_height="@dimen/editor_ligne_tooling_hauteur"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/icone_canal_tooling"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    tools:src="@drawable/ic_terminal" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/activite_tooling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Build — assembleDebug" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/minuteur_tooling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="12,3 s" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_arreter_tooling"
                    style="@style/Widget.CodeIDE.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/editor_tooling_arreter_cd"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:visibility="gone"
                    app:icon="@drawable/ic_arreter_build"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Progression du canal actif (v0.32.5) : fine bande
                 indéterminée sous la ligne tooling — Gradle ne donne pas
                 de pourcentage, la bande tourne pendant l'activité. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progression_tooling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Trois onglets (chrome de l'hôte, v0.32.4) : la sélection
                 commute les fragments du conteneur ci-dessous. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/onglets_panneau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_console" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_problemes" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_panneau_journal" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Contenu des onglets (v0.32.4, ADR 0055) : fragments
                 Journal / Sortie / Problèmes, ajoutés une fois par
                 l'activité puis montrés/cachés — l'état de défilement
                 survit aux changements d'onglet (même pattern que le
                 tiroir, ADR 0052). -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/conteneur_fragments_panneau"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ================= Tiroir de navigation (v2, étape 31) =================
         Architecture à fragments (ADR 0052) : chaque destination (Fichiers,
         Recherche, Git, Terminal) est un fragment portant son propre entête
         — plus d'entête commun. Le tiroir (FrameLayout) porte le contenu
         des fragments (FragmentContainerView), le rail de fragments commun
         (§ 14), la zone du snackbar maison (§ 15) et la poignée ⋮ de
         redimensionnement collée au bord droit (§ 13, déborde à moitié :
         la largeur du tiroir inclut le débord de 13 dp).

         Fond : fond_tiroir — borné à la largeur VISIBLE, la bande de
         débord de 13 dp reste transparente (la moitié externe de la
         poignée flotte sur l'éditeur, comme la maquette) ; les fragments
         remplissent le tiroir visible d'un bord à l'autre.

         Largeur : posée à l'exécution (largeurTiroirPx dans EditorActivity,
         bornes 45-98 %, aimants 55/69/85/98) — la valeur XML n'est que la
         valeur par défaut de premier affichage. Marge haute posée aux
         insets système (v0.32.1) : le tiroir ne passe jamais derrière la
         barre de statut. -->

    <FrameLayout
        android:id="@+id/tiroir"
        android:layout_width="@dimen/editor_tiroir_largeur"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/fond_tiroir">

        <!-- Colonne : fragment courant + rail commun. Le rebord droit de
             13 dp laisse la poignée déborder à moitié (§ 13). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="13dp"
            android:orientation="vertical">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/conteneur_fragments_tiroir"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Rail de fragments (§ 14) : quatre destinations, remplies
                 par EditorActivity (icônes + libellés + état actif). -->
            <LinearLayout
                android:id="@+id/rail_fragments"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@color/explorateur_rail_fond"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Zone du snackbar maison (§ 15) : flottante au-dessus du rail,
             centrée — la vue est gonflée/masquée par le fragment. -->
        <FrameLayout
            android:id="@+id/zone_snackbar_tiroir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="74dp"
            android:paddingHorizontal="10dp" />

        <!-- Poignée ⋮ de redimensionnement (§ 13) : 26 × 78 dp, collée au
             bord droit à mi-hauteur, glissement = bornes/aimants. -->
        <ImageView
            android:id="@+id/poignee_tiroir"
            android:layout_width="26dp"
            android:layout_height="78dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/fond_poignee_tiroir"
            android:contentDescription="@string/poignee_cd"
            android:src="@drawable/ic_poignee_tiroir" />

        <!-- Pastille de taille (§ 13) : au-dessus de la poignée, visible
             pendant le glissement puis fondue. -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/pastille_taille_tiroir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="54dp"
            android:background="@drawable/fond_pastille_taille"
            android:elevation="6dp"
            android:fontFamily="monospace"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="@color/explorateur_accent"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="55 %" />
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
