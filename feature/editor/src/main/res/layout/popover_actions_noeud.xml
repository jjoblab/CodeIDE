<?xml version="1.0" encoding="utf-8"?>
<!--
  Popover maison d'actions d'un nœud (étape 31, § 10, EXPLORATEUR_V2) :
  largeur 258 dp, coque fond_popover + flèche fond_fleche_popover,
  tête (icône, nom ellipsé à 168 dp, chemin absolu mono 10 sp 2 lignes,
  ligne de contexte mono 10 sp accent), puis les lignes d'action
  ajoutées dynamiquement (§ 10.4) avec séparateurs.

  La flèche (12 dp) est positionnée à l'exécution : sous la coque quand
  le popover est sous le point d'ancrage, au-dessus quand il s'est
  retourné (algorithme § 10.2 implémenté dans PopoverExplorateur).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="258dp"
    android:layout_height="wrap_content">

    <!-- Flèche vers la ligne (position posée à l'exécution). -->
    <View
        android:id="@+id/fleche_popover"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/fond_fleche_popover"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/coque_popover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_popover"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Tête (§ 10.3) : icône + nom + chemin + contexte. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="7dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/icone_tete_popover"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_fichier_kotlin" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nom_tete_popover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/explorateur_texte"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="EditorViewModel.kt" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/chemin_tete_popover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/explorateur_texte_3"
            android:textSize="10sp" tools:ignore="SmallSp"
            tools:text="feature/editor/src/main/kotlin/jo/codeide/feature/editor/EditorViewModel.kt" />

        <!-- Ligne de contexte (§ 10.3) : Cible / Déplacement / Créer dans. -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/contexte_popover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/explorateur_accent"
            android:textSize="10sp" tools:ignore="SmallSp"
            android:visibility="gone"
            tools:text="Cible — docs"
            tools:visibility="visible" />

        <!-- Actions (§ 10.4) : ajoutées dynamiquement, séparateur 1 dp. -->
        <LinearLayout
            android:id="@+id/actions_popover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
