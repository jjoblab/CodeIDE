<?xml version="1.0" encoding="utf-8"?>
<!-- Une TÂCHE de la feuille (v4, §3.3) : nom affiché, module d'origine,
     icône d'exécution — l'appui lance la tâche (la feuille se referme). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_md">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/nom_tache_feuille"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="assembleDebug" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/module_tache_feuille"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="app" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:tint="?attr/colorCanalTaches"
        app:srcCompat="@drawable/ic_executer" />
</LinearLayout>
