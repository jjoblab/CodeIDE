<?xml version="1.0" encoding="utf-8"?><!--
  Écran de configuration du tooling Gradle (v3 ; v4, §3.3 : INTÉGRÉ au
  conteneur de la console) — PanneauConfigToolingFragment, enfant du
  PanneauConsoleFragment : flèche retour en tête, vit DANS le panneau
  inférieur (plus de dialogue au-dessus de l'éditeur). Même patron que
  les sections des Paramètres (cartes ADR 0064 : conteneur vertical unique
  par carte, rangées icône + texte + interrupteur, séparateurs 1dp).
  Fond = jeton du panneau inférieur (§8) — la page en fait partie.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/codeide_panneau_inferieur_fond"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_config_tooling"
        style="@style/Widget.CodeIDE.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/editor_config_fermer_cd"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/editor_config_tooling_titre" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_md">

            <!-- Carte 2 — Exécution : mode hors ligne + arguments Gradle
                 libres (voyagent avec chaque build). -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_md"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:text="@string/editor_config_execution"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_outils"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_hors_ligne"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_hors_ligne_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_hors_ligne"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Mission « Exécuter » R2 (ADR 0103) : injection de la
                         bibliothèque de débogage applog-runtime dans les
                         builds debug des projets — le réglage HONNÊTE dit
                         ce qu'elle fait et quand il s'applique. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_terminal"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_injection_applog"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_injection_applog_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_injection_applog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/champ_arguments"
                        style="?attr/textInputFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/editor_config_arguments"
                        app:helperText="@string/editor_config_arguments_aide">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/saisie_arguments"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:imeOptions="actionDone"
                            android:inputType="textNoSuggestions|textVisiblePassword"
                            android:maxLines="1"
                            tools:text="--stacktrace --info" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- INC-31 (Phase 2) : arguments RÉSERVÉS à la sync —
                         vides : la sync retombe sur les arguments généraux
                         ci-dessus (comportement d'avant). -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/champ_arguments_sync"
                        style="?attr/textInputFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:hint="@string/editor_config_arguments_sync"
                        app:helperText="@string/editor_config_arguments_sync_aide">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/saisie_arguments_sync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:imeOptions="actionDone"
                            android:inputType="textNoSuggestions|textVisiblePassword"
                            android:maxLines="1"
                            tools:text="--info" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte 2b — Diagnostic (Phase 1, ADR 0152) : instrumentation
                 de latence + banc « socket seul » — le MINIMUM OBLIGATOIRE
                 de l'INC-32 (drapeau + export). Les mesures rejoignent le
                 journal applicatif, exporté depuis l'écran Diagnostic. -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_md"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:text="@string/editor_config_diagnostic"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_fichier_gradle"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_instru_transport"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_instru_transport_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_instru_transport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_terminal"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_banc"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_banc_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/interrupteur_banc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Paramètres du banc — visibles seulement quand le banc
                         est armé (chacun lu et honoré par le serveur). -->
                    <LinearLayout
                        android:id="@+id/parametres_banc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/champ_banc_lignes"
                            style="?attr/textInputFilledStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/editor_config_banc_lignes"
                            app:helperText="@string/editor_config_banc_lignes_aide">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/saisie_banc_lignes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLines="1"
                                tools:text="60" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/champ_banc_cadence"
                            style="?attr/textInputFilledStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/editor_config_banc_cadence"
                            app:helperText="@string/editor_config_banc_cadence_aide">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/saisie_banc_cadence"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLines="1"
                                tools:text="0" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/champ_banc_longueur"
                            style="?attr/textInputFilledStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/editor_config_banc_longueur"
                            app:helperText="@string/editor_config_banc_longueur_aide">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/saisie_banc_longueur"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLines="1"
                                tools:text="80" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/champ_banc_contenu"
                            style="?attr/textInputFilledStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/editor_config_banc_contenu"
                            app:helperText="@string/editor_config_banc_contenu_aide">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/saisie_banc_contenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionDone"
                                android:inputType="textNoSuggestions|textVisiblePassword"
                                android:maxLines="1"
                                tools:text="plain" />
                        </com.google.android.material.textfield.TextInputLayout>
                    
                        <!-- INC-32 (Phase 2) : niveau de journal du serveur
                             (INFO, WARN ou ERROR — repli INFO), lu à CHAQUE
                             lancement du process. -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/champ_niveau_journal"
                            style="?attr/textInputFilledStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/editor_config_niveau_journal"
                            app:helperText="@string/editor_config_niveau_journal_aide">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/saisie_niveau_journal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionDone"
                                android:inputType="textNoSuggestions|textVisiblePassword"
                                android:maxLines="1"
                                tools:text="INFO" />
                        </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte 3 — État vivant de l'orchestrateur (lecture seule) :
                 connexion et tas observés en direct. -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginVertical="@dimen/spacing_sm"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="@dimen/spacing_md"
                app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:text="@string/editor_config_etat"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_terminal"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:text="@string/editor_config_etat_connexion"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/valeur_connexion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Connecté" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_fichier_gradle"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:text="@string/editor_config_etat_tas"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/valeur_tas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="128 Mo utilisés sur 256 Mo" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/separateur_epaisseur"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- INC-33 (Phase 2) : les réglages « à la prochaine vie
                         du process » s'appliquent À LA DEMANDE — l'état de
                         connexion ci-dessus montre la reconnexion en direct. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_terminal"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_redemarrer"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_config_redemarrer_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bouton_redemarrer"
                            style="@style/Widget.CodeIDE.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_config_redemarrer_bouton" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:paddingHorizontal="@dimen/spacing_xs"
                android:text="@string/editor_config_note_console"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Carte « Banc sorties » (docs/SORTIES_BANC_MESURE.md — PV
                 livrables de L2, ADR 0159) : réglage OPT-IN comme
                 l'instrumentation (coût nul par défaut), ouvre l'écran de
                 diagnostic qui arme la source factice du Centre de
                 sorties. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_config_banc_sorties"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/spacing_xs"
                        android:text="@string/editor_config_banc_sorties_desc"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_banc_sorties"
                        style="@style/Widget.CodeIDE.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/editor_config_banc_sorties_bouton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
