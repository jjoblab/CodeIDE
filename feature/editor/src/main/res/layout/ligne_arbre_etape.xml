<?xml version="1.0" encoding="utf-8"?>
<!-- Rangée d'ÉTAPE de l'arbre de sync (v4, §3.3 ; v5 — plan de l'aperçu ;
     v0.40.1 — correctif n°5 du prompt de suivi : le marqueur d'état en
     cours est désormais un `AnneauTournant` dédié — un drawable
     vectoriel de 16 dp tourné par UN `ObjectAnimator` partagé, pas un
     `CircularProgressIndicator` Material dont l'inset et l'épaisseur
     par défaut (4 dp) sont écrasés à 16 dp (anneau rogné + clignotement
     à chaque rebind du ViewHolder, cf. ADR 0072). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/editor_ligne_hauteur"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_xs"
    android:paddingVertical="6dp">

    <!-- Marqueur d'état : un seul des trois fils visible au rendu
         (v0.40.1 — le marqueur « sautée » est supprimé avec le concept
         « En cache » du prompt de suivi §2 ; un seul animateur partagé
         via AnneauTournantState). -->
    <FrameLayout
        android:layout_width="@dimen/editor_marqueur_etape_taille"
        android:layout_height="@dimen/editor_marqueur_etape_taille"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/marqueur_etape_terminee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="?attr/colorSucces"
            app:srcCompat="@drawable/ic_fait"
            tools:visibility="visible" />

        <!-- Anneau tournant de l'étape en cours (v0.40.1, correctif n°5) :
             un drawable vectoriel 16 dp / trait 2 dp, tourné par un
             ObjectAnimator UNIQUE partagé (AnneauTournantState). Pas
             d'inset Material, pas d'épaisseur par défaut écrasée. La
             couleur du trait est posée par backgroundTintList au rendu
             (couleur de canal harmonisée). -->
        <jo.codeide.feature.editor.AnneauTournant
            android:id="@+id/marqueur_etape_en_cours"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:id="@+id/marqueur_etape_attente"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cercle_attente_etape"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/libelle_etape_arbre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textSize="12sp"
        tools:text="Dépendances et modèle IDE" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/duree_etape_arbre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="6,1s" />
</LinearLayout>
