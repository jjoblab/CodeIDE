<?xml version="1.0" encoding="utf-8"?>
<!-- Détail de TÉLÉCHARGEMENT sous l'étape active de l'arbre de sync (v4,
     §3.3) : barre de progression (déterminée quand le total est connu),
     « octets reçus / total · compteur n/N », artefact courant. Indenté SOUS
     son étape (retrait = hiérarchie visuelle de l'arbre aplati). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/editor_retrait_detail_etape"
    android:paddingEnd="@dimen/spacing_xs"
    android:paddingVertical="@dimen/spacing_xs">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barre_telechargement_etape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/detail_telechargement_etape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="42 Mo / 130 Mo · 3 / 37" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/element_telechargement_etape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="↓ kotlin-stdlib-2.2.10.jar"
        tools:visibility="visible" />
</LinearLayout>
