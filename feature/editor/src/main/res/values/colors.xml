<!--
  Couleurs des niveaux du journal compact du panneau inférieur (étape 16) —
  variantes jour/nuit pour un contraste garanti (mêmes valeurs que l'écran
  Diagnostic, dont les ressources ne sont pas partagées entre features).
-->
<resources>
    <color name="journal_compact_debug">#5F6368</color>
