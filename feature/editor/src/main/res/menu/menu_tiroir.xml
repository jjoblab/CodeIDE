<?xml version="1.0" encoding="utf-8"?>
<!-- Barre de navigation basse du tiroir (prompt compagnon 5.3) : Explorateur
     active, Recherche et Git visibles mais désactivées.

     Correctif v0.19.0 : ce menu vivait en <menu> inline dans
     activity_editor.xml — LayoutInflater ne sait pas gonfler un élément
     <menu> dans un layout (ClassNotFoundException android.view.menu,
     plantage à l'ouverture de EditorActivity). Un menu de navigation se
     déclare dans res/menu/ et se rattache par app:menu. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/destination_explorateur"
        android:enabled="true"
        android:icon="@drawable/ic_explorateur"
        android:title="@string/editor_nav_explorateur" />

    <item
        android:id="@+id/destination_recherche"
        android:enabled="false"
        android:icon="@drawable/ic_recherche"
        android:title="@string/editor_nav_recherche" />

    <item
        android:id="@+id/destination_git"
        android:enabled="false"
        android:icon="@drawable/ic_git"
        android:title="@string/editor_nav_git" />
</menu>
