<?xml version="1.0" encoding="utf-8"?>
<!-- Actions de la toolbar de l'espace de travail (étape 15 ; v0.41.1 :
     bouton Run dédié pour fun main()). -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_run"
        android:icon="@drawable/ic_executer"
        android:title="@string/editor_run"
        android:visible="false"
        app:iconTint="@color/codeide_canal_build"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_synchroniser"
        android:icon="@drawable/ic_synchroniser"
        android:title="@string/editor_synchroniser"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_executer"
        android:icon="@drawable/ic_executer"
        android:title="@string/editor_executer"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_enregistrer"
        android:icon="@drawable/ic_enregistrer"
        android:title="@string/editor_enregistrer"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:showAsAction="ifRoom" />

    <!-- Mission « LSP Java » h2 (§16.2) : revalidation des segments
         d'index + auto-guérison — visible quand une session LSP vit. -->
    <item
        android:id="@+id/action_reindexer"
        android:title="@string/editor_lsp_reindexer"
        android:visible="false"
        app:showAsAction="never" />

    <!-- Mission « Previews » PE1 → PE6-0 : ouverture de l'écran d'aperçu
         DÉDIÉ (:feature:preview, maquette docs/mockups/apercu-xml.html) —
         visible quand l'onglet actif est previewable (res/layout ou
         racine de layout) ; le rendu vit dans :preview:xml (LayoutLib,
         fil dédié, bitmap off-screen). -->
    <item
        android:id="@+id/action_apercu"
        android:title="@string/editor_action_apercu"
        android:visible="false"
        app:showAsAction="never" />

    <!-- CE3 (B10) : recherche/remplacement dans le fichier. -->
    <item
        android:id="@+id/action_rechercher"
        android:title="@string/editor_rechercher"
        app:showAsAction="never" />

    <!-- ADR 0136 (P1-b) : mise en forme du document PAR LE SERVEUR de
         langue de l'onglet actif (Java, XML — Kotlin ne l'annonce pas
         encore) ; la commande clavier physique vivait déjà côté
         bibliothèque, rien ne l'offrait au TOUCHER. Visible quand une
         session de langue vit (phase 1 — canFormat() en phase 2). -->
    <item
        android:id="@+id/action_formater"
        android:icon="@drawable/ic_formater"
        android:title="@string/editor_formater"
        android:visible="false"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:showAsAction="ifRoom" />

    <!-- CE7 (B14) : pliage de masse — tout replier / tout déplier. -->
    <item
        android:id="@+id/action_tout_replier"
        android:title="@string/editor_tout_replier"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_tout_deplier"
        android:title="@string/editor_tout_deplier"
        app:showAsAction="never" />

    <!-- Fermeture de l'espace de travail (étape 31) : l'action vivait
         dans l'entête v1 du tiroir, elle rejoint le débordement de la
         toolbar depuis l'architecture à fragments. -->
    <item
        android:id="@+id/action_fermer_projet"
        android:title="@string/editor_tiroir_fermer_projet"
        app:showAsAction="never" />

    <!-- Mission « Cycle de vie » étape E (P3) : le parcours
         éditeur → paramètres → retour était INEXISTANT — le routage
         ADR 0048 remonte l'hôte du graphe, la session survit dessous
         (I3) et les réglages se propagent au retour. -->
    <item
        android:id="@+id/action_parametres"
        android:title="@string/editor_parametres"
        app:showAsAction="never" />
</menu>
