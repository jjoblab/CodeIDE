<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de la ligne sélectionnée de l'arbre (étape 31, § 6.1,
     docs/EXPLORATEUR_V2.md) : dégradé accent-doux → transparent sur 72 %
     de la largeur, barre interne 2,5 dp accent-fort collée au bord de
     départ sur TOUTE la hauteur, rayon 7 dp.

     Réplique de `.ligne.sel` de la maquette (dégradé + box-shadow
     `inset 2,5px 0 0`) : la barre est un calque de largeur FIXE
     (android:width sur l'item, requis — un <size> sur le shape ne borne
     pas la couche, qui s'étirerait pleine largeur) ancré au bord de
     départ ; ses coins gauche suivent le rayon de la ligne (v0.32.1). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Dégradé accent-doux → transparent (§ 6.1) : la teinte
                 s'efface d'elle-même sur ~72 % de la largeur, un inset
                 en pourcentage étant interdit par AAPT. -->
            <gradient
                android:angle="0"
                android:startColor="@color/explorateur_accent_doux"
                android:endColor="@android:color/transparent" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item
        android:gravity="start|fill_vertical"
        android:width="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/explorateur_accent_fort" />
            <corners
                android:bottomLeftRadius="7dp"
                android:topLeftRadius="7dp" />
        </shape>
    </item>
</layer-list>
