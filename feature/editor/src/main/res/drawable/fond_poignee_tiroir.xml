<?xml version="1.0" encoding="utf-8"?>
<!-- Poignée ⋮ de redimensionnement (étape 31, § 13) : pilule 26 × 78 dp,
     état appuyé = fond #2C3644 + bordure accent-fort (couleurs via
     state list). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/explorateur_poignee_fond_actif" />
            <stroke android:width="1dp" android:color="@color/explorateur_accent_fort" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/explorateur_fond_surface_2" />
            <stroke android:width="1dp" android:color="@color/explorateur_poignee_bordure" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
