<?xml version="1.0" encoding="utf-8"?>
<!-- Poignée ⋮ de redimensionnement (étape 31, § 13) : pilule 26 × 78 dp,
     état appuyé = fond surface-active + bordure accent-fort (couleurs
     sémantiques centralisées dans core:ui, via state list). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/codeide_explorateur_poignee_fond_actif" />
            <stroke android:width="1dp" android:color="@color/codeide_explorateur_accent_fort" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/codeide_explorateur_fond_surface_2" />
            <stroke android:width="1dp" android:color="@color/codeide_explorateur_poignee_bordure" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
