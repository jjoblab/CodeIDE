<?xml version="1.0" encoding="utf-8"?>
<!-- Barre presse-papiers sous l'arbre (étape 31, § 12) : fond vert doux,
     bordure haute 1 dp vert 25 %. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/codeide_explorateur_barre_presse_papiers" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/codeide_explorateur_vert_doux" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
