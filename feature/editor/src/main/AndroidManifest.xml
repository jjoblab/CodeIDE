<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Espace de travail de l'éditeur (étape 13) : activité séparée de
         MainActivity, jamais exposée hors de l'application. supportsRtl :
         les layouts utilisent des attributs start/end — la valeur est
         fusionnée avec celle de l'application (true). -->
    <application android:supportsRtl="true">
        <activity
            android:name="jo.codeide.feature.editor.EditorActivity"
            android:exported="false"
            android:label="@string/editor_title" />
    </application>

</manifest>
