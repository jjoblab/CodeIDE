<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran d'accueil (étape 7, variante sw600dp) : recherche avec délai, tri, bandeau du
  dossier de travail, liste des projets (2 colonnes tablette/paysage) et groupe
  d'actions flottantes — « Nouveau projet » et « Ouvrir un dossier
  existant ». Les états (chargement, vide, sans résultat, erreur) sont
  superposés au contenu et pilotés par l'état du ViewModel.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine_accueil"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/colonne_accueil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Titre et actions : terminal intégré (T6) + réglages. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/home_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <!-- Terminal intégré (T6) : même action que la variante téléphone. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_terminal"
                style="@style/Widget.CodeIDE.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:contentDescription="@string/home_open_terminal"
                app:icon="@drawable/ic_terminal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings"
                style="@style/Widget.CodeIDE.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/home_open_settings"
                app:icon="@drawable/ic_parametres" />
        </LinearLayout>

        <!-- Recherche (avec délai de fusion des frappes). -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/champ_recherche"
            style="@style/Widget.CodeIDE.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_sm"
            android:hint="@string/accueil_recherche_indication"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_recherche">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/saisie_recherche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tri : les épingles flottent toujours en tête. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupe_tri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_tri_recents"
                style="@style/Widget.CodeIDE.Button.Outlined.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/accueil_tri_recents" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_tri_nom"
                style="@style/Widget.CodeIDE.Button.Outlined.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accueil_tri_nom" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Bandeau « Configurer le dossier de travail » (étape 5). -->
        <include
            android:id="@+id/bandeau_dossier"
            layout="@layout/bandeau_dossier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Contenu : tirer-relâcher pour revérifier les états d'accès. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/rafraichissement_accueil"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/liste_projets"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/screen_horizontal_margin"
                    android:paddingBottom="@dimen/marge_bas_fab"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_projet" />

                <!-- État vide / sans résultat (l'action dépend de l'état). -->
                <LinearLayout
                    android:id="@+id/colonne_etat_vide"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <jo.codeide.core.ui.EmptyStateView
                        android:id="@+id/etat_vide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:stateIcon="@drawable/ill_accueil_vide"
                        app:stateMessage="@string/accueil_vide_message"
                        app:stateTitle="@string/accueil_vide_titre" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bouton_etat_vide_action"
                        style="@style/Widget.CodeIDE.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/accueil_vide_action" />
                </LinearLayout>

                <jo.codeide.core.ui.ErrorStateView
                    android:id="@+id/etat_erreur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:stateIcon="@drawable/ic_avertissement"
                    app:stateMessage="@string/accueil_erreur_registre_message"
                    app:stateTitle="@string/accueil_erreur_registre_titre"
                    tools:visibility="gone" />

                <jo.codeide.core.ui.LoadingView
                    android:id="@+id/etat_chargement"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:stateMessage="@string/accueil_chargement"
                    tools:visibility="visible" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Groupe d'actions flottantes : bouton étendu « Nouveau projet »
         (vers le wizard, étape 10) et, au-dessus, « Ouvrir un dossier
         existant » (SAF, ajoute le projet au registre). -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_nouveau_projet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_horizontal_margin"
        android:contentDescription="@string/accueil_nouveau_projet"
        android:text="@string/accueil_nouveau_projet"
        app:icon="@drawable/ic_ajouter"
        app:layout_dodgeInsetEdges="bottom" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_ouvrir_dossier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:contentDescription="@string/accueil_ouvrir_dossier"
        android:src="@drawable/ic_ouvrir_dossier"
        app:layout_anchor="@id/fab_nouveau_projet"
        app:layout_anchorGravity="top|end"
        app:layout_dodgeInsetEdges="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
