<?xml version="1.0" encoding="utf-8"?>
<!--
  Dialogue « Cloner un dépôt » (Git G5, v0.80.4) — équivalent mobile du
  « Get from VCS » d'Android Studio : URL du dépôt + nom du dossier cible
  (pré-rempli depuis l'URL, éditable). Le dossier est créé SOUS le dossier
  de travail — jamais de destination libre en v1.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_md">

    <!-- URL du dépôt (HTTPS). -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/champ_url_clone"
        style="@style/Widget.CodeIDE.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/accueil_cloner_url"
        app:startIconDrawable="@drawable/ic_git">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/saisie_url_clone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nom du dossier cible (auto-rempli depuis l'URL, éditable). -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/champ_nom_clone"
        style="@style/Widget.CodeIDE.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:hint="@string/accueil_cloner_nom"
        app:helperText="@string/accueil_cloner_nom_aide"
        app:startIconDrawable="@drawable/ic_dossier_code">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/saisie_nom_clone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
