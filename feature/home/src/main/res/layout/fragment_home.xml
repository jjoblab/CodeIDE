<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Bandeau « Configurer le dossier de travail » (étape 5) : caché
         tant que l'assistant n'est pas terminé sans dossier. -->
    <include
        android:id="@+id/bandeau_dossier"
        layout="@layout/bandeau_dossier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/home_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:text="@string/home_title"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/home_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/home_placeholder"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_settings"
        style="@style/Widget.CodeIDE.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:text="@string/home_open_settings" />

</LinearLayout>
