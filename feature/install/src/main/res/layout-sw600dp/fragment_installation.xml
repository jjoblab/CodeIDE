<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'installation, tablette sw600dp (E5, § 7) : stepper à gauche,
     journal en direct à droite (toujours visible). Mêmes identifiants que
     le layout téléphone — une seule classe de liaison ViewBinding.
     Lot UI-4 (audit C1/C3/C4, ADR 0127) : jetons, cartes, boutons maison. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                style="?attr/textAppearanceHeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/installation_titre_nouveau" />

            <TextView
                style="?attr/textAppearanceBodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/installation_sous_titre" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md_compact"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/compteur_phases"
                    style="?attr/textAppearanceLabelLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/installation_progression_exemple" />

                <TextView
                    android:id="@+id/sous_etape"
                    style="?attr/textAppearanceBodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progression_globale"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:max="4" />

            <TextView
                android:id="@+id/vitesse_telechargement"
                style="?attr/textAppearanceBodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md_compact"
                app:contentPadding="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/carte_bootstrap"
                        layout="@layout/carte_phase_installation" />

                    <include
                        android:id="@+id/carte_outils"
                        layout="@layout/carte_phase_installation" />

                    <include
                        android:id="@+id/carte_java"
                        layout="@layout/carte_phase_installation" />

                    <include
                        android:id="@+id/carte_android"
                        layout="@layout/carte_phase_installation" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carte_licence"
                style="@style/Widget.CodeIDE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md_compact"
                android:visibility="gone"
                app:contentPadding="@dimen/spacing_md_compact">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="?attr/textAppearanceTitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/installation_licence_titre" />

                    <TextView
                        style="?attr/textAppearanceBodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/installation_licence_texte" />

                    <CheckBox
                        android:id="@+id/case_licence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/installation_licence_case" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_demarrer"
                style="@style/Widget.CodeIDE.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md_compact"
                android:text="@string/installation_demarrer" />

            <TextView
                android:id="@+id/resume_versions"
                style="?attr/textAppearanceBodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_premier_projet"
                style="@style/Widget.CodeIDE.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/installation_premier_projet"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_annuler"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/installation_env_annuler"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_reessayer"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/installation_env_reessayer"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_diagnostic"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/installation_diagnostic" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bouton_terminal"
                    style="@style/Widget.CodeIDE.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/installation_terminal" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_journal"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/installation_journal_basculer" />
        </LinearLayout>
    </ScrollView>

    <!-- Panneau droit (journal en direct, toujours visible sur tablette,
         § 7) : NestedScrollView pour uniformiser le type ViewBinding avec
         la variante téléphone (un seul FragmentInstallationBinding) et
         bénéficier du scrolling imbriqué fluide. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/zone_journal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/journal"
            style="?attr/textAppearanceBodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="@dimen/spacing_md_compact"
            android:textIsSelectable="true" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
