    <string name="installation_titre">Install the terminal environment</string>
    <string name="installation_invite_texte">The integrated terminal sets up a Linux environment inside the app\'s private storage: shell, package manager and updated repository — the environment configuration (Java, Android SDK) then starts automatically in the terminal.</string>
    <string name="installation_invite_poids">About 40 MB for the base environment, then Java and the Android SDK in the terminal (~400 MB overall). A network connection is required.</string>
    <string name="installation_section_base">Base environment</string>
    <string name="installation_invite_base">Linux shell, package manager and CodeIDE repository — installed mandatorily, the repository is updated (apt update) at the end.</string>
    <string name="installation_section_outils">Development environment</string>
    <string name="installation_invite_outils">Java (OpenJDK) and the Android SDK — installed automatically in the terminal right after the base environment: the progress streams there live, and every step resumes where it left off after an interruption.</string>
    <string name="installation_outils_attente">Installed automatically in the terminal after the base environment.</string>
    <string name="installation_outil_statut_attente">not installed (optional)</string>
