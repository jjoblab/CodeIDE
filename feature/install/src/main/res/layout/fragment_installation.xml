<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'installation de l'environnement (E5, § 7, ADR 0089) : en-tête
     avec progression globale, stepper de 4 cartes, consentement licence,
     journal repliable, actions contextuelles, récapitulatif final.
     Lot UI-4 (audit C1/C3/C4, ADR 0127) : jetons d'espacement, cartes
     Widget.CodeIDE.Card, boutons Widget.CodeIDE.Button.* — zéro littéral. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            style="?attr/textAppearanceHeadlineSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/installation_titre_nouveau" />

        <TextView
            style="?attr/textAppearanceBodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:text="@string/installation_sous_titre" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md_compact"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/compteur_phases"
                style="?attr/textAppearanceLabelLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/installation_progression_exemple" />

            <TextView
                android:id="@+id/sous_etape"
                style="?attr/textAppearanceBodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progression_globale"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:max="4" />

        <TextView
            android:id="@+id/vitesse_telechargement"
            style="?attr/textAppearanceBodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CodeIDE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md_compact"
            app:contentPadding="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/carte_bootstrap"
                    layout="@layout/carte_phase_installation" />

                <include
                    android:id="@+id/carte_outils"
                    layout="@layout/carte_phase_installation" />

                <include
                    android:id="@+id/carte_java"
                    layout="@layout/carte_phase_installation" />

                <include
                    android:id="@+id/carte_android"
                    layout="@layout/carte_phase_installation" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/carte_licence"
            style="@style/Widget.CodeIDE.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md_compact"
            android:visibility="gone"
            app:contentPadding="@dimen/spacing_md_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="?attr/textAppearanceTitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/installation_licence_titre" />

                <TextView
                    style="?attr/textAppearanceBodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/installation_licence_texte" />

                <CheckBox
                    android:id="@+id/case_licence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/installation_licence_case" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_demarrer"
            style="@style/Widget.CodeIDE.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md_compact"
            android:text="@string/installation_demarrer" />

        <TextView
            android:id="@+id/resume_versions"
            style="?attr/textAppearanceBodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_premier_projet"
            style="@style/Widget.CodeIDE.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/installation_premier_projet"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_annuler"
                style="@style/Widget.CodeIDE.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/installation_env_annuler"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_reessayer"
                style="@style/Widget.CodeIDE.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/installation_env_reessayer"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_diagnostic"
                style="@style/Widget.CodeIDE.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/installation_diagnostic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_terminal"
                style="@style/Widget.CodeIDE.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/installation_terminal" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_journal"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/installation_journal_basculer" />

        <!-- Journal en direct repliable (E5, § 7) : NestedScrollView à
             hauteur bornée pour que la sortie défile DANS sa propre zone
             sans pousser le reste de l'écran (stepper, licence, actions).
             Même id `zone_journal` que la variante sw600dp (un seul
             FragmentInstallationBinding) ; l'auto-défilement reste collé
             au bas (InstallationFragment). -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/zone_journal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hauteur_journal_installation"
            android:layout_marginTop="@dimen/spacing_xs"
            android:scrollbars="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/journal"
                style="?attr/textAppearanceBodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="@dimen/spacing_sm"
                android:textIsSelectable="true" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</ScrollView>
