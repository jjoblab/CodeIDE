<?xml version="1.0" encoding="utf-8"?>
<!-- Rangée d'un outil de développement (v0.31.4) : nom du paquet + état
     (en attente / en cours / installé / absent), gonflée par
     InstallFragment pour la phase d'outils et le résultat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="20dp">

        <ImageView
            android:id="@+id/icone_outil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/etape_attente"
            tools:src="@drawable/etape_faite" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/rotation_outil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/libelle_outil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textStyle="bold"
        tools:text="openjdk-17" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/statut_outil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="requis pour compiler" />

</LinearLayout>
