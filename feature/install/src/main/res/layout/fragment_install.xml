<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran d'installation du bootstrap natif (étape T3) : invite, progression
  détaillée (sections « Environnement de base » / « Outils de
  développement » + journal en direct), résultat par outil, erreurs
  typées avec détails dépliables.

  Refonte v0.31.4 (rapport d'appareil réel : « l'écran ne se met pas à
  jour correctement » + « les étapes rangées pour un design plus
  professionnel ») : progression structurée en DEUX sections — l'une
  obligatoire (huit étapes du pipeline jusqu'à `apt update`, ADR 0048),
  l'autre optionnelle (paquets d'outils, installés à la demande) —
  en-tête d'étape courante avec compteur, journal en direct sous carte
  (rafraîchi en continu depuis la v0.31.4) et résultat en deux temps :
  environnement prêt, puis proposition claire des outils avec leurs
  statuts.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/installation_titre"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <!-- Invite : ce qu'apporte l'environnement, son poids, et le
             découpage base / outils optionnels. -->
        <LinearLayout
            android:id="@+id/invite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/installation_invite_texte"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/installation_invite_poids"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Aperçu structuré : la base (obligatoire), les outils
                 (optionnels, proposés plus tard). -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/installation_section_base"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/installation_invite_base"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/installation_section_outils"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/installation_invite_outils"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/texte_annulee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/installation_annulee"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Progression détaillée : en-tête d'étape courante (libellé +
             compteur + barre), puis les deux sections de la checklist. -->
        <LinearLayout
            android:id="@+id/progression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_etape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Téléchargement de l'archive…" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_detail_etape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone"
                tools:text="12,4 Mo sur 43,0 Mo"
                tools:visibility="visible" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/barre_progression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <!-- Section 1 : environnement de base (obligatoire) — rangées
                 créées par le fragment. -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/titre_section_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/installation_section_base"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <LinearLayout
                android:id="@+id/conteneur_etapes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical"
                tools:background="@android:color/transparent" />

            <!-- Section 2 : outils de développement (optionnels) —
                 statuts créés par le fragment. -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/titre_section_outils"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/installation_section_outils"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_outils_attente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/installation_outils_attente"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/conteneur_outils"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical"
                tools:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Journal en direct : sortie réelle des sous-processus. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/carte_journal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/installation_journal_titre"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                <!-- v0.31.5 (CI lint NestedScrolling) : NestedScrollView —
                     conçu pour l'imbrication, la carte garde sa hauteur
                     fixe et le journal défile en son sein ; le conteneur
                     externe reste LE défilement vertical de l'écran. -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/defilement_journal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hauteur_journal_installation"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:overScrollMode="never">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/texte_journal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Atteint :1 stable Release&#10;Lecture des listes de paquets…" />
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Résultat : environnement prêt, statuts des outils, proposition
             d'installation immédiate ou différée. -->
        <LinearLayout
            android:id="@+id/resultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/installation_terminee_base"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/installation_terminee_base_detail"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_outils_requis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/installation_outils_requis_detail"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/conteneur_resultat_outils"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                tools:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Échec (base OU outils) : message actionnable + détails
             techniques dépliables. -->
        <LinearLayout
            android:id="@+id/echec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_erreur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Réseau indisponible." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_details"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/installation_details_titre"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/texte_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="apt update → code 100 — E: dépôt injoignable"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/conteneur_echec_outils"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                android:visibility="gone"
                tools:background="@android:color/transparent"
                tools:visibility="visible" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_installer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/installation_installer" />

        <!-- Phase résultat : installe les outils optionnels maintenant
             (sinon « Fermer » — les fonctionnalités les proposeront). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_installer_outils"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/installation_installer_outils"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_annuler"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/installation_annuler"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_fermer"
            style="@style/Widget.CodeIDE.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/installation_fermer"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>
