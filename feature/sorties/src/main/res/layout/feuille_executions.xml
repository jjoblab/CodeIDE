<?xml version="1.0" encoding="utf-8"?>
<!-- La feuille d'HISTORIQUE des exécutions (lot L6, M11 entrée — ADR
     0161) : les exécutions conservées du registre, la plus récente
     d'abord, consultables dans le lecteur (relecture seule). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_lg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/sorties_marge_h"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/sorties_historique_titre"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <!-- L'état vide honnête (règle 14) : dit pourquoi, propose la
                 suite — avant la première exécution conservée. -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/historique_vide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="@string/sorties_historique_vide"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Une rangée par exécution (au plus la rétention réglée) —
                 ajoutées programmatiquement (feuille M11, pas un écran). -->
            <LinearLayout
                android:id="@+id/conteneur_executions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="UselessLeaf" />

            <!-- Effacement EXPLICITE de tout l'historique (M11/M13) —
                 confirmé par dialogue avant l'appel au registre. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/historique_effacer"
                style="@style/Widget.CodeIDE.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sorties_historique_effacer"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
