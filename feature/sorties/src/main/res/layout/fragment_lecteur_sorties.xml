<?xml version="1.0" encoding="utf-8"?>
<!-- Le lecteur du Centre de sorties (ADR 0159/0162, lot L2) : barre
     d'outils unifiée (recherche n/N, regex, pause, horodatage, numéros,
     retour à la ligne, sélection, effacer), bandeaux d'état (pertes,
     masquées, pause — honnêteté règle 14), lecteur virtualisé (liste +
     poignée à repères), bouton « ⇣ suivre » du suivi du bas honnête.
     Fragment FragmentLecteurSorties — les surfaces (onglet/plein écran/
     panneau, L5) l'embarquent comme UNE fenêtre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===================== Barre d'outils (spec SORTIES § 2) ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_2xs">

        <EditText
            android:id="@+id/champ_recherche"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/fond_outil_sorties"
            android:fontFamily="monospace"
            android:hint="@string/sorties_recherche_indice"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingHorizontal="@dimen/spacing_md_compact"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <!-- Option regex : le motif du champ devient une expression
             régulière (erreur signalée en ligne — héritage FiltreLogcat). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_regex"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_regex"
            android:fontFamily="monospace"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/sorties_regex_marque"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <!-- Compteur « n/N » de la recherche. -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/compteur_recherche"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            tools:text="3/27" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_correspondance_precedente"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_correspondance_precedente"
            app:icon="@drawable/ic_correspondance_haut"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_correspondance_suivante"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_correspondance_suivante"
            app:icon="@drawable/ic_suivre_bas"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_pause"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_pause"
            app:icon="@drawable/ic_pause_sorties"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_horodatage"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_horodatage"
            app:icon="@drawable/ic_horodatage"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_numeros"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_numeros"
            app:icon="@drawable/ic_numeros"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_retour_ligne"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_retour_ligne"
            app:icon="@drawable/ic_retour_ligne"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_selection"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_selection"
            app:icon="@drawable/ic_selection"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_effacer"
            style="@style/Widget.CodeIDE.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_effacer"
            app:icon="@drawable/ic_effacer"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <!-- La copie de la sélection (toujours explicite — spec § 3.6). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_copier"
            style="@style/Widget.CodeIDE.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sorties_copier_selection"
            android:text="@string/sorties_copier_selection"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Ligne d'erreur de motif regex (héritage FiltreLogcat : jamais
         d'exception — l'écart est honnête, en ligne). -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/erreur_motif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_2xs"
        android:text="@string/sorties_recherche_motif_invalide"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- ===================== Bandeaux d'état (règle 14) ============== -->
    <jo.codeide.core.ui.BandeauSorties
        android:id="@+id/bandeau_pertes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_2xs"
        app:bandeauSortiesEtat="erreur"
        android:visibility="gone"
        tools:text="2 000 lignes perdues"
        tools:visibility="visible" />

    <jo.codeide.core.ui.BandeauSorties
        android:id="@+id/bandeau_masquees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_2xs"
        app:bandeauSortiesEtat="avertissement"
        android:visibility="gone"
        tools:text="148 lignes masquées par le filtre"
        tools:visibility="visible" />

    <jo.codeide.core.ui.BandeauSorties
        android:id="@+id/bandeau_pause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_2xs"
        app:bandeauSortiesEtat="neutre"
        app:bandeauSortiesTitre="@string/sorties_pause_bandeau"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- ===================== Lecteur (le moteur, ADR 0159) =========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_2xs"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/liste_sorties"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingEnd="@dimen/sorties_rail_largeur"
            tools:listitem="@layout/ligne_sortie" />

        <jo.codeide.feature.sorties.PoigneeDefilement
            android:id="@+id/poignee_sorties"
            android:layout_width="@dimen/sorties_rail_largeur"
            android:layout_height="match_parent"
            android:layout_gravity="end" />

        <!-- Le bouton du suivi du bas honnête (spec § 3.2) : ré-apparaît
             dès que l'utilisateur remonte. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_suivre"
            style="@style/Widget.CodeIDE.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_sm"
            android:text="@string/sorties_suivre_le_bas"
            app:icon="@drawable/ic_suivre_bas"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
