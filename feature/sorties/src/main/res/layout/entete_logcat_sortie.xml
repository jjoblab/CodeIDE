<?xml version="1.0" encoding="utf-8"?>
<!-- L'en-tête d'UN groupe LOGCAT de la vue regroupée (spec SORTIES
     § 5.4 M5, lot L5) : le contenu de la ligne représentée (run répétée
     « ×N » ou tête de trace repliée), le badge honnête (×N répétitions ou
     « N lignes · k causes »), le chevron de repli. L'appui bascule le
     repli (le contenu reste dans le tampon ; à repli fermé, les causes
     « Caused by » d'une trace restent affichées). -->
    <!-- La teinte d'en-tête EST le design (contraste avec les rangées) ;
         l'« overdraw » prétendu s'appuie sur un thème inféré inexact —
         le lecteur est gonflé dans un fragment (lint Overdraw). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceVariant"
    tools:ignore="Overdraw"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/sorties_marge_h"
    android:paddingVertical="@dimen/spacing_2xs">

    <TextView
        android:id="@+id/chevron_entete_logcat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/sorties_repli_ouvert"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/texte_entete_logcat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/badge_entete_logcat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:fontFamily="monospace"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
