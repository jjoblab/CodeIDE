<?xml version="1.0" encoding="utf-8"?>
<!-- L'écran de diagnostic « banc sorties » (docs/SORTIES_BANC_MESURE.md,
     lot L2 — ADR 0159 : les PV du banc sont des livrables de L2) : la
     carte de la configuration tooling ouvre CET écran non exporté, qui
     arme une séquence calibrée de la source factice et héberge le lecteur
     du Centre de sorties. Compteurs d'honnêteté affichés en direct
     (lignes ingérées, pertes, masquées) — la vérité du banc (§ 4.2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barre_banc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/sorties_banc_titre"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextAppearance="?attr/textAppearanceTitleSmall" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/avertissement_banc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_xs"
        android:text="@string/sorties_banc_avertissement"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="?attr/textAppearanceLabelSmall" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/champ_sequence"
            style="@style/Widget.CodeIDE.TextField.Dropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/sorties_banc_sequence">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/saisie_sequence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_lancer"
            style="@style/Widget.CodeIDE.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/sorties_banc_lancer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_arreter"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/sorties_banc_arreter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_rejouer"
            style="@style/Widget.CodeIDE.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/sorties_banc_rejouer" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/compteurs_banc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_xs"
        android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        tools:text="0 lignes ingérées · 0 pertes · 0 masquées" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/conteneur_lecteur"
        android:name="jo.codeide.feature.sorties.FragmentLecteurSorties"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
