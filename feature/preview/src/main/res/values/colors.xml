<?xml version="1.0" encoding="utf-8"?>
<!--
  Jetons de couleur de l'APERÇU — clair (PE11a, ADR 0131). Valeurs EXACTES du bloc `:root` de
  la maquette (`docs/mockups/apercu-xml.html`) ; le test de parité (`JetonsMaquetteTest`)
  compare chaque ligne à `docs/mockups/ref/jetons-maquette.json`. Les layouts, drawables et
  styles lisent ces couleurs via les attributs de thème `?attr/apercu*` (règle 3 de
  `docs/PREVIEW_UI.md` § 10), jamais par un hexadécimal.
-->
<resources>
    <color name="apercu_fond">#F9F9FF</color>  <!-- bg -->
