<?xml version="1.0" encoding="utf-8"?>
<!--
  La rangée d'EXTRACTION en ressource (PE9b, PE8c, habillé PE11b aux
  jetons) : le bouton révèle le champ du nom (pré-rempli par
  ExtractionRessource.nomPropose) et le bouton de validation — littéral
  + session strings.xml ouverte du même projet. Les deux boutons suivent
  le style lien miniature de la maquette (`.linkbtn`, 12 / 500, accent).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee_extraction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_extraire"
        style="@style/Widget.CodeIDE.Apercu.BoutonLien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/champ_nom_ressource"
        style="@style/Widget.CodeIDE.Apercu.Champ"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_correctif_gap"
        android:layout_weight="1"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_valider_extraction"
        style="@style/Widget.CodeIDE.Apercu.BoutonLien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_correctif_gap"
        android:visibility="gone" />
</LinearLayout>
