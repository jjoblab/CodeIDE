<?xml version="1.0" encoding="utf-8"?>
<!--
  Le CONTENU de la bulle de palette (PE9e, miroir `.bubble` de la
  maquette) : l'icône vectorielle 24 dp centrée — le FOND violet et
  l'élévation restent portés par la vue (fond_bulle, activity_preview).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/icone_bulle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bulle_palette"
        tools:ignore="UseAppTint" />
</merge>
