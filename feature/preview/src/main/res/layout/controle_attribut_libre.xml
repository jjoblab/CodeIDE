<?xml version="1.0" encoding="utf-8"?>
<!--
  Section « Autres attributs » (PE11h, maquette `.other`) : une rangée par
  attribut non couvert par les contrôles (nom en mono 12 tronqué, valeur
  éditable, bouton de suppression), puis la rangée d'AJOUT (nom à complétion
  + valeur + « Ajouter »), grille 1fr | 1fr | auto, écart 6 dp. Les rangées
  existantes viennent de `item_attribut_libre`, gonflées dans
  `liste_attributs_libres` ; la rangée d'ajout ne se montre qu'en mode Tous
  (posé au liage). L'écart entre les deux listes suit le séparateur
  `apercu_espace_controles` (9 dp, miroir l'écart des contrôles).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controle_attribut_libre"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/apercu_espace_controles"
    android:orientation="vertical"
    android:showDividers="middle">

    <LinearLayout
        android:id="@+id/liste_attributs_libres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/apercu_espace_controles"
        android:orientation="vertical"
        android:showDividers="middle" />

    <LinearLayout
        android:id="@+id/rangee_ajout_attribut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/champ_nouveau_nom"
            style="@style/Widget.CodeIDE.Apercu.Champ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/preview_attr_nom_hint"
            android:inputType="textNoSuggestions"
            android:popupBackground="@drawable/fond_menu_apercu" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/champ_nouvelle_valeur"
            style="@style/Widget.CodeIDE.Apercu.Champ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/apercu_couleur_gap"
            android:layout_weight="1"
            android:hint="@string/preview_attr_valeur_hint"
            android:imeOptions="actionDone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bouton_ajouter_attribut"
            style="@style/Widget.CodeIDE.Apercu.BoutonLien"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/apercu_couleur_gap"
            android:text="@string/preview_attr_ajouter" />
    </LinearLayout>
</LinearLayout>
