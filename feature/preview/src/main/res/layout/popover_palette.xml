<?xml version="1.0" encoding="utf-8"?>
<!--
  PALETTE de widgets — RÉFÉRENCE (ADR 0134), remplace popover_palette.xml. Miroir de `.pop.pal`.
  Géométrie : marge gauche/droite 10 dp, haut 8 dp sous la rangée de puces, bas 12 dp, hauteur
  min(600 dp, hauteur disponible) IMPOSÉE par le code (le LinearLayout enveloppe son contenu : sans borne
  la grille déborde de l'écran). Coque OPAQUE (apercu_popover_fond), padding 12, espacement 10.
  Écarts avec le fichier actuel : coque et espacements ; en-tête 36 dp avec puce 28 dp ; mode = deux
  boutons à sélection VISIBLE (surface + ombre légère) — l'ancien fond_mode_palette n'était référencé par
  aucun layout ; recherche = style commun Recherche ; puces de catégories = Chips pilule 28 dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/palette_racine"
    style="@style/Widget.CodeIDE.Apercu.Popover"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/apercu_popover_marge_h"
    android:layout_marginTop="@dimen/apercu_popover_haut"
    android:layout_marginEnd="@dimen/apercu_popover_marge_h"
    android:layout_marginBottom="@dimen/apercu_popover_marge_bas"
    android:orientation="vertical">

    <!-- .ph-head : 36 dp, titre 15 / 600, puce bulle 28 dp, fermer 36 dp, espacement 8. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/apercu_palette_entete_hauteur"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titre_palette"
            style="@style/Widget.CodeIDE.Apercu.Texte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/preview_palette_titre"
            android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.PopoverTitre" />

        <!-- Coché = bulle FIXE (aria-pressed) ; libellé « Bulle fixe » / « Bulle flottante ». -->
        <com.google.android.material.chip.Chip
            android:id="@+id/bouton_bulle"
            style="@style/Widget.CodeIDE.Apercu.PuceCategorie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/preview_bulle_flottante" />

        <ImageButton
            android:id="@+id/bouton_fermer_palette"
            style="@style/Widget.CodeIDE.Apercu.BoutonIcone"
            android:layout_width="@dimen/apercu_bouton_icone"
            android:layout_height="@dimen/apercu_bouton_icone"
            android:contentDescription="@string/preview_palette_fermer_cd"
            android:src="@drawable/apercu_ic_fermer" />
    </LinearLayout>

    <!-- .mode : deux boutons égaux, surface 2, padding 4, espacement 4 ; le sélectionné reçoit isSelected. -->
    <LinearLayout
        android:id="@+id/groupe_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/apercu_popover_gap"
        android:background="@drawable/apercu_mode_palette_conteneur"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/apercu_mode_palette_pad">

        <LinearLayout
            android:id="@+id/mode_drag"
            style="@style/Widget.CodeIDE.Apercu.ModeBouton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/Widget.CodeIDE.Apercu.Texte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_palette_mode_drag"
                android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.ModeTitre" />

            <TextView
                style="@style/Widget.CodeIDE.Apercu.Texte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/apercu_mode_palette_bouton_gap"
                android:alpha="0.85"
                android:text="@string/preview_palette_mode_drag_detail"
                android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.ModeDetail" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mode_popup"
            style="@style/Widget.CodeIDE.Apercu.ModeBouton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/Widget.CodeIDE.Apercu.Texte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_palette_mode_popup"
                android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.ModeTitre" />

            <TextView
                style="@style/Widget.CodeIDE.Apercu.Texte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/apercu_mode_palette_bouton_gap"
                android:alpha="0.85"
                android:text="@string/preview_palette_mode_popup_detail"
                android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.ModeDetail" />
        </LinearLayout>
    </LinearLayout>

    <!-- .search : style commun de la recherche (fond « fond », trait 1 dp, rayon 10, 36 dp). -->
    <EditText
        android:id="@+id/champ_recherche"
        style="@style/Widget.CodeIDE.Apercu.Recherche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/apercu_popover_gap"
        android:hint="@string/preview_palette_recherche_indice"
        android:textColorHint="?attr/apercuTexteDoux"
        tools:ignore="Autofill" />

    <!-- .cats : défilante, espacement 6, remplie par le code (Tous + 6 catégories). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/apercu_popover_gap"
        android:paddingBottom="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rangee_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- .tiles : 3 colonnes, espacement 8 (ItemDecoration), padding 2 ; défile seule. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grille_tuiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/apercu_popover_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:padding="@dimen/apercu_tuiles_pad" />
</LinearLayout>
