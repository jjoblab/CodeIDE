<?xml version="1.0" encoding="utf-8"?>
<!--
  Un contrôle TEXTE (PE9b) : libellé + conteneur de valeur — le liage
  gonfle SOIT la saisie littérale (saisie_texte), SOIT le bloc lecture
  seule (item_lecture_seule) quand la valeur est une référence @/?
  (miroir `.ro` : « une référence se montre, jamais écrasée »).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controle_texte"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/libelle_controle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:id="@+id/conteneur_saisie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
