<?xml version="1.0" encoding="utf-8"?>
<!--
  Un contrôle à SEGMENTS (PE9b, miroir `.seg2` — le CHOIX et le TRI-ÉTAT
  partagent CE layout) : libellé + rangée de segments outline (item
  segment gonflé par le liage). Le PREMIER choix est le défaut (retrait
  de l'attribut).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controle_segments"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/libelle_controle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:id="@+id/rangee_segments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/fond_champ"
        android:orientation="horizontal"
        android:padding="2dp" />
</LinearLayout>
