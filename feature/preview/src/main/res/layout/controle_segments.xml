<?xml version="1.0" encoding="utf-8"?>
<!--
  Contrôle à SEGMENTS (maquette `.seg2`) — CHOIX, TRI-ÉTAT, orientation, visibilité… Le premier
  choix est le défaut (retrait de l'attribut). Conteneur : surface 2, rayon 9, padding 2 ; segment :
  26 dp, rayon 7, 12 sp/500, coché = primaire plein + texte « sur primaire ». Renvoi à la ligne
  assumé (maquette : `.sec2 .seg2 { flex-wrap: wrap }`). Les segments (item_segment) sont gonflés
  par le liage. Cote : conteneur 374×30.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controle_segments"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/entete"
        layout="@layout/entete_champ" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/groupe_segments"
        style="@style/Widget.CodeIDE.Apercu.GroupeSegments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/apercu_gap_etiquette" />
</LinearLayout>
