<?xml version="1.0" encoding="utf-8"?>
<!--
  UNE CARTE de section repliable de l'éditeur (PE9b, miroir `.sec2` de
  la maquette : contour, coins 10, en-tête 9×11 avec badge « n définis »
  et flèche, corps 2×11) — le tap sur l'en-tête replie/déploie, l'état
  est mémorisé par titre (VoletAttributsFragment). Les contrôles viennent
  gonfler dans le corps.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/carte_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/fond_carte_section"
    android:orientation="vertical">

    <!-- L'en-tête : titre, badge, flèche (cible tactile 48 dp). -->
    <LinearLayout
        android:id="@+id/entete_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/titre_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- Le badge « n défini(s) » (violet sur violet pâle), caché à zéro. -->
        <TextView
            android:id="@+id/badge_definis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/fond_badge_definis"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textSize="11sp"
            android:textColor="?attr/apercuNouveau"
            android:visibility="gone" />

        <!-- La flèche d'état (« ▾ fermée » / « ▴ ouverte »), posée au liage. -->
        <TextView
            android:id="@+id/fleche_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Le corps : les contrôles de la section (gonflés par code). -->
    <LinearLayout
        android:id="@+id/corps_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="2dp"
        android:paddingEnd="11dp"
        android:paddingBottom="11dp" />
</LinearLayout>
