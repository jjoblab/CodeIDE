<?xml version="1.0" encoding="utf-8"?>
<!--
  Une rangée « autre attribut » existant (PE11h, maquette `.other`) : nom
  (mono 12 sp, tronqué), valeur éditable (champ, 8x10, rayon 8), bouton de
  suppression ✕ (cible tactile 24 dp, miroir `.rst` ; le glyphe et sa
  description sont propres au RETRAIT, adaptés de la référence qui
  réutilisait ceux du ↺). Adaptation des littéraux de la référence : la
  cible 24 dp passe par `apercu_reset_cible` (règle 10.3).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee_attribut_libre"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/nom_attribut_libre"
        style="@style/Widget.CodeIDE.Apercu.Texte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.NomAttributLibre" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/valeur_attribut_libre"
        style="@style/Widget.CodeIDE.Apercu.Champ"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_couleur_gap"
        android:layout_weight="1"
        android:imeOptions="actionDone" />

    <TextView
        android:id="@+id/bouton_retirer_attribut_libre"
        style="@style/Widget.CodeIDE.Apercu.Reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_couleur_gap"
        android:contentDescription="@string/preview_attr_supprimer_desc"
        android:gravity="center"
        android:minWidth="@dimen/apercu_reset_cible"
        android:minHeight="@dimen/apercu_reset_cible"
        android:text="@string/preview_attr_supprimer_glyphe" />
</LinearLayout>
