<?xml version="1.0" encoding="utf-8"?>
<!--
  UNE RANGÉE du menu APPAREIL (PE9c, miroir `showPop("device")` rendu
  maison) : la radio suit le profil courant, la rangée entière porte le
  tap (la radio est non cliquable — la sélection passe par la rangée).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee_appareil"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="14dp"
    android:paddingBottom="4dp">

    <RadioButton
        android:id="@+id/radio_appareil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/libelle_appareil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
