<?xml version="1.0" encoding="utf-8"?>
<!--
  Une option du menu APPAREIL (.opt) — RÉFÉRENCE (ADR 0134). Plus de radio : l'option courante est
  SÉLECTIONNÉE (isSelected = fond accent doux). Nom 13 sp, détail mono 11 « 393×851 dp · 440 dpi ».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee_appareil"
    style="@style/Widget.CodeIDE.Apercu.Option"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/libelle_appareil"
        style="@style/Widget.CodeIDE.Apercu.Texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.Option" />

    <TextView
        android:id="@+id/detail_appareil"
        style="@style/Widget.CodeIDE.Apercu.Texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.OptionDetail" />
</LinearLayout>
