<?xml version="1.0" encoding="utf-8"?>
<!--
  UNE RANGÉE d'ancre de CONTRAINTE (PE9b, PE8b, habillé PE11b aux
  jetons) : libellé de l'ancre, bouton CIBLE (menu Aucune / parent /
  frères à id) et champ MARGE en dp — chaque geste = UNE édition au
  port. Dépliée quatre fois (Début/Fin/Haut/Bas). Habillage : étiquette
  mono (56 dp, miroir `.dimrow label`), bouton lien, champ numérique.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee_contrainte"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/libelle_ancre"
        style="@style/Widget.CodeIDE.Apercu.Etiquette"
        android:layout_width="@dimen/apercu_dim_etiquette_largeur"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_cible"
        style="@style/Widget.CodeIDE.Apercu.BoutonLien"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="true" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/champ_marge"
        style="@style/Widget.CodeIDE.Apercu.ChampNum"
        android:layout_width="@dimen/apercu_champ_num_largeur"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_dim_gap"
        android:imeOptions="actionDone"
        android:inputType="number" />
</LinearLayout>
