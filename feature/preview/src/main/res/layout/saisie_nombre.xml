<?xml version="1.0" encoding="utf-8"?>
<!--
  Le champ NOMBRE avec unité de l'éditeur (PE9b, habillé PE11b aux
  jetons) : saisie numérique, refus propre (repli visuel) si non
  numérique. Miroir `.fld input[type=number]` — le style Champ porte le
  fond, le trait, le rayon et la taille 13 sp.
-->
<androidx.appcompat.widget.AppCompatEditText xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/champ_nombre"
    style="@style/Widget.CodeIDE.Apercu.Champ"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:imeOptions="actionDone"
    android:inputType="numberDecimal" />
