<?xml version="1.0" encoding="utf-8"?>
<!--
  Le POPOVER CIBLE d'une ancre de contrainte (PE9c) : titre + les
  cibles DYNAMIQUES (Aucune, parent, puis les frères à id — dépendent
  du fichier ouvert, le conteneur est rempli au liage).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popover_cible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_menu_apercu"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/titre_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:text="@string/preview_menu_cible_titre"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/liste_cibles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
