<?xml version="1.0" encoding="utf-8"?>
<!--
  Menu CIBLE d'une ancre de contrainte — RÉFÉRENCE (ADR 0134) : même coque et même titre de groupe que les
  autres menus ; les options sont dynamiques (Aucune, parent, frères à id).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popover_cible"
    style="@style/Widget.CodeIDE.Apercu.Menu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/titre_menu"
        style="@style/Widget.CodeIDE.Apercu.MenuTitre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/apercu_menu_titre_marge_haut"
        android:layout_marginBottom="@dimen/apercu_menu_titre_marge_bas"
        android:text="@string/preview_menu_cible_titre" />

    <LinearLayout
        android:id="@+id/liste_cibles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
