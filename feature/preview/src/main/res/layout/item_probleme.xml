<?xml version="1.0" encoding="utf-8"?>
<!--
  UNE RANGÉE de l'onglet Problèmes (PE9a, miroir `renderProbs` :
  pastille ambre/rouge + titre, détail en dessous) — la rangée entière
  est cliquable (sélection de la vue fautive), la TEINTE de la pastille
  suit la sévérité (posée au liage).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/pastille_probleme"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/fond_pastille_probleme" />

        <TextView
            android:id="@+id/titre_probleme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail_probleme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="2dp"
        android:paddingEnd="0dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
