<?xml version="1.0" encoding="utf-8"?>
<!--
  Le POPUP de placement (PE7c, miroir `.pop.bot` de la maquette) :
  « Où placer X ? » + fermer, l'arbre des vues rendues (mini `.mini`),
  les positions Avant/Dedans/Après (`.pos`), le résumé (« Dans X,
  position n sur total ») et le bouton violet « Placer ici » (`.prim`).
  En bas de l'écran — le repère se dessine EN DIRECT sur l'aperçu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/fond_popover_apercu"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- En-tête : la question + fermer. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titre_placement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <ImageButton
            android:id="@+id/bouton_fermer_placement"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/preview_placement_fermer_cd"
            android:src="@drawable/ic_fermer" />
    </LinearLayout>

    <!-- L'arbre des vues rendues (miroir `.mini` : 150 px max, lignes
         d'arbre posées en code, référence surlignée). -->
    <ScrollView
        android:id="@+id/defile_arbre_placement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/preview_placement_arbre_cd"
        android:maxHeight="150dp">

        <LinearLayout
            android:id="@+id/lignes_arbre_placement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp" />
    </ScrollView>

    <!-- Les positions (miroir `.pos` : grille 3 colonnes sur surface 2). -->
    <LinearLayout
        android:id="@+id/groupe_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/colorSurfaceContainerHighest"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/position_avant"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/preview_placement_avant"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/position_dedans"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/preview_placement_dedans"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/position_apres"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/preview_placement_apres"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Le résumé (miroir `.res` : « Dans X, position n sur total »). -->
    <TextView
        android:id="@+id/resume_placement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Le bouton violet (miroir `.prim`). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouton_placer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/preview_bulle_fond"
        android:text="@string/preview_placement_confirmer"
        android:textColor="@color/preview_bulle_icone"
        android:textStyle="bold" />
</LinearLayout>
