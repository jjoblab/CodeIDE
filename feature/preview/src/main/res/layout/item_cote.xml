<?xml version="1.0" encoding="utf-8"?>
<!-- UN champ de CÔTÉ (PE9b, miroir `.mrow` : grille de 4 champs —
     Haut/Droite/Bas/Gauche), chiffres centrés, commit IME/perte de
     focus. La grille lui donne le poids. -->
<EditText xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/champ_cote"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/fond_champ"
    android:importantForAutofill="no"
        android:inputType="number"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp"
    android:singleLine="true"
    android:textAlignment="center"
    android:textAppearance="?attr/textAppearanceLabelSmall"
    android:textSize="12sp"
    android:textColor="?attr/colorOnSurface" 
    tools:ignore="LabelFor" />
