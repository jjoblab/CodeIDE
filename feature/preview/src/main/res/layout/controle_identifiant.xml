<?xml version="1.0" encoding="utf-8"?>
<!--
  Un contrôle IDENTIFIANT (PE9b, PE8a, habillé PE11b aux jetons) : la
  valeur courante en lecture seule (mono), le champ « nouveau nom »
  validé à l'IME/à la perte de focus — le renommage couvre la déclaration
  ET les références du fichier en UNE édition — et la note de périmètre
  (code R.id et autres layouts hors portée). Habillage : styles
  Widget.CodeIDE.Apercu (aucun littéral) ; le padding latéral vient du
  corps de carte.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controle_identifiant"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/libelle_controle"
        style="@style/Widget.CodeIDE.Apercu.Etiquette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/conteneur_courant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/champ_nouveau_nom"
        style="@style/Widget.CodeIDE.Apercu.Champ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/apercu_gap_etiquette"
        android:imeOptions="actionDone" />

    <TextView
        android:id="@+id/note_perimetre"
        style="@style/Widget.CodeIDE.Apercu.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/apercu_gap_etiquette"
        android:text="@string/preview_identite_hors_perimetre" />
</LinearLayout>
