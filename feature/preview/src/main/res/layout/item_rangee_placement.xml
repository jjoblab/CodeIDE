<?xml version="1.0" encoding="utf-8"?>
<!--
  Une rangée du mini-arbre de PLACEMENT (.mini .row) — RÉFÉRENCE (ADR 0134) : IDENTIQUE à item_arbre
  (monogramme surface 2, classe, id affiché) sans badge ; la référence est isSelected (accent doux, pas
  violet). Hauteur 32 dp (padding 6 / 8, monogramme 20). On peut aussi inclure item_arbre tel quel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rangee_placement"
    style="@style/Widget.CodeIDE.Apercu.Rangee"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/apercu_mini_rangee_pad_v"
    android:paddingBottom="@dimen/apercu_mini_rangee_pad_v">

    <TextView
        android:id="@+id/monogramme_placement"
        style="@style/Widget.CodeIDE.Apercu.Monogramme"
        android:layout_width="@dimen/apercu_monogramme"
        android:layout_height="@dimen/apercu_monogramme"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/libelle_classe_placement"
        style="@style/Widget.CodeIDE.Apercu.Texte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_rangee_gap"
        android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.Rangee" />

    <TextView
        android:id="@+id/libelle_id_placement"
        style="@style/Widget.CodeIDE.Apercu.Texte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/apercu_rangee_gap"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.CodeIDE.Apercu.RangeeId" />
</LinearLayout>
