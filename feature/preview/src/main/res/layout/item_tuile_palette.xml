<?xml version="1.0" encoding="utf-8"?>
<!--
  Une TUILE de la palette (PE7c, miroir `.tile` de la maquette) : icône
  violette, nom, classe en mono, tag de dépendance (Material = contour ;
  « dépendance absente » = ambre). Tuile glissable (mode Glisser-déposer)
  ou cliquable (mode Placer par popup).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_tuile_palette"
    android:gravity="start|top"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/icone_tuile"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tuile_tv" />

    <TextView
        android:id="@+id/nom_tuile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/classe_tuile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tag_tuile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/fond_tag_contour"
        android:paddingHorizontal="7dp"
        android:paddingVertical="4dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:visibility="gone" />
</LinearLayout>
