<?xml version="1.0" encoding="utf-8"?>
<!--
  Le GHOST du drag d'une tuile de la palette (PE9e, miroir `.ghost` de
  la maquette : « icône + nom du widget, pill violette ») — dessiné par
  le DragShadowBuilder qui suit le doigt pendant le dépôt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_palette"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_ghost"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/icone_ghost"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bulle_palette" />

    <TextView
        android:id="@+id/nom_ghost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="@color/preview_bulle_icone" />
</LinearLayout>
