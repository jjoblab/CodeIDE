<?xml version="1.0" encoding="utf-8"?>
<!-- Le fond d'une CARTE de section de l'éditeur (PE9b, miroir `.sec2`
     de la maquette : contour 1 dp, coins 10 dp, surface). Remplace le
     GradientDrawable construit en code — les couleurs suivent le THÈME. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="10dp" />
</shape>
