        <shape android:shape="rectangle">
            <stroke android:width="@dimen/apercu_trait_epaisseur" android:color="?attr/apercuErreur" />
            <corners android:radius="@dimen/apercu_bandeau_bouton_rayon" />
        </shape>
    </item>
</ripple>
