<!-- Fond de la BULLE de palette (miroir .bubble : violet plein, rayon
     17 dp, halo new_soft dessiné au contour). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/preview_bulle_fond" />
            <corners android:radius="17dp" />
            <stroke android:width="4dp" android:color="@color/preview_bulle_halo" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/preview_bulle_fond" />
            <corners android:radius="17dp" />
            <stroke android:width="4dp" android:color="@color/preview_bulle_halo" />
        </shape>
    </item>
</selector>
