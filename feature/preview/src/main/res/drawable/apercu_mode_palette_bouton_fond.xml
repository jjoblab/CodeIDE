<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton sélectionné de .mode et .pos : surface + ombre légère de 1 dp (box-shadow 0 1px 3px rgba(0,0,0,.18)). Sert aux deux : mode de la palette et position du placement. Sélection = isSelected posé par le code. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:top="1dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/apercu_ombre_bouton" />
                    <corners android:radius="@dimen/apercu_mode_palette_bouton_rayon" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/apercuSurface" />
                    <corners android:radius="@dimen/apercu_mode_palette_bouton_rayon" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/apercuSurface" />
            <corners android:radius="@dimen/apercu_mode_palette_bouton_rayon" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/apercu_mode_palette_bouton_rayon" />
        </shape>
    </item>
</selector>
