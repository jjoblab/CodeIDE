<?xml version="1.0" encoding="utf-8"?>
<!-- La coque TRANSLUCIDE des menus de l'aperçu (PE9c, miroir `.pop` de
     la maquette atténué : surface du thème à ~95 % d'alpha, contour
     1 dp, rayon 16 dp — le jeton preview_menu_fond porte la
     transparence, déclinaison nuit). Le contenu reste lisible, le
     rendu transparaît légèrement. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/preview_menu_fond" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="16dp" />
</shape>
