<!-- Coque des popovers de l'aperçu (PE7c — miroir `.pop` de la maquette :
     surface, bordure 1 dp, rayon 16 dp, ombre par élévation). Patron du
     popover de l'explorateur : la palette est une VUE de l'activité, pas
     une fenêtre de dialogue qui bloquerait le dépôt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
    <corners android:radius="16dp" />
</shape>
