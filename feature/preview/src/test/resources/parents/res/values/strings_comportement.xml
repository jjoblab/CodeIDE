     reçoit par FUSION des ressources de sa dépendance. Posée dans le
     dossier res de mesure pour que le CoordinatorLayout de la fixture
     activity_fil.xml résolve app:layout_behavior comme sur appareil. -->
<resources>
    <string name="appbar_scrolling_view_behavior" translatable="false">
        com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior
    </string>
</resources>
